<Window x:Class="PersonalTradingJournal.Desktop.Dialogs.PtjDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personal Trading Journal"
        Width="440"
        MaxWidth="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource PtjWindowStyle}">
    <Border Margin="16"
            Padding="24"
            Style="{StaticResource PtjCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="DialogTitle"
                       AutomationProperties.HeadingLevel="Level2"
                       Style="{StaticResource PtjSectionTitleTextStyle}"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="DialogMessage"
                       Grid.Row="1"
                       Margin="0,12,0,24"
                       Style="{StaticResource PtjSecondaryTextStyle}"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button x:Name="CancelButton"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
                        Click="CancelButton_Click"
                        IsCancel="True"
                        IsDefault="True"
                        Style="{StaticResource PtjSecondaryButtonStyle}" />
                <Button x:Name="PrimaryButton"
                        AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
                        Click="PrimaryButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
