<UserControl x:Class="PersonalTradingJournal.Desktop.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dashboard="clr-namespace:PersonalTradingJournal.Desktop.Views.Dashboard"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <DataTemplate x:Key="ChartValues">
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,3"
                       Style="{StaticResource PtjBodyTextStyle}" />
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <StackPanel>
            <TextBlock Text="Closed-Trade performance · all Accounts and Instruments"
                       Style="{StaticResource PtjSecondaryTextStyle}" TextWrapping="Wrap" />
            <WrapPanel Margin="0,12">
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Period" Style="{StaticResource PtjCaptionTextStyle}" />
                    <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}" Width="130"
                              AutomationProperties.Name="Dashboard period" Style="{StaticResource PtjComboBoxStyle}" />
                </StackPanel>
                <Button Content="Previous" Command="{Binding PreviousCommand}" Margin="0,16,8,8"
                        AutomationProperties.Name="Previous calendar period" Style="{StaticResource PtjButtonStyle}" />
                <Button Content="Next" Command="{Binding NextCommand}" Margin="0,16,12,8"
                        AutomationProperties.Name="Next calendar period" Style="{StaticResource PtjButtonStyle}" />
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Currency" Style="{StaticResource PtjCaptionTextStyle}" />
                    <ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding SelectedCurrency}" Width="110"
                              AutomationProperties.Name="Dashboard currency" Style="{StaticResource PtjComboBoxStyle}" />
                </StackPanel>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,16,8,8" Style="{StaticResource PtjButtonStyle}" />
                <Button Content="Cancel loading" Command="{Binding CancelCommand}" Margin="0,16,0,8" Style="{StaticResource PtjButtonStyle}" />
            </WrapPanel>
            <TextBlock Text="{Binding PeriodLabel}" Style="{StaticResource PtjBodyTextStyle}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource PtjSecondaryTextStyle}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource PtjWarningBrush}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}" />
            <TextBlock Text="No closed Trades in this period. Choose All or another period."
                       Style="{StaticResource PtjSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,16"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" />
            <StackPanel DataContext="{Binding Selected}">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding CoverageNote}" TextWrapping="Wrap" Margin="0,12"
                           Style="{StaticResource PtjSecondaryTextStyle}" />
                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="230" Margin="0,0,10,10" Style="{StaticResource PtjCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource PtjSecondaryTextStyle}" />
                                    <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{DynamicResource PtjTextPrimaryBrush}" Margin="0,6" />
                                    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Style="{StaticResource PtjCaptionTextStyle}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Style="{StaticResource PtjCardStyle}" Margin="0,8">
                    <StackPanel>
                        <TextBlock Text="Cumulative Realized P&amp;L" Style="{StaticResource PtjSectionTitleTextStyle}" />
                        <TextBlock Text="Effective Net · starts at zero at the selected period's beginning. Not account equity or balance."
                                   Style="{StaticResource PtjSecondaryTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CoverageNote}" Style="{StaticResource PtjCaptionTextStyle}" TextWrapping="Wrap" />
                        <dashboard:PnlChart Points="{Binding CumulativePnl}" StartDate="{Binding PeriodStart}" IsCumulative="True" Height="240"
                                            Foreground="{DynamicResource PtjAccentBrush}" Focusable="True"
                                            AutomationProperties.Name="Cumulative realized P&amp;L chart. Exact dates, values and estimate coverage are in Show cumulative values below." />
                        <Expander Header="Show cumulative values" Foreground="{DynamicResource PtjTextPrimaryBrush}">
                            <ItemsControl ItemsSource="{Binding CumulativePnl}" ItemTemplate="{StaticResource ChartValues}" />
                        </Expander>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PtjCardStyle}" Margin="0,8">
                    <StackPanel>
                        <TextBlock Text="Daily P&amp;L" Style="{StaticResource PtjSectionTitleTextStyle}" />
                        <TextBlock Text="Effective Net by New York closure date · empty dates omitted; unavailable values are gaps."
                                   Style="{StaticResource PtjSecondaryTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CoverageNote}" Style="{StaticResource PtjCaptionTextStyle}" TextWrapping="Wrap" />
                        <dashboard:PnlChart Points="{Binding DailyPnl}" StartDate="{Binding PeriodStart}" Height="240"
                                            Foreground="{DynamicResource PtjAccentBrush}" Focusable="True"
                                            AutomationProperties.Name="Daily P&amp;L chart. Exact values and estimate coverage are in Show daily values below." />
                        <Expander Header="Show daily values" Foreground="{DynamicResource PtjTextPrimaryBrush}">
                            <ItemsControl ItemsSource="{Binding DailyPnl}" ItemTemplate="{StaticResource ChartValues}" />
                        </Expander>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PtjCardStyle}" Margin="0,8">
                    <StackPanel>
                        <TextBlock Text="Trading Setups" Style="{StaticResource PtjSectionTitleTextStyle}" />
                        <ItemsControl ItemsSource="{Binding Setups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,8">
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Style="{StaticResource PtjBodyTextStyle}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Style="{StaticResource PtjSecondaryTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PtjCardStyle}" Margin="0,8">
                    <StackPanel>
                        <TextBlock Text="Recent Trades" Style="{StaticResource PtjSectionTitleTextStyle}" />
                        <TextBlock Text="Latest 10 closed Trades in this period and currency, ordered by closure. Summary cards use all matching Trades."
                                   TextWrapping="Wrap" Style="{StaticResource PtjSecondaryTextStyle}" />
                        <ItemsControl ItemsSource="{Binding RecentTrades}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,6" Style="{StaticResource PtjBodyTextStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
