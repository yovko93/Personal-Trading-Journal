<UserControl x:Class="PersonalTradingJournal.Desktop.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:PersonalTradingJournal.Desktop.Converters"
             xmlns:dashboard="clr-namespace:PersonalTradingJournal.Desktop.Views.Dashboard"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <converters:PnLOutcomeConverter x:Key="PnlOutcome" />
        <converters:UtcToTradingTimeConverter x:Key="TradingTime" />
        <DataTemplate x:Key="WinRateTemplate">
            <Grid Width="142" Height="142">
                <dashboard:WinRateRing Value="{Binding}" WinBrush="{DynamicResource PtjSuccessBrush}"
                    LossBrush="{DynamicResource PtjDangerBrush}" NeutralBrush="{DynamicResource PtjTextMutedBrush}"
                    Focusable="True" ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Description}" />
                <TextBlock Text="{Binding Value}" FontSize="26" FontWeight="SemiBold"
                    HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                    Foreground="{DynamicResource PtjTextPrimaryBrush}" />
            </Grid>
        </DataTemplate>
        <Style x:Key="ChartAmountStyle" TargetType="TextBlock" BasedOn="{StaticResource PtjBodyTextStyle}">
            <Setter Property="Foreground" Value="{DynamicResource PtjTextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Value, Converter={StaticResource PnlOutcome}}" Value="{x:Static converters:PnLOutcome.Positive}">
                    <Setter Property="Foreground" Value="{DynamicResource PtjSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Value, Converter={StaticResource PnlOutcome}}" Value="{x:Static converters:PnLOutcome.Negative}">
                    <Setter Property="Foreground" Value="{DynamicResource PtjDangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="DailyValues">
            <Grid Margin="0,4" ToolTip="{Binding Description}" AutomationProperties.HelpText="{Binding Description}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}" Style="{StaticResource PtjBodyTextStyle}" />
                <TextBlock Grid.Column="1" Text="{Binding AmountText}" Style="{StaticResource ChartAmountStyle}" Margin="8,0"
                           Focusable="True" ToolTip="{Binding Description}" AutomationProperties.HelpText="{Binding Description}" />
                <TextBlock Grid.Column="2" Text="{Binding TradeCountText}" Style="{StaticResource PtjBodyTextStyle}" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CumulativeValues">
            <Grid Margin="0,4" ToolTip="{Binding Description}" AutomationProperties.HelpText="{Binding Description}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}" Style="{StaticResource PtjBodyTextStyle}" />
                <TextBlock Grid.Column="1" Text="{Binding AmountText}" Style="{StaticResource ChartAmountStyle}" Margin="8,0"
                           Focusable="True" ToolTip="{Binding Description}" AutomationProperties.HelpText="{Binding Description}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <StackPanel>
            <TextBlock Text="Closed-Trade performance · all Accounts and Instruments"
                       Style="{StaticResource PtjSecondaryTextStyle}" TextWrapping="Wrap" />
            <WrapPanel Margin="0,12">
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Period" Style="{StaticResource PtjCaptionTextStyle}" />
                    <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}" Width="130"
                              AutomationProperties.Name="Dashboard period" Style="{StaticResource PtjComboBoxStyle}" />
                </StackPanel>
                <Button Content="Previous" Command="{Binding PreviousCommand}" Margin="0,16,8,8"
                        AutomationProperties.Name="Previous calendar period" Style="{StaticResource PtjButtonStyle}" />
                <Button Content="Next" Command="{Binding NextCommand}" Margin="0,16,12,8"
                        AutomationProperties.Name="Next calendar period" Style="{StaticResource PtjButtonStyle}" />
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Currency" Style="{StaticResource PtjCaptionTextStyle}" />
                    <ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding SelectedCurrency}" Width="110"
                              AutomationProperties.Name="Dashboard currency" Style="{StaticResource PtjComboBoxStyle}" />
                </StackPanel>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,16,8,8" Style="{StaticResource PtjButtonStyle}" />
                <Button Content="Cancel loading" Command="{Binding CancelCommand}" Margin="0,16,0,8" Style="{StaticResource PtjButtonStyle}" />
            </WrapPanel>
            <TextBlock Text="{Binding PeriodLabel}" Style="{StaticResource PtjBodyTextStyle}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource PtjSecondaryTextStyle}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource PtjWarningBrush}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}" />
            <TextBlock Text="No closed Trades in this period. Choose All or another period."
                       Style="{StaticResource PtjSecondaryTextStyle}" TextWrapping="Wrap" Margin="0,16"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" />
            <StackPanel DataContext="{Binding Selected}">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="230" Margin="0,10,10,0" Style="{StaticResource PtjCardStyle}"
                                    ToolTip="{Binding Explanation}" Focusable="True"
                                    AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Explanation}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource PtjSecondaryTextStyle}" />
                                    <TextBlock Text="{Binding Date}" Style="{StaticResource PtjCaptionTextStyle}" />
                                    <TextBlock Text="{Binding Value}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{DynamicResource PtjTextPrimaryBrush}" Margin="0,6" Focusable="True"
                                               ToolTip="{Binding Explanation}" AutomationProperties.HelpText="{Binding Explanation}">
                                        <TextBlock.Style><Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers><DataTrigger Binding="{Binding Ring}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger></Style.Triggers>
                                        </Style></TextBlock.Style>
                                    </TextBlock>
                                    <ContentControl Content="{Binding Ring}" ContentTemplate="{StaticResource WinRateTemplate}">
                                        <ContentControl.Style><Style TargetType="ContentControl">
                                            <Style.Triggers><DataTrigger Binding="{Binding Ring}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger></Style.Triggers>
                                        </Style></ContentControl.Style>
                                    </ContentControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Style="{StaticResource PtjCardStyle}" Margin="0,8">
                    <StackPanel>
                        <TextBlock Text="Cumulative Realized P&amp;L" Style="{StaticResource PtjSectionTitleTextStyle}" />
                        <TextBlock Text="Effective Net · starts at zero at the selected period's beginning. Not account equity or balance."
                                   Style="{StaticResource PtjSecondaryTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CoverageNote}" Style="{StaticResource PtjCaptionTextStyle}" TextWrapping="Wrap" />
                        <dashboard:PnlChart Points="{Binding CumulativePnl}" StartDate="{Binding PeriodStart}" IsCumulative="True" Height="240"
                                            Foreground="{DynamicResource PtjTextSecondaryBrush}" Focusable="True"
                                            PositiveBrush="{DynamicResource PtjSuccessBrush}" NegativeBrush="{DynamicResource PtjDangerBrush}" NeutralBrush="{DynamicResource PtjTextMutedBrush}"
                                            AutomationProperties.Name="Cumulative realized P&amp;L chart. Exact dates, values and estimate coverage are in Show cumulative values below." />
                        <Expander Header="Show cumulative values" Foreground="{DynamicResource PtjTextPrimaryBrush}">
                            <ItemsControl ItemsSource="{Binding CumulativePnl}" ItemTemplate="{StaticResource CumulativeValues}" />
                        </Expander>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PtjCardStyle}" Margin="0,8">
                    <StackPanel>
                        <TextBlock Text="Daily P&amp;L" Style="{StaticResource PtjSectionTitleTextStyle}" />
                        <TextBlock Text="Effective Net by New York closure date · empty dates omitted; unavailable values are gaps."
                                   Style="{StaticResource PtjSecondaryTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CoverageNote}" Style="{StaticResource PtjCaptionTextStyle}" TextWrapping="Wrap" />
                        <dashboard:PnlChart Points="{Binding DailyPnl}" StartDate="{Binding PeriodStart}" Height="240"
                                            Foreground="{DynamicResource PtjTextSecondaryBrush}" Focusable="True"
                                            PositiveBrush="{DynamicResource PtjSuccessBrush}" NegativeBrush="{DynamicResource PtjDangerBrush}" NeutralBrush="{DynamicResource PtjTextMutedBrush}"
                                            AutomationProperties.Name="Daily P&amp;L chart. Exact values and estimate coverage are in Show daily values below." />
                        <Expander Header="Show daily values" Foreground="{DynamicResource PtjTextPrimaryBrush}">
                            <ItemsControl ItemsSource="{Binding DailyPnl}" ItemTemplate="{StaticResource DailyValues}" />
                        </Expander>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PtjCardStyle}" Margin="0,8">
                    <StackPanel>
                        <TextBlock Text="Trading Setups" Style="{StaticResource PtjSectionTitleTextStyle}" />
                        <ItemsControl ItemsSource="{Binding Setups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,8">
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Style="{StaticResource PtjBodyTextStyle}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Style="{StaticResource PtjSecondaryTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
            <!-- Independent of Selected analytics currency/period, including when the period is empty. -->
            <Border Style="{StaticResource PtjCardStyle}" Margin="0,8">
                <StackPanel>
                    <TextBlock Text="Recent Trades" Style="{StaticResource PtjSectionTitleTextStyle}" />
                    <TextBlock Text="Latest 10 · all periods and currencies · includes open Trades"
                               Style="{StaticResource PtjCaptionTextStyle}" TextWrapping="Wrap" Margin="0,4,0,12" />
                    <TextBlock Text="No Trades yet." Style="{StaticResource PtjSecondaryTextStyle}"
                               Visibility="{Binding HasNoRecentTrades, Converter={StaticResource BoolVisibility}}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel MinWidth="820">
                            <Grid Margin="12,0,12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="126" /><ColumnDefinition Width="*" MinWidth="105" />
                                    <ColumnDefinition Width="112" /><ColumnDefinition Width="155" />
                                    <ColumnDefinition Width="56" /><ColumnDefinition Width="180" /><ColumnDefinition Width="62" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Opened" Style="{StaticResource PtjCaptionTextStyle}" ToolTip="New York time" />
                                <TextBlock Grid.Column="1" Text="Trade" Style="{StaticResource PtjCaptionTextStyle}" />
                                <TextBlock Grid.Column="2" Text="Account" Style="{StaticResource PtjCaptionTextStyle}" />
                                <TextBlock Grid.Column="3" Text="Average prices" Style="{StaticResource PtjCaptionTextStyle}" />
                                <TextBlock Grid.Column="4" Text="Size" Style="{StaticResource PtjCaptionTextStyle}" />
                                <TextBlock Grid.Column="5" Text="Net P&amp;L" Style="{StaticResource PtjCaptionTextStyle}" />
                                <TextBlock Grid.Column="6" Text="Action" Style="{StaticResource PtjCaptionTextStyle}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding RecentTrades}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Style="{StaticResource PtjTradeOutcomeRowStyle}" Margin="0,0,0,8" Padding="12"
                                            BorderBrush="{DynamicResource PtjBorderBrush}" BorderThickness="1"
                                            CornerRadius="{StaticResource PtjCornerRadiusMd}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="126" /><ColumnDefinition Width="*" MinWidth="105" />
                                                <ColumnDefinition Width="112" /><ColumnDefinition Width="155" />
                                                <ColumnDefinition Width="56" /><ColumnDefinition Width="180" /><ColumnDefinition Width="62" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding OpenedAtUtc, Converter={StaticResource TradingTime}, StringFormat={}{0:yyyy-MM-dd}}" Style="{StaticResource PtjBodyTextStyle}" />
                                                <TextBlock Text="{Binding OpenedAtUtc, Converter={StaticResource TradingTime}, StringFormat={}{0:HH:mm}}" Style="{StaticResource PtjCaptionTextStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding InstrumentSymbol}" Style="{StaticResource PtjBodyTextStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource PtjCaptionTextStyle}" TextWrapping="Wrap"><Run Text="{Binding Direction}" /><Run Text=" · " /><Run Text="{Binding Status}" /></TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding TradingAccountName}" ToolTip="{Binding TradingAccountName}"
                                                Margin="0,0,8,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" LineHeight="18"
                                                LineStackingStrategy="BlockLineHeight" Style="{StaticResource PtjBodyTextStyle}" />
                                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                                <TextBlock Style="{StaticResource PtjBodyTextStyle}" TextWrapping="Wrap"><Run Text="Entry " /><Run Text="{Binding AverageEntryPrice, StringFormat={}{0:F2}}" /></TextBlock>
                                                <TextBlock Style="{StaticResource PtjBodyTextStyle}" TextWrapping="Wrap"><Run Text="Exit " /><Run Text="{Binding AverageExitPrice, StringFormat={}{0:F2}, TargetNullValue=—}" /></TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="4" Text="{Binding Size, StringFormat={}{0:0.############################}}"
                                                Margin="0,0,8,0" TextWrapping="Wrap" Style="{StaticResource PtjBodyTextStyle}" />
                                            <StackPanel Grid.Column="5" Margin="0,0,8,0">
                                                <TextBlock TextWrapping="Wrap">
                                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource PtjBodyTextStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EffectiveNet.Value, Converter={StaticResource PnlOutcome}}" Value="{x:Static converters:PnLOutcome.Positive}"><Setter Property="Foreground" Value="{DynamicResource PtjSuccessBrush}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding EffectiveNet.Value, Converter={StaticResource PnlOutcome}}" Value="{x:Static converters:PnLOutcome.Negative}"><Setter Property="Foreground" Value="{DynamicResource PtjDangerBrush}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style></TextBlock.Style>
                                                    <Run Text="{Binding EffectiveNet.Value, StringFormat={}{0:N2}, TargetNullValue=—}" /><Run Text=" " /><Run Text="{Binding Currency}" />
                                                </TextBlock>
                                                <TextBlock Text="Estimated" Style="{StaticResource PtjCaptionTextStyle}"
                                                    ToolTip="Estimated — commission/fees unknown"
                                                    AutomationProperties.HelpText="Estimated — commission/fees unknown"
                                                    Visibility="{Binding EffectiveNet.IsEstimated, Converter={StaticResource BoolVisibility}}" />
                                            </StackPanel>
                                            <Button Grid.Column="6" Content="View" Style="{StaticResource PtjButtonStyle}" Padding="8,4"
                                                VerticalAlignment="Center" AutomationProperties.Name="{Binding InstrumentSymbol, StringFormat=View {0} Trade}"
                                                Command="{Binding DataContext.ViewTradeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
