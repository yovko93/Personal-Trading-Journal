<Window x:Class="PersonalTradingJournal.Desktop.Views.Settings.MaintenanceWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PTJ — Offline Data Maintenance" Width="780" Height="660" MinWidth="420" MinHeight="360" WindowStartupLocation="CenterScreen"
 Background="{DynamicResource PtjBackgroundBrush}" Foreground="{DynamicResource PtjTextPrimaryBrush}">
 <Window.Resources><BooleanToVisibilityConverter x:Key="VisibleWhenTrue" /></Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
  <StackPanel>
   <TextBlock Text="Offline Data Maintenance" Style="{DynamicResource PtjSectionTitleTextStyle}" TextWrapping="Wrap" />
   <TextBlock Text="Normal journal access is unavailable in this window. AI keys are excluded. Backups and retained recovery files contain unencrypted sensitive data." Style="{DynamicResource PtjBodyTextStyle}" TextWrapping="Wrap" Margin="0,12,0,12" />
   <TextBlock Text="{Binding Status}" Style="{DynamicResource PtjBodyTextStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
   <ProgressBar Height="6" Margin="0,12,0,12" IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="Offline restore or recovery in progress" />
   <WrapPanel Margin="0,12,0,12">
    <Button Content="Recover interrupted restore" Command="{Binding RecoverCommand}" Style="{DynamicResource PtjPrimaryButtonStyle}" Margin="0,0,8,8" />
    <Button Content="Cancel operation" Command="{Binding CancelCommand}" Style="{DynamicResource PtjButtonStyle}" Margin="0,0,8,8" Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhenTrue}}" />
    <Button Content="Open journal in fresh app" Command="{Binding ReopenCommand}" Style="{DynamicResource PtjButtonStyle}" Margin="0,0,8,8" />
    <Button Content="Close" Click="CloseClick" Style="{DynamicResource PtjButtonStyle}" Margin="0,0,8,8" />
   </WrapPanel>
   <TextBlock Text="Retained recovery archive (when created)" Style="{DynamicResource PtjBodyTextStyle}" />
   <TextBox Text="{Binding RecoveryLocation, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,8,0,16" Style="{DynamicResource PtjTextBoxStyle}" AutomationProperties.Name="Retained recovery archive location" />
   <TextBlock Text="Retained operation directory (preserve all contents)" Style="{DynamicResource PtjBodyTextStyle}" />
   <TextBox Text="{Binding RetainedLocation, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,8,0,16" Style="{DynamicResource PtjTextBoxStyle}" AutomationProperties.Name="Retained recovery files location" />
   <TextBlock Text="If recovery remains blocked: close other PTJ instances, check permissions and free storage, then use Recover interrupted restore. Do not remove the startup marker or recovery files. Keep this result and the retained locations for support." Style="{DynamicResource PtjBodyTextStyle}" TextWrapping="Wrap" />
  </StackPanel>
 </ScrollViewer>
</Window>
