<UserControl x:Class="PersonalTradingJournal.Desktop.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:theming="clr-namespace:PersonalTradingJournal.Desktop.Theming"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <ScrollViewer x:Name="SettingsScroll" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <ScrollViewer.Resources>
            <Style TargetType="{x:Type ScrollBar}"
                   BasedOn="{StaticResource PtjScrollBarStyle}" />
        </ScrollViewer.Resources>

        <StackPanel MaxWidth="720"
                    HorizontalAlignment="Stretch">
            <Border Style="{StaticResource PtjCardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="AI Coaching" Style="{StaticResource PtjSectionTitleTextStyle}" />
                    <TextBlock Margin="0,8,0,12" TextWrapping="Wrap" Style="{StaticResource PtjBodyTextStyle}"
                               Text="Use your own OpenAI API key. Saving or removing it stays local and never generates a review." />
                    <Label Content="OpenAI API key" Target="{Binding ElementName=ApiKeyEntry}" Foreground="{DynamicResource PtjTextPrimaryBrush}" />
                    <PasswordBox x:Name="ApiKeyEntry" MaxLength="4096" MinHeight="36" Padding="8"
                                 FontSize="16" Background="{DynamicResource PtjSurfaceBrush}" Foreground="{DynamicResource PtjTextPrimaryBrush}"
                                 BorderBrush="{DynamicResource PtjBorderBrush}" BorderThickness="1"
                                 AutomationProperties.Name="New OpenAI API key, masked" />
                    <WrapPanel Margin="0,12,0,8">
                        <Button x:Name="SaveApiKey" Content="Save / Replace key" Click="SaveKeyClick"
                                Style="{StaticResource PtjPrimaryButtonStyle}" Margin="0,0,8,8" />
                        <Button Content="Remove saved key" Command="{Binding RemoveKeyCommand}"
                                Style="{StaticResource PtjButtonStyle}" Margin="0,0,0,8" />
                    </WrapPanel>
                    <TextBlock Text="{Binding CredentialStatus}" TextWrapping="Wrap" Style="{StaticResource PtjBodyTextStyle}"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding CredentialMessage}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Style="{StaticResource PtjBodyTextStyle}" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Style="{StaticResource PtjSecondaryTextStyle}"
                               Text="Protected for this Windows user with DPAPI, outside journal data and backups. Enter it again on another computer. The stored key is never displayed. Only Generate AI Review sends Trade facts and Journal text to OpenAI and may incur charges." />
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource PtjSectionTitleTextStyle}"
                       Text="Appearance" />
            <TextBlock Margin="0,4,0,20"
                       Style="{StaticResource PtjSecondaryTextStyle}"
                       Text="Choose how Personal Trading Journal looks on this device." />

            <Border Style="{StaticResource PtjCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PtjBodyTextStyle}"
                               FontWeight="SemiBold"
                               Text="Theme" />
                    <TextBlock Margin="0,4,0,16"
                               Style="{StaticResource PtjSecondaryTextStyle}"
                               Text="Changes are applied immediately and saved for the next launch." />

                    <RadioButton Margin="0,0,0,12"
                                 Command="{Binding ChangeThemeCommand}"
                                 CommandParameter="{x:Static theming:AppTheme.System}"
                                 Content="System"
                                 Foreground="{DynamicResource PtjTextPrimaryBrush}"
                                 GroupName="ApplicationTheme"
                                 IsChecked="{Binding IsSystemSelected, Mode=OneWay}" />
                    <RadioButton Margin="0,0,0,12"
                                 Command="{Binding ChangeThemeCommand}"
                                 CommandParameter="{x:Static theming:AppTheme.Dark}"
                                 Content="Dark"
                                 Foreground="{DynamicResource PtjTextPrimaryBrush}"
                                 GroupName="ApplicationTheme"
                                 IsChecked="{Binding IsDarkSelected, Mode=OneWay}" />
                    <RadioButton Command="{Binding ChangeThemeCommand}"
                                 CommandParameter="{x:Static theming:AppTheme.Light}"
                                 Content="Light"
                                 Foreground="{DynamicResource PtjTextPrimaryBrush}"
                                 GroupName="ApplicationTheme"
                                 IsChecked="{Binding IsLightSelected, Mode=OneWay}" />

                    <TextBlock Margin="0,12,0,0"
                               Style="{StaticResource PtjSecondaryTextStyle}"
                               Text="System follows your Windows appearance setting." />

                    <TextBlock Margin="0,16,0,0"
                               Foreground="{DynamicResource PtjWarningBrush}"
                               Text="{Binding SaveErrorMessage}">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSaveError}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
