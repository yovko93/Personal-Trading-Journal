<UserControl x:Class="PersonalTradingJournal.Desktop.Views.Mistakes.TradingMistakesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:validation="clr-namespace:PersonalTradingJournal.Desktop.Validation">
    <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
        <ScrollViewer.Resources><Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource PtjScrollBarStyle}" /></ScrollViewer.Resources>
        <StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource PtjSecondaryTextStyle}"
                           Text="Reusable process and execution mistakes used during trade review." TextWrapping="Wrap" />
                <Button Grid.Column="1" Margin="16,0,0,0" Command="{Binding RefreshCommand}" Content="Refresh" Style="{StaticResource PtjButtonStyle}" />
                <Button Grid.Column="2" Margin="8,0,0,0" Command="{Binding ShowCreateCommand}" Content="New Mistake" Style="{StaticResource PtjPrimaryButtonStyle}" />
            </Grid>
            <Border Margin="0,16,0,0"><Border.Style><Style TargetType="{x:Type Border}" BasedOn="{StaticResource PtjFormSectionStyle}">
                <Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsCreateFormVisible}" Value="True">
                    <Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <StackPanel>
                    <TextBlock Style="{StaticResource PtjFormSectionTitleTextStyle}" Text="New Trading Mistake" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource PtjSecondaryTextStyle}"
                               Text="Define a reusable process or execution mistake for later review."
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,16,0,6" Style="{StaticResource PtjFormLabelTextStyle}" Text="Name" />
                    <TextBox validation:FormValidation.IsInvalid="{Binding IsNameInvalid}"
                             Text="{Binding NameText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource PtjTextBoxStyle}" />
                    <TextBlock Style="{StaticResource PtjFormHelperTextStyle}"
                               Text="Name the behavior, not the trade outcome—profit or loss alone does not define a mistake." />
                    <StackPanel Margin="0,16,0,6" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource PtjFormLabelTextStyle}" Text="Description" />
                        <TextBlock Margin="4,0,0,0" Style="{StaticResource PtjFormOptionalTextStyle}" Text="(Optional)" />
                    </StackPanel>
                    <TextBox MinHeight="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                             Text="{Binding DescriptionText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PtjTextBoxStyle}" />
                    <TextBlock Margin="0,12,0,0" Text="{Binding ValidationErrorMessage}"><TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PtjFormErrorTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding HasValidationError}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style></TextBlock>
                    <TextBlock Margin="0,8,0,0" Text="Creating mistake..."><TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PtjFormHelperTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsSaving}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style></TextBlock>
                    <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Command="{Binding CancelCreateCommand}" Content="Cancel" Style="{StaticResource PtjSecondaryButtonStyle}" />
                        <Button Margin="8,0,0,0" Command="{Binding CreateCommand}" Content="Create Mistake" Style="{StaticResource PtjPrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <StackPanel Margin="0,12">
                <TextBlock Text="Loading trading mistakes..."><TextBlock.Style><Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PtjCaptionTextStyle}">
                    <Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style></TextBlock.Style></TextBlock>
                <TextBlock Style="{StaticResource PtjFormErrorTextStyle}" Text="{Binding ListErrorMessage}" />
                <TextBlock Style="{StaticResource PtjFormErrorTextStyle}" Text="{Binding SaveErrorMessage}" />
                <TextBlock Style="{StaticResource PtjFormSuccessTextStyle}" Text="{Binding SuccessMessage}" />
            </StackPanel>
            <Border Padding="24"><Border.Style><Style TargetType="{x:Type Border}" BasedOn="{StaticResource PtjCardStyle}">
                <Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsLoading}" Value="False" /><Condition Binding="{Binding HasTradingMistakes}" Value="False" />
                    <Condition Binding="{Binding HasListError}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger></Style.Triggers></Style></Border.Style>
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource PtjSecondaryTextStyle}" Text="No trading mistakes yet. Create reusable process mistakes for trade review." />
            </Border>
            <ItemsControl ItemsSource="{Binding TradingMistakes}"><ItemsControl.ItemTemplate><DataTemplate>
                <Border Margin="0,0,0,10" Style="{StaticResource PtjCardStyle}"><Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="4*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Style="{StaticResource PtjBodyTextStyle}" Text="{Binding Name}" />
                    <TextBlock Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Style="{StaticResource PtjSecondaryTextStyle}"
                               Text="{Binding Description, TargetNullValue=—}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PtjCaptionTextStyle}">
                        <Setter Property="Text" Value="Inactive" /><Setter Property="Foreground" Value="{DynamicResource PtjTextSecondaryBrush}" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Text" Value="Active" />
                            <Setter Property="Foreground" Value="{DynamicResource PtjSuccessBrush}" /></DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style></TextBlock>
                    <Button Grid.Column="3" CommandParameter="{Binding}"
                            Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                        <Button.Style><Style TargetType="{x:Type Button}" BasedOn="{StaticResource PtjButtonStyle}"><Setter Property="Content" Value="Activate" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Content" Value="Deactivate" /></DataTrigger></Style.Triggers>
                        </Style></Button.Style></Button>
                </Grid></Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
