<Window x:Class="PersonalTradingJournal.Desktop.Views.Calendar.CalendarDayDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:calendar="clr-namespace:PersonalTradingJournal.Desktop.Views.Calendar"
        Title="Day Performance" Width="1000" Height="820"
        ShowInTaskbar="False" WindowStartupLocation="Manual"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Style="{DynamicResource PtjWindowStyle}"
        Background="Transparent"
        PreviewKeyDown="OnDialogKeyDown"
        PreviewMouseDown="OnDialogMouseDown" PreviewMouseUp="OnDialogMouseUp"
        AutomationProperties.Name="{Binding SelectedDateLabel, StringFormat=Day Performance: {0}}">
    <Grid>
        <!-- The enabled modal owns this backdrop: a disabled ShowDialog owner cannot receive dismissal clicks. -->
        <Border x:Name="DialogBackdrop" Background="#66000000" />
        <Border x:Name="DayPanel" Margin="16" MaxWidth="1000" MaxHeight="820" Padding="12"
                Background="{DynamicResource PtjBackgroundBrush}" BorderBrush="{DynamicResource PtjBorderBrush}"
                BorderThickness="1" CornerRadius="6" KeyboardNavigation.TabNavigation="Cycle">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Button x:Name="DismissButton" Content="×" HorizontalAlignment="Right" Click="OnClose"
                        Style="{DynamicResource PtjSecondaryButtonStyle}" Padding="8,2" Margin="0,0,0,4"
                        AutomationProperties.Name="Close Day Performance" />
                <calendar:CalendarDayDetailsView x:Name="DayContent" Grid.Row="1" />
                <Button x:Name="CloseButton" Grid.Row="2" Content="Close" Margin="0,12,0,0"
                        HorizontalAlignment="Right" Click="OnClose"
                        Style="{DynamicResource PtjSecondaryButtonStyle}"
                        AutomationProperties.Name="Close Day Performance" />
            </Grid>
        </Border>
    </Grid>
</Window>
