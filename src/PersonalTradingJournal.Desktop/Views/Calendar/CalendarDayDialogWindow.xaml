<Window x:Class="PersonalTradingJournal.Desktop.Views.Calendar.CalendarDayDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:calendar="clr-namespace:PersonalTradingJournal.Desktop.Views.Calendar"
        Title="Day Performance" Width="1000" Height="820" MinWidth="320" MinHeight="280"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Style="{DynamicResource PtjWindowStyle}"
        Background="{DynamicResource PtjBackgroundBrush}"
        PreviewKeyDown="OnDialogKeyDown"
        AutomationProperties.Name="{Binding SelectedDateLabel, StringFormat=Day Performance: {0}}">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <calendar:CalendarDayDetailsView x:Name="DayContent" />
        <Button x:Name="CloseButton" Grid.Row="1" Content="Close" IsCancel="True" Margin="0,12,0,0"
                HorizontalAlignment="Right" Click="OnClose"
                Style="{DynamicResource PtjSecondaryButtonStyle}"
                AutomationProperties.Name="Close Day Performance" />
    </Grid>
</Window>
