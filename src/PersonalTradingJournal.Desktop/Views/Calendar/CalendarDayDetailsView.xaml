<UserControl x:Class="PersonalTradingJournal.Desktop.Views.Calendar.CalendarDayDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:interactions="clr-namespace:PersonalTradingJournal.Desktop.Interactions"
    xmlns:journals="clr-namespace:PersonalTradingJournal.Desktop.Views.Journals"
    AutomationProperties.Name="Calendar day Journals">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style x:Key="DayJournalDetailHost" TargetType="ContentControl">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ContentTemplate">
                <Setter.Value><DataTemplate>
                    <StackPanel Margin="0,0,0,16">
                        <journals:InlineJournalView />
                    </StackPanel>
                </DataTemplate></Setter.Value>
            </Setter>
            <Style.Triggers><Trigger Property="Content" Value="{x:Null}">
                <Setter Property="ContentTemplate" Value="{x:Null}" />
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger></Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="DayContentScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border x:Name="DayDetailsPanel" Padding="12" CornerRadius="6" VerticalAlignment="Top"
                AutomationProperties.Name="Journals for selected date"
                Background="{DynamicResource PtjSurfaceBrush}" BorderBrush="{DynamicResource PtjBorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{Binding SelectedDateLabel}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource PtjTextPrimaryBrush}" AutomationProperties.LiveSetting="Polite" />
                <StackPanel Margin="0,12,0,8">
                    <TextBlock Text="Day Journal" Style="{DynamicResource PtjSectionTitleTextStyle}" />
                    <TextBlock Text="{Binding DayJournalStatusMessage}"
                               TextWrapping="Wrap" Margin="0,8"
                               Foreground="{DynamicResource PtjTextSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                    <WrapPanel>
                        <Button x:Name="DayJournalAction" Content="Add Journal" Margin="0,0,8,4"
                                Command="{Binding AddDayJournalCommand}" AutomationProperties.Name="Add Journal"
                                AutomationProperties.HelpText="Create a Journal for this New York date. Choose its Account inside the form; an occupied scope cannot be overwritten."
                                Style="{DynamicResource PtjPrimaryButtonStyle}" />
                        <Button Content="Refresh Journals" Command="{Binding RefreshDayJournalsCommand}" Margin="0,0,0,4"
                                Style="{DynamicResource PtjJournalActionButtonStyle}" AutomationProperties.Name="Refresh day Journals" />
                    </WrapPanel>
                </StackPanel>
                <ItemsControl x:Name="DayJournalEntries" ItemsSource="{Binding DayJournals}" Margin="0,0,0,12"
                              AutomationProperties.Name="Journals for selected New York date and Account filter">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <StackPanel>
                        <Border Padding="12" Margin="0,0,0,10" CornerRadius="6" BorderThickness="1"
                                Background="{DynamicResource PtjJournalReviewSurfaceBrush}" BorderBrush="{DynamicResource PtjJournalReviewBorderBrush}"
                                AutomationProperties.Name="{Binding Description}">
                            <StackPanel>
                                <WrapPanel>
                                    <TextBlock Text="{Binding AccountLabel}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,4"
                                               Foreground="{DynamicResource PtjTextPrimaryBrush}" />
                                    <TextBlock Text="{Binding StateLabel}" FontSize="16" Margin="0,0,0,4" Foreground="{DynamicResource PtjTextSecondaryBrush}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="96" LineHeight="24"
                                           FontSize="16" MaxWidth="760" HorizontalAlignment="Left" Margin="0,4,0,8"
                                           Foreground="{DynamicResource PtjTextPrimaryBrush}" AutomationProperties.Name="Saved Journal text" />
                                <WrapPanel x:Name="JournalCardActions">
                                <interactions:ExpansionButton x:Name="JournalToggle" Content="{Binding ActionLabel}" IsExpanded="{Binding IsExpanded, Mode=OneWay}" HorizontalAlignment="Left" Margin="0,0,8,4"
                                        Command="{Binding DataContext.OpenDayJournalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Style="{DynamicResource PtjJournalActionButtonStyle}"
                                        AutomationProperties.Name="{Binding ActionAccessibleName}" />
                                <Button x:Name="DeleteCardJournal" Content="Delete Journal" Margin="0,0,0,4"
                                        Command="{Binding DataContext.DeleteDayJournalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Style="{DynamicResource PtjDangerButtonStyle}"
                                        AutomationProperties.Name="{Binding DeleteAccessibleName}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <ContentControl x:Name="RowJournalDetail" Content="{Binding ExpandedJournal}" Style="{StaticResource DayJournalDetailHost}" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter TargetName="JournalToggle" Property="Style" Value="{DynamicResource PtjJournalCloseButtonStyle}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel x:Name="InlineJournalSection" Margin="0,0,0,16"
                            Visibility="{Binding HasDetachedInlineJournal, Converter={StaticResource BoolVisibility}}">
                    <!-- A new unsaved form has no saved card to toggle. Keep its guarded close action. -->
                    <Button Content="Close Journal" HorizontalAlignment="Right" Margin="0,0,0,8"
                            Command="{Binding CloseInlineJournalCommand}" Style="{DynamicResource PtjJournalCloseButtonStyle}"
                            AutomationProperties.Name="Close new inline Journal; keep Calendar day open" />
                    <ContentControl x:Name="DayJournalEditor" Content="{Binding DetachedInlineJournal}" Style="{StaticResource DayJournalDetailHost}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
