<UserControl x:Class="PersonalTradingJournal.Desktop.Views.Calendar.CalendarDayDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:calendar="clr-namespace:PersonalTradingJournal.Desktop.Views.Calendar"
    xmlns:converters="clr-namespace:PersonalTradingJournal.Desktop.Converters"
    xmlns:interactions="clr-namespace:PersonalTradingJournal.Desktop.Interactions"
    xmlns:journals="clr-namespace:PersonalTradingJournal.Desktop.Views.Journals"
    AutomationProperties.Name="Calendar day performance">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <converters:PnLOutcomeConverter x:Key="PnlOutcome" />
        <Style x:Key="CalendarTradeAmountStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PtjTextPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Amount, Converter={StaticResource PnlOutcome}}" Value="{x:Static converters:PnLOutcome.Positive}">
                    <Setter Property="Foreground" Value="{DynamicResource PtjSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Amount, Converter={StaticResource PnlOutcome}}" Value="{x:Static converters:PnLOutcome.Negative}">
                    <Setter Property="Foreground" Value="{DynamicResource PtjDangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CalendarAmountStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PtjTextPrimaryBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static converters:PnLOutcome.Positive}">
                    <Setter Property="Foreground" Value="{DynamicResource PtjSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static converters:PnLOutcome.Negative}">
                    <Setter Property="Foreground" Value="{DynamicResource PtjDangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="CalendarPnlTemplate">
            <Border Padding="2,4" AutomationProperties.Name="{Binding Description}">
                <StackPanel>
                    <TextBlock Text="{Binding AmountText}" Style="{StaticResource CalendarAmountStyle}" />
                    <TextBlock Text="{Binding TradeCountText}" TextAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource PtjTextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>
    <ScrollViewer x:Name="DayContentScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border x:Name="DayDetailsPanel" Margin="0" Padding="12" CornerRadius="6"
                AutomationProperties.Name="Selected date daily Trades"
                AutomationProperties.ItemStatus="{Binding DayStatusMessage}"
                Background="{DynamicResource PtjSurfaceBrush}" BorderBrush="{DynamicResource PtjBorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Day Performance" Style="{DynamicResource PtjSectionTitleTextStyle}" />
                <TextBlock Text="{Binding SelectedDateLabel}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource PtjTextPrimaryBrush}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding DayTradeCountText}" Margin="0,4,0,0" Foreground="{DynamicResource PtjTextSecondaryBrush}" />
                <WrapPanel Margin="0,8">
                    <TextBlock Text="{Binding DayStatusMessage}" VerticalAlignment="Center"
                               Foreground="{DynamicResource PtjTextSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                    <Button Content="Cancel" Margin="0,0,8,0" Command="{Binding CancelDayCommand}"
                            Visibility="{Binding IsDayLoading, Converter={StaticResource BoolVisibility}}"
                            Style="{DynamicResource PtjSecondaryButtonStyle}" AutomationProperties.Name="Cancel day Trades loading" />
                    <TextBlock Text="{Binding DayErrorMessage}" MaxWidth="400" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource PtjWarningBrush}" AutomationProperties.LiveSetting="Assertive" />
                    <Button Content="Retry" Margin="8,0,0,0" Command="{Binding RetryDayCommand}"
                            Style="{DynamicResource PtjSecondaryButtonStyle}" AutomationProperties.Name="Reload selected date Trades" />
                </WrapPanel>
                <ItemsControl ItemsSource="{Binding DaySummaries}" ItemTemplate="{StaticResource CalendarPnlTemplate}" Margin="0,0,0,12">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0,0,16,0" />
                            <Setter Property="ToolTip" Value="{Binding Description}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
                <TextBlock Text="No closed Trades on this date." Margin="0,4" TextWrapping="Wrap"
                           Foreground="{DynamicResource PtjTextSecondaryBrush}"
                           Visibility="{Binding IsSelectedDayEmpty, Converter={StaticResource BoolVisibility}}" />
                <ItemsControl ItemsSource="{Binding DayPerformance}" Margin="0,8,0,16">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Currency}" FontWeight="SemiBold" Foreground="{DynamicResource PtjTextPrimaryBrush}" />
                            <calendar:DayPerformanceChart Height="240" Series="{Binding}"
                                PositiveBrush="{DynamicResource PtjSuccessBrush}" NegativeBrush="{DynamicResource PtjDangerBrush}"
                                NeutralBrush="{DynamicResource PtjTextMutedBrush}" />
                        </StackPanel>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No closed Trades to chart." Foreground="{DynamicResource PtjTextSecondaryBrush}"
                           Visibility="{Binding IsSelectedDayEmpty, Converter={StaticResource BoolVisibility}}" />
                <StackPanel Margin="0,12,0,20" HorizontalAlignment="Center">
                    <TextBlock Text="Day Journal" TextAlignment="Center" Style="{DynamicResource PtjSectionTitleTextStyle}" />
                    <TextBlock Text="{Binding DayJournalStatusMessage}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,8"
                               Foreground="{DynamicResource PtjTextSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="DayJournalAction" Content="{Binding DayJournalActionText}"
                            IsEnabled="{Binding CanOpenDayJournal}" HorizontalAlignment="Center"
                            Command="{Binding OpenInlineJournalCommand}"
                            AutomationProperties.Name="{Binding DayJournalActionText}"
                            AutomationProperties.HelpText="Open the selected New York date and exact Calendar Account scope inline in Day Performance."
                            Style="{DynamicResource PtjButtonStyle}" />
                </StackPanel>
                <StackPanel x:Name="InlineJournalSection" Margin="0,0,0,16"
                            Visibility="{Binding HasInlineJournal, Converter={StaticResource BoolVisibility}}">
                    <Button Content="Close Journal" Command="{Binding CloseInlineJournalCommand}" HorizontalAlignment="Right"
                            Margin="0,0,0,8" Style="{DynamicResource PtjSecondaryButtonStyle}"
                            AutomationProperties.Name="Close inline Journal; keep Day Performance open" />
                    <ContentControl x:Name="DayJournalEditor" Content="{Binding InlineJournal}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value><DataTemplate><journals:InlineJournalView /></DataTemplate></Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="Content" Value="{x:Null}"><Setter Property="ContentTemplate" Value="{x:Null}" /></Trigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </StackPanel>
                <ScrollViewer x:Name="DayTradesScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              interactions:NestedTableWheelRouting.ForwardVerticalWheel="True">
                    <!-- Finite shared width prevents wrapped rows sizing independently; the minimum fits the capped Account and all column minima. -->
                    <StackPanel x:Name="DayTradesTable" MinWidth="1048" Grid.IsSharedSizeScope="True"
                                Width="{Binding ViewportWidth, ElementName=DayTradesScroller}">
                        <Grid x:Name="DayTradesHeader" Margin="8,0,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112" /><ColumnDefinition Width="100" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="DayTradeAccount" MinWidth="100" MaxWidth="160" /><ColumnDefinition Width="150" />
                                <ColumnDefinition Width="56" /><ColumnDefinition Width="70" /><ColumnDefinition Width="*" MinWidth="150" /><ColumnDefinition Width="1.2*" MinWidth="170" /><ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Time (New York)" TextWrapping="Wrap" Foreground="{DynamicResource PtjTextMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="Instrument" Foreground="{DynamicResource PtjTextMutedBrush}" />
                            <TextBlock Grid.Column="2" Text="Account" Margin="0,0,8,0" Foreground="{DynamicResource PtjTextMutedBrush}" />
                            <TextBlock Grid.Column="3" Text="Net P&amp;L" Margin="8,0" TextAlignment="Center" Foreground="{DynamicResource PtjTextMutedBrush}" />
                            <TextBlock Grid.Column="4" Text="Size" Foreground="{DynamicResource PtjTextMutedBrush}" />
                            <TextBlock Grid.Column="5" Text="Direction" Foreground="{DynamicResource PtjTextMutedBrush}" />
                            <TextBlock Grid.Column="6" Text="Setup" Foreground="{DynamicResource PtjTextMutedBrush}" />
                            <TextBlock Grid.Column="7" Text="Trading Mistakes" Foreground="{DynamicResource PtjTextMutedBrush}" />
                            <TextBlock Grid.Column="8" Text="Action" Foreground="{DynamicResource PtjTextMutedBrush}" />
                        </Grid>
                        <ItemsControl x:Name="DayTradesList" ItemsSource="{Binding DayTrades}"
                                      Width="{Binding ActualWidth, ElementName=DayTradesTable}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Padding="8" Margin="0,0,0,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource PtjBorderBrush}"
                                        AutomationProperties.Name="{Binding AccessibleName}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource PtjSurfaceBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Amount, Converter={StaticResource PnlOutcome}}" Value="{x:Static converters:PnLOutcome.Positive}">
                                                    <Setter Property="Background" Value="{DynamicResource PtjSuccessSurfaceBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Amount, Converter={StaticResource PnlOutcome}}" Value="{x:Static converters:PnLOutcome.Negative}">
                                                    <Setter Property="Background" Value="{DynamicResource PtjDangerSurfaceBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                    <Grid x:Name="DayTradeRow">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" /><ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="DayTradeAccount" MinWidth="100" MaxWidth="160" /><ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="56" /><ColumnDefinition Width="70" /><ColumnDefinition Width="*" MinWidth="150" /><ColumnDefinition Width="1.2*" MinWidth="170" /><ColumnDefinition Width="64" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ClosingTime}" TextWrapping="Wrap" ToolTip="{Binding ClosingTimeDescription}"
                                                   AutomationProperties.Name="{Binding ClosingTimeDescription}" Foreground="{DynamicResource PtjTextPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Trade.InstrumentSymbol}" Margin="0,0,8,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource PtjTextPrimaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Trade.TradingAccountName}" Margin="0,0,8,0" MaxWidth="152" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource PtjTextPrimaryBrush}" ToolTip="{Binding Trade.TradingAccountName}" />
                                        <StackPanel Grid.Column="3" Margin="8,0" ToolTip="{Binding NetDescription}" AutomationProperties.HelpText="{Binding NetDescription}">
                                            <TextBlock Text="{Binding AmountText}" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource CalendarTradeAmountStyle}" />
                                            <TextBlock Text="Estimated" TextAlignment="Center" FontSize="12" Foreground="{DynamicResource PtjTextSecondaryBrush}"
                                                       Visibility="{Binding IsEstimated, Converter={StaticResource BoolVisibility}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="4" Text="{Binding SizeText}" Margin="0,0,8,0" TextWrapping="Wrap" Foreground="{DynamicResource PtjTextPrimaryBrush}" />
                                        <TextBlock Grid.Column="5" Text="{Binding Trade.Direction}" Foreground="{DynamicResource PtjTextPrimaryBrush}" />
                                        <TextBlock Grid.Column="6" Text="{Binding SetupText}" Margin="0,0,8,0" TextWrapping="Wrap" ToolTip="{Binding SetupText}" Foreground="{DynamicResource PtjTextPrimaryBrush}" />
                                        <TextBlock Grid.Column="7" Text="{Binding MistakesText}" Margin="0,0,8,0" TextWrapping="Wrap" ToolTip="{Binding MistakesText}" Foreground="{DynamicResource PtjTextPrimaryBrush}" />
                                        <Button Grid.Column="8" Content="View" Padding="8,4" VerticalAlignment="Center" Style="{DynamicResource PtjButtonStyle}"
                                                AutomationProperties.Name="{Binding AccessibleName, StringFormat=View Trade: {0}}"
                                                Command="{Binding DataContext.ViewTradeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Trade}" />
                                    </Grid>
                                    <Border Padding="12" Margin="0,8,0,0" Background="{DynamicResource PtjSurfaceBrush}"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolVisibility}}"
                                            AutomationProperties.Name="Expanded Trade details">
                                        <StackPanel>
                                            <Button Content="Collapse details" HorizontalAlignment="Right" Style="{DynamicResource PtjSecondaryButtonStyle}"
                                                    Command="{Binding DataContext.CloseInlineTradeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <calendar:CalendarInlineTradeView DataContext="{Binding Editor}" />
                                        </StackPanel>
                                    </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
