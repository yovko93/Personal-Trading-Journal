<UserControl x:Class="PersonalTradingJournal.Desktop.Views.Calendar.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:PersonalTradingJournal.Desktop.Converters"
             xmlns:interactions="clr-namespace:PersonalTradingJournal.Desktop.Interactions"
             xmlns:calendar="clr-namespace:PersonalTradingJournal.Desktop.Views.Calendar"
             AutomationProperties.Name="Trading Calendar"
             AutomationProperties.ItemStatus="{Binding AccessibleStatus}"
             xmlns:controls="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style x:Key="CalendarDayStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PtjSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PtjBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DailyOutcome}" Value="{x:Static converters:PnLOutcome.Positive}">
                    <Setter Property="Background" Value="{DynamicResource PtjSuccessSurfaceBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DailyOutcome}" Value="{x:Static converters:PnLOutcome.Negative}">
                    <Setter Property="Background" Value="{DynamicResource PtjDangerSurfaceBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PtjAccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PtjCalendarHoverBrush}" />
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                        <Condition Binding="{Binding DailyOutcome}" Value="{x:Static converters:PnLOutcome.Positive}" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource PtjCalendarSuccessHoverBrush}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                        <Condition Binding="{Binding DailyOutcome}" Value="{x:Static converters:PnLOutcome.Negative}" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource PtjCalendarDangerHoverBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CalendarDateFocusStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType={x:Type calendar:CalendarDayHost}}}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PtjTextPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CalendarDateMarkerStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PtjAccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CalendarTodayMarkerStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PtjCalendarTodayBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CalendarAmountStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PtjTextPrimaryBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static converters:PnLOutcome.Positive}">
                    <Setter Property="Foreground" Value="{DynamicResource PtjSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="{x:Static converters:PnLOutcome.Negative}">
                    <Setter Property="Foreground" Value="{DynamicResource PtjDangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="CalendarPnlTemplate">
            <Border Padding="2,4" AutomationProperties.Name="{Binding Description}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding TintBackground}" Value="True" />
                                    <Condition Binding="{Binding Outcome}" Value="{x:Static converters:PnLOutcome.Positive}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource PtjSuccessSurfaceBrush}" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding TintBackground}" Value="True" />
                                    <Condition Binding="{Binding Outcome}" Value="{x:Static converters:PnLOutcome.Negative}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource PtjDangerSurfaceBrush}" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding TintBackground}" Value="True" />
                                    <Condition Binding="{Binding Outcome}" Value="{x:Static converters:PnLOutcome.Positive}" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type calendar:CalendarDayHost}}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource PtjCalendarSuccessHoverBrush}" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding TintBackground}" Value="True" />
                                    <Condition Binding="{Binding Outcome}" Value="{x:Static converters:PnLOutcome.Negative}" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type calendar:CalendarDayHost}}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource PtjCalendarDangerHoverBrush}" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding AmountText}" Style="{StaticResource CalendarAmountStyle}" />
                    <TextBlock Text="{Binding TradeCountText}" TextAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource PtjTextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <Style x:Key="CalendarSaturdayAreaStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSaturday}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="MonthlyPnlHeader" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <TextBlock Text="Monthly P/L" TextAlignment="Center" FontWeight="SemiBold"
                       Foreground="{DynamicResource PtjTextPrimaryBrush}" />
            <ItemsControl ItemsSource="{Binding MonthlySummaries}" HorizontalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding AmountText}" Margin="8,2,8,0"
                                   Style="{StaticResource CalendarAmountStyle}" ToolTip="{Binding Description}"
                                   AutomationProperties.Name="{Binding Description}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding MonthlyStatusText}" TextAlignment="Center"
                       Foreground="{DynamicResource PtjTextSecondaryBrush}" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="‹" Command="{Binding PreviousCommand}"
                    AutomationProperties.Name="Previous calendar month"
                    ToolTip="Previous month" Style="{DynamicResource PtjIconButtonStyle}" />
            <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center"
                       Text="{Binding MonthLabel}" Style="{DynamicResource PtjSectionTitleTextStyle}"
                       AutomationProperties.Name="{Binding MonthLabel, StringFormat=Calendar month {0}}" />
            <Button Grid.Column="2" Content="›" Command="{Binding NextCommand}"
                    AutomationProperties.Name="Next calendar month"
                    ToolTip="Next month" Style="{DynamicResource PtjIconButtonStyle}" />
            <Button Grid.Column="4" Content="Today" Command="{Binding TodayCommand}"
                    AutomationProperties.Name="Go to current New York month"
                    ToolTip="Current New York month" Style="{DynamicResource PtjButtonStyle}" />
        </Grid>

        <WrapPanel Grid.Row="2" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                <Label Content="Account" Target="{Binding ElementName=CalendarAccountSelector}"
                       VerticalAlignment="Center" Foreground="{DynamicResource PtjTextSecondaryBrush}" />
                <ComboBox x:Name="CalendarAccountSelector" Width="220" MaxWidth="220" VerticalAlignment="Center"
                          ItemsSource="{Binding Accounts}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedAccount}"
                          Style="{DynamicResource PtjComboBoxStyle}"
                          AutomationProperties.Name="Calendar account" ToolTip="{Binding SelectedAccount.Name}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Label Content="Currency" Target="{Binding ElementName=CalendarCurrencySelector}"
                       VerticalAlignment="Center" Foreground="{DynamicResource PtjTextSecondaryBrush}" />
                <ComboBox x:Name="CalendarCurrencySelector" Width="150" VerticalAlignment="Center"
                          ItemsSource="{Binding Currencies}" SelectedItem="{Binding SelectedCurrency}"
                          Style="{DynamicResource PtjComboBoxStyle}"
                          AutomationProperties.Name="Calendar currency" />
            </StackPanel>
        </WrapPanel>

        <WrapPanel Grid.Row="3" MinHeight="24" Margin="0,0,0,8">
            <TextBlock Text="{Binding StatusMessage}" Style="{DynamicResource PtjCaptionTextStyle}"
                       VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            <Button Content="Cancel" Margin="12,0,0,0" Command="{Binding CancelCommand}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                    AutomationProperties.Name="Cancel Calendar refresh"
                    Style="{DynamicResource PtjSecondaryButtonStyle}" />
            <TextBlock Text="{Binding ErrorMessage}" Margin="12,0,0,0" MaxWidth="400"
                       VerticalAlignment="Center" Foreground="{DynamicResource PtjWarningBrush}"
                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
            <TextBlock Text="{Binding JournalErrorMessage}" Margin="12,0,0,0" MaxWidth="400"
                       VerticalAlignment="Center" Foreground="{DynamicResource PtjWarningBrush}"
                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="12,0,0,0"
                    AutomationProperties.Name="Refresh Calendar month and selected day"
                    Style="{DynamicResource PtjSecondaryButtonStyle}" />
            <TextBlock Text="No closed Trades in this month for the selected filters." Margin="12,0,0,0"
                       Visibility="{Binding IsMonthEmpty, Converter={StaticResource BoolVisibility}}"
                       Foreground="{DynamicResource PtjTextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="400"
                       VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
        </WrapPanel>

        <ScrollViewer x:Name="CalendarPageScroller" Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
        <ScrollViewer x:Name="CalendarScroller"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      interactions:NestedTableWheelRouting.ForwardVerticalWheel="True"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
            <Grid MinWidth="840" Width="{Binding ViewportWidth, ElementName=CalendarScroller}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <controls:UniformGrid Columns="7" Margin="0,0,0,4">
                    <controls:UniformGrid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource PtjTextMutedBrush}" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                        </Style>
                    </controls:UniformGrid.Resources>
                    <TextBlock Text="Monday" /><TextBlock Text="Tuesday" /><TextBlock Text="Wednesday" />
                    <TextBlock Text="Thursday" /><TextBlock Text="Friday" /><TextBlock Text="Saturday" />
                    <TextBlock Text="Sunday" />
                </controls:UniformGrid>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Weeks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Days}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><controls:UniformGrid Columns="7" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <calendar:CalendarDayHost MinHeight="152" Padding="8" Focusable="True"
                                                Cursor="Hand" MouseLeftButtonUp="OnDayClick" KeyDown="OnDayKeyDown"
                                                Invoked="OnDayInvoked"
                                                KeyboardNavigation.IsTabStop="True"
                                                Style="{StaticResource CalendarDayStyle}"
                                                AutomationProperties.Name="{Binding AccessibleName}"
                                                AutomationProperties.ItemStatus="{Binding AccessibleStatus}"
                                                AutomationProperties.HelpText="{Binding SelectionHelpText}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border x:Name="DateFocusMarker" Width="36" Height="36" CornerRadius="18"
                                                        HorizontalAlignment="Center" Background="Transparent"
                                                        ToolTip="{Binding DateTooltip}"
                                                        AutomationProperties.HelpText="{Binding DailyAccessibleDescription}"
                                                        Style="{StaticResource CalendarDateFocusStyle}">
                                                <Border x:Name="DateSelectionMarker" Width="30" Height="30" CornerRadius="15"
                                                        HorizontalAlignment="Center" Style="{StaticResource CalendarDateMarkerStyle}">
                                                <Border x:Name="TodayMarker" Width="24" Height="24" CornerRadius="12"
                                                        Style="{StaticResource CalendarTodayMarkerStyle}">
                                                <TextBlock Text="{Binding DayNumber}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource PtjTextPrimaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInDisplayedMonth}" Value="False">
                                                                    <Setter Property="Foreground" Value="{DynamicResource PtjTextMutedBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource PtjOnCalendarTodayBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                </Border>
                                                </Border>
                                                </Border>
                                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,0"
                                                            Visibility="{Binding ShowsDailySummary, Converter={StaticResource BoolVisibility}}">
                                                    <ItemsControl ItemsSource="{Binding DailySummaries}" ItemTemplate="{StaticResource CalendarPnlTemplate}" />
                                                </StackPanel>
                                                <Border Grid.Row="1" VerticalAlignment="Center"
                                                        Style="{StaticResource CalendarSaturdayAreaStyle}"
                                                        AutomationProperties.Name="Weekly summary area"
                                                        AutomationProperties.HelpText="{Binding WeeklyDescription}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding WeekLabel}" FontWeight="SemiBold" TextAlignment="Center"
                                                                   Foreground="{DynamicResource PtjTextPrimaryBrush}" />
                                                        <ItemsControl ItemsSource="{Binding WeeklySummaries}" ItemTemplate="{StaticResource CalendarPnlTemplate}" />
                                                        <StackPanel Visibility="{Binding HasEmptyWeek, Converter={StaticResource BoolVisibility}}">
                                                            <TextBlock Text="—" TextAlignment="Center" FontSize="18" Foreground="{DynamicResource PtjTextPrimaryBrush}" />
                                                            <TextBlock Text="0 Trades" TextAlignment="Center" FontSize="12" Foreground="{DynamicResource PtjTextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock x:Name="DayJournalIndicator" Grid.Row="2" Text="{Binding JournalIndicatorText}"
                                                           Visibility="{Binding HasJournal, Converter={StaticResource BoolVisibility}}"
                                                           Margin="0,4,0,0" FontSize="11" TextAlignment="Center"
                                                           Foreground="{DynamicResource PtjTextSecondaryBrush}"
                                                           AutomationProperties.Name="{Binding JournalAccessibleDescription}" />
                                            </Grid>
                                        </calendar:CalendarDayHost>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
        </StackPanel>
        </ScrollViewer>
        <Border x:Name="ModalShade" Background="Black" Opacity="0.35" Visibility="Collapsed" IsHitTestVisible="False" />
    </Grid>
</UserControl>
