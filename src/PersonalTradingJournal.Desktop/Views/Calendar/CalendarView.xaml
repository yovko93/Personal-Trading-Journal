<UserControl x:Class="PersonalTradingJournal.Desktop.Views.Calendar.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style x:Key="CalendarDayStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PtjSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PtjBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Opacity" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInDisplayedMonth}" Value="False">
                    <Setter Property="Opacity" Value="0.50" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PtjAccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PtjTextPrimaryBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CalendarSaturdayAreaStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSaturday}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="‹" Command="{Binding PreviousCommand}"
                    AutomationProperties.Name="Previous calendar month"
                    ToolTip="Previous month" Style="{DynamicResource PtjIconButtonStyle}" />
            <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center"
                       Text="{Binding MonthLabel}" Style="{DynamicResource PtjSectionTitleTextStyle}"
                       AutomationProperties.Name="{Binding MonthLabel, StringFormat=Calendar month {0}}" />
            <Button Grid.Column="2" Content="›" Command="{Binding NextCommand}"
                    AutomationProperties.Name="Next calendar month"
                    ToolTip="Next month" Style="{DynamicResource PtjIconButtonStyle}" />
            <Button Grid.Column="4" Content="Today" Command="{Binding TodayCommand}"
                    AutomationProperties.Name="Go to current New York month"
                    ToolTip="Current New York month" Style="{DynamicResource PtjButtonStyle}" />
        </Grid>

        <WrapPanel Grid.Row="1" MinHeight="24" Margin="0,0,0,8">
            <TextBlock Text="{Binding StatusMessage}" Style="{DynamicResource PtjCaptionTextStyle}"
                       VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            <Button Content="Cancel" Margin="12,0,0,0" Command="{Binding CancelCommand}"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}"
                    Style="{DynamicResource PtjSecondaryButtonStyle}" />
            <TextBlock Text="{Binding ErrorMessage}" Margin="12,0,0,0" MaxWidth="400"
                       VerticalAlignment="Center" Foreground="{DynamicResource PtjWarningBrush}"
                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="12,0,0,0"
                    Style="{DynamicResource PtjSecondaryButtonStyle}" />
        </WrapPanel>

        <ScrollViewer x:Name="CalendarScroller" Grid.Row="2"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
            <Grid MinWidth="700" Width="{Binding ViewportWidth, ElementName=CalendarScroller}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <controls:UniformGrid Columns="7" Margin="0,0,0,4">
                    <controls:UniformGrid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource PtjTextMutedBrush}" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                        </Style>
                    </controls:UniformGrid.Resources>
                    <TextBlock Text="Monday" /><TextBlock Text="Tuesday" /><TextBlock Text="Wednesday" />
                    <TextBlock Text="Thursday" /><TextBlock Text="Friday" /><TextBlock Text="Saturday" />
                    <TextBlock Text="Sunday" />
                </controls:UniformGrid>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Weeks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Days}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><controls:UniformGrid Columns="7" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border MinHeight="112" Padding="10" Focusable="True"
                                                KeyboardNavigation.IsTabStop="True"
                                                Style="{StaticResource CalendarDayStyle}"
                                                AutomationProperties.Name="{Binding AccessibleName}"
                                                ToolTip="{Binding AccessibleName}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding DayNumber}" HorizontalAlignment="Right"
                                                           Style="{DynamicResource PtjBodyTextStyle}" />
                                                <Border Grid.Row="2" MinHeight="48" Margin="0,8,0,0"
                                                        Style="{StaticResource CalendarSaturdayAreaStyle}"
                                                        AutomationProperties.Name="Weekly summary area" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
