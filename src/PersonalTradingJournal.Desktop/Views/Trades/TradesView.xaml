                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource PtjCaptionTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTradeDetailLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Margin="0,16,0,0"
                               Text="{Binding TradeDetailErrorMessage}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                <Setter Property="Foreground" Value="{DynamicResource PtjWarningBrush}" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTradeDetailError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Margin="0,16,0,0"
                               Text="Trade details are no longer available.">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTradeDetailNotFound}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Margin="0,16,0,0">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTradeDetail}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock FontSize="24"
                                           FontWeight="SemiBold"
                                           Style="{StaticResource PtjBodyTextStyle}"
                                           Text="{Binding SelectedTradeDetail.InstrumentSymbol}" />
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource PtjSecondaryTextStyle}">
                                    <Run Text="{Binding SelectedTradeDetail.Direction}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding SelectedTradeDetail.Status}" />
                                </TextBlock>
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="{Binding SelectedTradeDetail.InstrumentDisplayName}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Trading Account" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource PtjBodyTextStyle}"
                                           Text="{Binding SelectedTradeDetail.TradingAccountName}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Separator Style="{StaticResource PtjSeparatorStyle}" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Trading Setup" />
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource PtjBodyTextStyle}"
                                               Text="{Binding SelectedTradeDetail.TradingSetupName, TargetNullValue=—}" />
                                    <TextBlock Margin="6,0,0,0"
                                               Text="(Inactive)">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}"
                                                   BasedOn="{StaticResource PtjCaptionTextStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTradeDetail.IsTradingSetupActive}"
                                                                 Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="12,0">
                                <TextBlock Margin="0,0,0,6"
                                           Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Change setup" />
                                <ComboBox ItemsSource="{Binding TradeDetailTradingSetupOptions}"
                                          SelectedItem="{Binding SelectedTradeDetailTradingSetup}"
                                          DisplayMemberPath="Name"
                                          Style="{StaticResource PtjComboBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Bottom"
                                        Orientation="Horizontal">
                                <Button Command="{Binding ClearTradingSetupCommand}"
                                        Content="Clear"
                                        Style="{StaticResource PtjButtonStyle}" />
                                <Button Margin="8,0,0,0"
                                        Command="{Binding SaveTradingSetupCommand}"
                                        Content="Save Setup"
                                        Style="{StaticResource PtjPrimaryButtonStyle}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,10,0,0"
                                   Text="{Binding TradingSetupSaveErrorMessage}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}"
                                       BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource PtjWarningBrush}" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTradingSetupSaveError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="0,10,0,0"
                                   Text="{Binding TradingSetupSuccessMessage}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}"
                                       BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource PtjSuccessBrush}" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTradingSetupSuccess}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Separator Style="{StaticResource PtjSeparatorStyle}" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,16">
                                <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Opened (New York)" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource PtjBodyTextStyle}"
                                           Text="{Binding SelectedTradeDetail.OpenedAtUtc, Converter={StaticResource UtcToTradingTimeConverter}, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,8,16">
                                <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Closed (New York)" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource PtjBodyTextStyle}"
                                           Text="{Binding SelectedTradeDetail.ClosedAtUtc, Converter={StaticResource UtcToTradingTimeConverter}, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}, TargetNullValue=—}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="8,0,8,16">
                                <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Open Qty" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource PtjBodyTextStyle}"
                                           Text="{Binding SelectedTradeDetail.OpenQuantity}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="3" Margin="8,0,0,16">
                                <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Total Costs" />
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource PtjBodyTextStyle}"
                                               Text="{Binding SelectedTradeDetail.TotalCosts, TargetNullValue=—}" />
                                    <TextBlock Margin="4,0,0,0"
                                               Style="{StaticResource PtjCaptionTextStyle}"
                                               Text="{Binding SelectedTradeDetail.Currency}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Avg Entry" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource PtjBodyTextStyle}"
                                           Text="{Binding SelectedTradeDetail.AverageEntryPrice}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0">
                                <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Avg Exit" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource PtjBodyTextStyle}"
                                           Text="{Binding SelectedTradeDetail.AverageExitPrice, TargetNullValue=—}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="8,0">
                                <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Gross P&amp;L" />
                                <Grid Margin="0,4,0,0">
                                    <TextBlock Text="—">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}"
                                                   BasedOn="{StaticResource PtjBodyTextStyle}">
                                                <Setter Property="Foreground" Value="{DynamicResource PtjTextMutedBrush}" />
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTradeDetail.GrossPnL}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="{x:Type StackPanel}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTradeDetail.GrossPnL}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding SelectedTradeDetail.GrossPnL}">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}"
                                                       BasedOn="{StaticResource PtjBodyTextStyle}">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedTradeDetail.GrossPnL, Converter={StaticResource PnLOutcomeConverter}}"
                                                                     Value="{x:Static converters:PnLOutcome.Positive}">
                                                            <Setter Property="Foreground" Value="{DynamicResource PtjSuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedTradeDetail.GrossPnL, Converter={StaticResource PnLOutcomeConverter}}"
                                                                     Value="{x:Static converters:PnLOutcome.Negative}">
                                                            <Setter Property="Foreground" Value="{DynamicResource PtjDangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="4,0,0,0"
                                                   Style="{StaticResource PtjCaptionTextStyle}"
                                                   Text="{Binding SelectedTradeDetail.Currency}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="3" Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Net P&amp;L" />
                                <Grid Margin="0,4,0,0">
                                    <TextBlock Text="—">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}"
                                                   BasedOn="{StaticResource PtjBodyTextStyle}">
                                                <Setter Property="Foreground" Value="{DynamicResource PtjTextMutedBrush}" />
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTradeDetail.NetPnL}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="{x:Type StackPanel}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTradeDetail.NetPnL}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding SelectedTradeDetail.NetPnL}">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}"
                                                       BasedOn="{StaticResource PtjBodyTextStyle}">
                                                    <Setter Property="FontSize" Value="15" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedTradeDetail.NetPnL, Converter={StaticResource PnLOutcomeConverter}}"
                                                                     Value="{x:Static converters:PnLOutcome.Positive}">
                                                            <Setter Property="Foreground" Value="{DynamicResource PtjSuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedTradeDetail.NetPnL, Converter={StaticResource PnLOutcomeConverter}}"
                                                                     Value="{x:Static converters:PnLOutcome.Negative}">
                                                            <Setter Property="Foreground" Value="{DynamicResource PtjDangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="4,0,0,0"
                                                   Style="{StaticResource PtjCaptionTextStyle}"
                                                   Text="{Binding SelectedTradeDetail.Currency}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Separator Style="{StaticResource PtjSeparatorStyle}" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding CloseTradeSuccessMessage}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}"
                                           BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource PtjSuccessBrush}" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCloseTradeSuccess}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button Grid.Column="1"
                                    Command="{Binding ShowCloseTradeCommand}"
                                    Content="Close Trade">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}"
                                           BasedOn="{StaticResource PtjPrimaryButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelectedTradeOpen}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <Border Margin="0,16,0,0"
                                Padding="16"
                                BorderBrush="{DynamicResource PtjBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCloseTradeVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel>
                                <TextBlock Style="{StaticResource PtjSectionTitleTextStyle}"
                                           Text="Close Trade" />
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource PtjSecondaryTextStyle}"
                                           Text="Add an execution for the full remaining open quantity." />

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                   Text="Instrument" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Style="{StaticResource PtjBodyTextStyle}"
                                                   Text="{Binding SelectedTradeDetail.InstrumentSymbol}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0">
                                        <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                   Text="Direction" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Style="{StaticResource PtjBodyTextStyle}"
                                                   Text="{Binding SelectedTradeDetail.Direction}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                        <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                   Text="Open quantity" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Style="{StaticResource PtjBodyTextStyle}"
                                                   Text="{Binding SelectedTradeDetail.OpenQuantity}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.75*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Margin="0,0,0,6"
                                                   Style="{StaticResource PtjCaptionTextStyle}"
                                                   Text="Exit time (New York)" />
                                        <TextBox Style="{StaticResource PtjTextBoxStyle}"
                                                 Text="{Binding CloseTradeExecutedAtNewYorkText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Style="{StaticResource PtjCaptionTextStyle}"
                                                   Text="New York, e.g. 2026-09-14 09:30:00" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0">
                                        <TextBlock Margin="0,0,0,6"
                                                   Style="{StaticResource PtjCaptionTextStyle}"
                                                   Text="Exit price" />
                                        <TextBox Style="{StaticResource PtjTextBoxStyle}"
                                                 Text="{Binding CloseTradePriceText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0">
                                        <TextBlock Margin="0,0,0,6"
                                                   Style="{StaticResource PtjCaptionTextStyle}"
                                                   Text="Commission" />
                                        <TextBox Style="{StaticResource PtjTextBoxStyle}"
                                                 Text="{Binding CloseTradeCommissionText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                        <TextBlock Margin="0,0,0,6"
                                                   Style="{StaticResource PtjCaptionTextStyle}"
                                                   Text="Fees" />
                                        <TextBox Style="{StaticResource PtjTextBoxStyle}"
                                                 Text="{Binding CloseTradeFeesText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Margin="0,12,0,0"
                                           Text="{Binding CloseTradeValidationErrorMessage}"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}"
                                               BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                            <Setter Property="Foreground" Value="{DynamicResource PtjWarningBrush}" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCloseTradeValidationError}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Margin="0,8,0,0"
                                           Text="{Binding CloseTradeSaveErrorMessage}"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}"
                                               BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                            <Setter Property="Foreground" Value="{DynamicResource PtjWarningBrush}" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCloseTradeSaveError}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Margin="0,8,0,0"
                                           Text="Closing trade...">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}"
                                               BasedOn="{StaticResource PtjCaptionTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsClosingTrade}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <StackPanel Margin="0,16,0,0"
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal">
                                    <Button Command="{Binding CancelCloseTradeCommand}"
                                            Content="Cancel"
                                            Style="{StaticResource PtjButtonStyle}" />
                                    <Button Margin="8,0,0,0"
                                            Command="{Binding SaveCloseTradeCommand}"
                                            Content="Close Trade"
                                            Style="{StaticResource PtjPrimaryButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Separator Style="{StaticResource PtjSeparatorStyle}" />

                        <TextBlock Margin="0,8,0,0"
                                   FontWeight="SemiBold"
                                   Style="{StaticResource PtjCaptionTextStyle}"
                                   Text="PRICING SNAPSHOT" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource PtjCaptionTextStyle}"
                                   Text="Captured when the Trade was created." />
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                       Text="Point Value  " />
                            <TextBlock Style="{StaticResource PtjBodyTextStyle}"
                                       Text="{Binding SelectedTradeDetail.PricingPointValue}" />
                            <TextBlock Margin="4,0,0,0"
                                       Style="{StaticResource PtjCaptionTextStyle}"
                                       Text="{Binding SelectedTradeDetail.Currency}" />
                        </StackPanel>

                        <Separator Style="{StaticResource PtjSeparatorStyle}" />

                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource PtjSectionTitleTextStyle}"
                                   Text="Trading Mistakes" />

                        <TextBlock Margin="0,12,0,0"
                                   Text="Loading trading mistakes...">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}"
                                       BasedOn="{StaticResource PtjCaptionTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTradeMistakesLoading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Margin="0,12,0,0"
                                   Text="{Binding TradeMistakesErrorMessage}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}"
                                       BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource PtjWarningBrush}" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTradeMistakesError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Margin="0,16,0,0"
                                   HorizontalAlignment="Center"
                                   Text="No trading mistakes are assigned to this trade.">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}"
                                       BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsTradeMistakesLoading}" Value="False" />
                                                <Condition Binding="{Binding HasTradeMistakes}" Value="False" />
                                                <Condition Binding="{Binding HasTradeMistakesError}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl Margin="0,12,0,0"
                                      ItemsSource="{Binding TradeMistakes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="12"
                                            BorderBrush="{DynamicResource PtjBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontWeight="SemiBold"
                                                               Style="{StaticResource PtjBodyTextStyle}"
                                                               Text="{Binding TradingMistakeName}" />
                                                    <TextBlock Margin="6,0,0,0"
                                                               Text="(Inactive)">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}"
                                                                   BasedOn="{StaticResource PtjCaptionTextStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTradingMistakeActive}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Margin="0,5,0,0"
                                                           Text="{Binding Note}"
                                                           TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}"
                                                               BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Note}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.RemoveMistakeCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Remove"
                                                    Style="{StaticResource PtjButtonStyle}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Margin="0,8,0,0"
                                Padding="16"
                                BorderBrush="{DynamicResource PtjBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Trading Mistake" />
                                <ComboBox Margin="0,6,0,0"
                                          ItemsSource="{Binding AvailableTradingMistakes}"
                                          SelectedItem="{Binding SelectedTradingMistake}"
                                          DisplayMemberPath="Name"
                                          Style="{StaticResource PtjComboBoxStyle}" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="No active unassigned trading mistakes are available.">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}"
                                               BasedOn="{StaticResource PtjCaptionTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsTradingMistakeOptionsLoading}" Value="False" />
                                                        <Condition Binding="{Binding HasAvailableTradingMistakes}" Value="False" />
                                                        <Condition Binding="{Binding HasTradingMistakeOptionsError}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource PtjSecondaryTextStyle}"
                                           Foreground="{DynamicResource PtjWarningBrush}"
                                           Text="{Binding TradingMistakeOptionsErrorMessage}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,14,0,6"
                                           Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Note" />
                                <TextBox MinHeight="64"
                                         MaxLength="2000"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         Style="{StaticResource PtjTextBoxStyle}"
                                         Text="{Binding TradeMistakeNoteText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Optional context about what happened." />
                                <Button Margin="0,14,0,0"
                                        HorizontalAlignment="Right"
                                        Command="{Binding AssignMistakeCommand}"
                                        Content="Add Mistake"
                                        Style="{StaticResource PtjPrimaryButtonStyle}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,10,0,0"
                                   Foreground="{DynamicResource PtjWarningBrush}"
                                   Style="{StaticResource PtjSecondaryTextStyle}"
                                   Text="{Binding AssignMistakeErrorMessage}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,10,0,0"
                                   Foreground="{DynamicResource PtjSuccessBrush}"
                                   Style="{StaticResource PtjSecondaryTextStyle}"
                                   Text="{Binding AssignMistakeSuccessMessage}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,10,0,0"
                                   Foreground="{DynamicResource PtjWarningBrush}"
                                   Style="{StaticResource PtjSecondaryTextStyle}"
                                   Text="{Binding RemoveMistakeErrorMessage}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,10,0,0"
                                   Foreground="{DynamicResource PtjSuccessBrush}"
                                   Style="{StaticResource PtjSecondaryTextStyle}"
                                   Text="{Binding RemoveMistakeSuccessMessage}"
                                   TextWrapping="Wrap" />

                        <Separator Style="{StaticResource PtjSeparatorStyle}" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource PtjSectionTitleTextStyle}"
                                       Text="Screenshots" />
                            <Button Grid.Column="1"
                                    Margin="12,0,0,0"
                                    Padding="12,4"
                                    MinHeight="28"
                                    Command="{Binding ShowAddScreenshotCommand}"
                                    Content="Add Screenshot"
                                    Style="{StaticResource PtjButtonStyle}" />
                        </Grid>

                        <TextBlock Margin="0,12,0,0"
                                   Text="Loading screenshots...">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}"
                                       BasedOn="{StaticResource PtjCaptionTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTradeScreenshotsLoading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Margin="0,12,0,0"
                                   Text="{Binding TradeScreenshotsErrorMessage}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}"
                                       BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource PtjWarningBrush}" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTradeScreenshotsError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Margin="0,16,0,0"
                                   HorizontalAlignment="Center"
                                   Text="No screenshots have been added to this trade.">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}"
                                       BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsTradeScreenshotsLoading}" Value="False" />
                                                <Condition Binding="{Binding HasTradeScreenshots}" Value="False" />
                                                <Condition Binding="{Binding HasTradeScreenshotsError}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl Margin="0,12,0,0"
                                      ItemsSource="{Binding TradeScreenshots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10"
                                            Padding="12"
                                            BorderBrush="{DynamicResource PtjBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="Type" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               FontWeight="SemiBold"
                                                               Style="{StaticResource PtjBodyTextStyle}"
                                                               Text="{Binding Type}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="File" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Style="{StaticResource PtjBodyTextStyle}"
                                                               Text="{Binding FileName}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2"
                                                            Margin="12,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal">
                                                    <Button Padding="10,4"
                                                            MinHeight="28"
                                                            Command="{Binding DataContext.OpenScreenshotPreviewCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                            CommandParameter="{Binding}"
                                                            Content="View"
                                                            Style="{StaticResource PtjButtonStyle}" />
                                                    <Button Margin="8,0,0,0"
                                                            Padding="10,4"
                                                            MinHeight="28"
                                                            Command="{Binding DataContext.DeleteScreenshotCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                            CommandParameter="{Binding}"
                                                            Content="Delete"
                                                            Style="{StaticResource PtjButtonStyle}" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="Captured (UTC)" />
                                                    <Grid Margin="0,4,0,0">
                                                        <TextBlock Text="—">
                                                            <TextBlock.Style>
                                                                <Style TargetType="{x:Type TextBlock}"
                                                                       BasedOn="{StaticResource PtjBodyTextStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CapturedAtUtc}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <StackPanel Orientation="Horizontal">
                                                            <StackPanel.Style>
                                                                <Style TargetType="{x:Type StackPanel}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CapturedAtUtc}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Style="{StaticResource PtjBodyTextStyle}"
                                                                       Text="{Binding CapturedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                                            <TextBlock Margin="4,0,0,0"
                                                                       Style="{StaticResource PtjCaptionTextStyle}"
                                                                       Text="UTC" />
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="Timeframe" />
                                                    <Grid Margin="0,4,0,0">
                                                        <TextBlock Text="—">
                                                            <TextBlock.Style>
                                                                <Style TargetType="{x:Type TextBlock}"
                                                                       BasedOn="{StaticResource PtjBodyTextStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Timeframe}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Timeframe}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Timeframe}"
                                                                   TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="{x:Type TextBlock}"
                                                                       BasedOn="{StaticResource PtjBodyTextStyle}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Timeframe}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Timeframe}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Margin="0,12,0,0">
                                                <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                           Text="Description" />
                                                <Grid Margin="0,4,0,0">
                                                    <TextBlock Text="—">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}"
                                                                   BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Description}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Description}"
                                                               TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}"
                                                                   BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Description}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Margin="0,4,0,8"
                                Padding="16"
                                Background="{DynamicResource PtjBackgroundBrush}"
                                BorderBrush="{DynamicResource PtjBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScreenshotPreviewVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsScreenshotPreviewLoading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasScreenshotPreviewError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                   Text="Screenshot Preview" />
                                        <TextBlock Margin="0,4,0,0"
                                                   FontWeight="SemiBold"
                                                   Style="{StaticResource PtjBodyTextStyle}"
                                                   Text="{Binding PreviewScreenshotFileName}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Padding="10,4"
                                            MinHeight="28"
                                            VerticalAlignment="Top"
                                            Command="{Binding CloseScreenshotPreviewCommand}"
                                            Content="Close"
                                            Style="{StaticResource PtjButtonStyle}" />
                                </Grid>

                                <TextBlock Margin="0,12,0,0"
                                           Text="Loading screenshot...">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}"
                                               BasedOn="{StaticResource PtjCaptionTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsScreenshotPreviewLoading}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Margin="0,12,0,0"
                                           Text="{Binding ScreenshotPreviewErrorMessage}"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}"
                                               BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                            <Setter Property="Foreground" Value="{DynamicResource PtjWarningBrush}" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasScreenshotPreviewError}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Image Margin="0,14,0,0"
                                       MaxHeight="600"
                                       HorizontalAlignment="Center"
                                       Source="{Binding PreviewScreenshotImage}"
                                       Stretch="Uniform">
                                    <Image.Style>
                                        <Style TargetType="{x:Type Image}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsScreenshotPreviewVisible}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,4,0,0">
                            <TextBlock Text="Deleting screenshot...">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}"
                                           BasedOn="{StaticResource PtjCaptionTextStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDeletingScreenshot}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ScreenshotDeleteErrorMessage}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}"
                                           BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource PtjWarningBrush}" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasScreenshotDeleteError}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ScreenshotDeleteWarningMessage}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}"
                                           BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource PtjWarningBrush}" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasScreenshotDeleteWarning}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ScreenshotDeleteSuccessMessage}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}"
                                           BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource PtjSuccessBrush}" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasScreenshotDeleteSuccess}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Margin="0,4,0,0">
                            <TextBlock Text="{Binding ScreenshotValidationErrorMessage}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}"
                                           BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource PtjWarningBrush}" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasScreenshotValidationError}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ScreenshotSaveErrorMessage}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}"
                                           BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource PtjWarningBrush}" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasScreenshotSaveError}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ScreenshotSuccessMessage}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}"
                                           BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource PtjSuccessBrush}" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasScreenshotSuccessMessage}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <Border Margin="0,12,0,0" Padding="16">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}"
                                       BasedOn="{StaticResource PtjCardStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAddScreenshotVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Style="{StaticResource PtjBodyTextStyle}"
                                           Text="Add Screenshot" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Margin="0,0,0,6"
                                                   Style="{StaticResource PtjCaptionTextStyle}"
                                                   Text="Type" />
                                        <ComboBox ItemsSource="{Binding ScreenshotTypeOptions}"
                                                  SelectedItem="{Binding SelectedScreenshotType}"
                                                  Style="{StaticResource PtjComboBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Margin="0,0,0,6"
                                                   Style="{StaticResource PtjCaptionTextStyle}"
                                                   Text="Captured at (UTC)" />
                                        <TextBox Style="{StaticResource PtjTextBoxStyle}"
                                                 Text="{Binding ScreenshotCapturedAtUtcText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Style="{StaticResource PtjCaptionTextStyle}"
                                                   Text="Optional, e.g. 2026-09-13 13:30:00" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Margin="0,0,0,6"
                                               Style="{StaticResource PtjCaptionTextStyle}"
                                               Text="Timeframe" />
                                    <TextBox Style="{StaticResource PtjTextBoxStyle}"
                                             Text="{Binding ScreenshotTimeframeText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="0,6,0,0"
                                               Style="{StaticResource PtjCaptionTextStyle}"
                                               Text="Optional, e.g. 5m, 15m, or 1h" />
                                </StackPanel>

                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Margin="0,0,0,6"
                                               Style="{StaticResource PtjCaptionTextStyle}"
                                               Text="Description" />
                                    <TextBox MinHeight="80"
                                             AcceptsReturn="True"
                                             Style="{StaticResource PtjTextBoxStyle}"
                                             Text="{Binding ScreenshotDescriptionText, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock Margin="0,12,0,0"
                                           Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="The image file will be selected when you save."
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="0,8,0,0"
                                           Text="Adding screenshot...">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}"
                                               BasedOn="{StaticResource PtjCaptionTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAddingScreenshot}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <StackPanel Margin="0,16,0,0"
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal">
                                    <Button Command="{Binding CancelAddScreenshotCommand}"
                                            Content="Cancel"
                                            Style="{StaticResource PtjButtonStyle}" />
                                    <Button Margin="8,0,0,0"
                                            Command="{Binding SaveScreenshotCommand}"
                                            Content="Save Screenshot"
                                            Style="{StaticResource PtjPrimaryButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Separator Style="{StaticResource PtjSeparatorStyle}" />

                        <TextBlock Margin="0,8,0,0"
                                   FontWeight="SemiBold"
                                   Style="{StaticResource PtjCaptionTextStyle}"
                                   Text="EXECUTIONS" />
                        <ItemsControl Margin="0,10,0,0"
                                      ItemsSource="{Binding SelectedTradeDetail.Executions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10"
                                            Padding="12"
                                            BorderBrush="{DynamicResource PtjBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="1.6*" />
                                                    <ColumnDefinition Width="0.7*" />
                                                    <ColumnDefinition Width="0.7*" />
                                                    <ColumnDefinition Width="0.9*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="0.7*" />
                                                    <ColumnDefinition Width="0.9*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="Sequence" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Style="{StaticResource PtjBodyTextStyle}"
                                                               Text="{Binding Sequence}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0">
                                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="Executed (New York)" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Style="{StaticResource PtjBodyTextStyle}"
                                                               Text="{Binding ExecutedAtUtc, Converter={StaticResource UtcToTradingTimeConverter}, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="6,0">
                                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="Side" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Style="{StaticResource PtjBodyTextStyle}"
                                                               Text="{Binding Side}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Margin="6,0">
                                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="Qty" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Style="{StaticResource PtjBodyTextStyle}"
                                                               Text="{Binding Quantity}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4" Margin="6,0">
                                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="Price" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Style="{StaticResource PtjBodyTextStyle}"
                                                               Text="{Binding Price}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="5" Margin="6,0">
                                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="Commission" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Style="{StaticResource PtjBodyTextStyle}"
                                                               Text="{Binding Commission, TargetNullValue=—}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="6" Margin="6,0">
                                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="Fees" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Style="{StaticResource PtjBodyTextStyle}"
                                                               Text="{Binding Fees, TargetNullValue=—}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="7" Margin="6,0,0,0">
                                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="Costs" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Style="{StaticResource PtjBodyTextStyle}"
                                                               Text="{Binding TotalCosts, TargetNullValue=—}" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="Broker" />
                                                    <TextBlock Margin="0,3,0,0"
                                                               Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="{Binding BrokerSymbol, TargetNullValue=—}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="8,0">
                                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="Execution ID" />
                                                    <TextBlock Margin="0,3,0,0"
                                                               Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="{Binding ExternalExecutionId, TargetNullValue=—}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="Order ID" />
                                                    <TextBlock Margin="0,3,0,0"
                                                               Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="{Binding ExternalOrderId, TargetNullValue=—}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0"
                    Padding="24"
                    Style="{StaticResource PtjCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PtjSectionTitleTextStyle}"
                               Text="Trades" />

                    <TextBlock Margin="0,12,0,0"
                               Text="Loading trades...">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource PtjCaptionTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTradeListLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Margin="0,12,0,0"
                               Text="{Binding TradeListErrorMessage}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                <Setter Property="Foreground" Value="{DynamicResource PtjWarningBrush}" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTradeListError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Margin="0,20,0,4"
                               HorizontalAlignment="Center"
                               Text="No trades recorded yet.">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsTradeListLoading}" Value="False" />
                                            <Condition Binding="{Binding HasTradeListError}" Value="False" />
                                            <Condition Binding="{Binding HasTrades}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Margin="0,16,0,0">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTrades}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    AutomationProperties.Name="Sort by Opened New York time"
                                    Command="{Binding SortTradesCommand}"
                                    CommandParameter="{x:Static applicationTrades:TradeListSortColumn.OpenedAtUtc}">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}"
                                           BasedOn="{StaticResource TradeSortHeaderButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSortColumn}"
                                                         Value="{x:Static applicationTrades:TradeListSortColumn.OpenedAtUtc}">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource PtjSurfaceElevatedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                               Text="Opened (New York)" />
                                    <TextBlock Margin="4,0,0,0"
                                               Style="{StaticResource PtjCaptionTextStyle}"
                                               Text="{Binding OpenedAtUtcSortIndicator}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1"
                                    AutomationProperties.Name="Sort by Trade"
                                    Command="{Binding SortTradesCommand}"
                                    CommandParameter="{x:Static applicationTrades:TradeListSortColumn.Instrument}">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}"
                                           BasedOn="{StaticResource TradeSortHeaderButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSortColumn}"
                                                         Value="{x:Static applicationTrades:TradeListSortColumn.Instrument}">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource PtjSurfaceElevatedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                               Text="Trade" />
                                    <TextBlock Margin="4,0,0,0"
                                               Style="{StaticResource PtjCaptionTextStyle}"
                                               Text="{Binding InstrumentSortIndicator}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2"
                                    AutomationProperties.Name="Sort by Account"
                                    Command="{Binding SortTradesCommand}"
                                    CommandParameter="{x:Static applicationTrades:TradeListSortColumn.Account}">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}"
                                           BasedOn="{StaticResource TradeSortHeaderButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSortColumn}"
                                                         Value="{x:Static applicationTrades:TradeListSortColumn.Account}">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource PtjSurfaceElevatedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                               Text="Account" />
                                    <TextBlock Margin="4,0,0,0"
                                               Style="{StaticResource PtjCaptionTextStyle}"
                                               Text="{Binding AccountSortIndicator}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3"
                                    AutomationProperties.Name="Sort by Average Entry Price"
                                    Command="{Binding SortTradesCommand}"
                                    CommandParameter="{x:Static applicationTrades:TradeListSortColumn.AverageEntryPrice}">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}"
                                           BasedOn="{StaticResource TradeSortHeaderButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSortColumn}"
                                                         Value="{x:Static applicationTrades:TradeListSortColumn.AverageEntryPrice}">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource PtjSurfaceElevatedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                               Text="Average Prices" />
                                    <TextBlock Margin="4,0,0,0"
                                               Style="{StaticResource PtjCaptionTextStyle}"
                                               Text="{Binding AverageEntryPriceSortIndicator}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="4"
                                    AutomationProperties.Name="Sort by Open Quantity"
                                    Command="{Binding SortTradesCommand}"
                                    CommandParameter="{x:Static applicationTrades:TradeListSortColumn.OpenQuantity}">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}"
                                           BasedOn="{StaticResource TradeSortHeaderButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSortColumn}"
                                                         Value="{x:Static applicationTrades:TradeListSortColumn.OpenQuantity}">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource PtjSurfaceElevatedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                               Text="Open Qty" />
                                    <TextBlock Margin="4,0,0,0"
                                               Style="{StaticResource PtjCaptionTextStyle}"
                                               Text="{Binding OpenQuantitySortIndicator}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="5"
                                    AutomationProperties.Name="Sort by Net P&amp;L"
                                    Command="{Binding SortTradesCommand}"
                                    CommandParameter="{x:Static applicationTrades:TradeListSortColumn.NetPnL}">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}"
                                           BasedOn="{StaticResource TradeSortHeaderButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentSortColumn}"
                                                         Value="{x:Static applicationTrades:TradeListSortColumn.NetPnL}">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource PtjSurfaceElevatedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                               Text="Net P&amp;L" />
                                    <TextBlock Margin="4,0,0,0"
                                               Style="{StaticResource PtjCaptionTextStyle}"
                                               Text="{Binding NetPnLSortIndicator}" />
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Column="6"
                                       Margin="8,0,0,0"
                                       Style="{StaticResource PtjCaptionTextStyle}"
                                       Text="Actions" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding RecentTrades}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="12"
                                            BorderBrush="{DynamicResource PtjBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource PtjCornerRadiusMd}">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Background" Value="{DynamicResource PtjSurfaceElevatedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NetPnL, Converter={StaticResource PnLOutcomeConverter}}"
                                                                 Value="{x:Static converters:PnLOutcome.Positive}">
                                                        <Setter Property="Background" Value="{DynamicResource PtjSuccessSurfaceBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding NetPnL, Converter={StaticResource PnLOutcomeConverter}}"
                                                                 Value="{x:Static converters:PnLOutcome.Negative}">
                                                        <Setter Property="Background" Value="{DynamicResource PtjDangerSurfaceBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="1.1*" />
                                                <ColumnDefinition Width="1.25*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="220" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource PtjBodyTextStyle}"
                                                           Text="{Binding OpenedAtUtc, Converter={StaticResource UtcToTradingTimeConverter}, StringFormat={}{0:yyyy-MM-dd}}" />
                                                <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                           Text="{Binding OpenedAtUtc, Converter={StaticResource UtcToTradingTimeConverter}, StringFormat={}{0:HH:mm}}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Margin="8,0">
                                                <TextBlock FontWeight="SemiBold"
                                                           Style="{StaticResource PtjBodyTextStyle}"
                                                           Text="{Binding InstrumentSymbol}" />
                                                <TextBlock Style="{StaticResource PtjCaptionTextStyle}">
                                                    <Run Text="{Binding Direction}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Status}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Margin="8,0"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource PtjBodyTextStyle}"
                                                       Text="{Binding TradingAccountName}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <StackPanel Grid.Column="3"
                                                        Margin="8,0"
                                                        VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="Entry " />
                                                    <TextBlock Style="{StaticResource PtjBodyTextStyle}"
                                                               Text="{Binding AverageEntryPrice}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="Exit " />
                                                    <TextBlock Style="{StaticResource PtjBodyTextStyle}"
                                                               Text="{Binding AverageExitPrice, TargetNullValue=—}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Grid.Column="4"
                                                       Margin="8,0"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource PtjBodyTextStyle}"
                                                       Text="{Binding OpenQuantity}" />

                                            <Grid Grid.Column="5"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center">
                                                <TextBlock Text="—">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}"
                                                               BasedOn="{StaticResource PtjBodyTextStyle}">
                                                            <Setter Property="Foreground" Value="{DynamicResource PtjTextMutedBrush}" />
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding NetPnL}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.Style>
                                                        <Style TargetType="{x:Type StackPanel}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding NetPnL}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="{Binding NetPnL}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}"
                                                                   BasedOn="{StaticResource PtjBodyTextStyle}">
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding NetPnL, Converter={StaticResource PnLOutcomeConverter}}"
                                                                                 Value="{x:Static converters:PnLOutcome.Positive}">
                                                                        <Setter Property="Foreground" Value="{DynamicResource PtjSuccessBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding NetPnL, Converter={StaticResource PnLOutcomeConverter}}"
                                                                                 Value="{x:Static converters:PnLOutcome.Negative}">
                                                                        <Setter Property="Foreground" Value="{DynamicResource PtjDangerBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Margin="4,0,0,0"
                                                               Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="{Binding Currency}" />
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Grid.Column="6"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                <Button Command="{Binding DataContext.ShowTradeDetailCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource PtjEntityActionButtonStyle}"
                                                        ToolTip="View trade details">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Viewbox Width="14" Height="14">
                                                            <Path Data="{StaticResource PtjIconView}"
                                                                  Fill="{x:Null}"
                                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                                  StrokeLineJoin="Round"
                                                                  StrokeThickness="1.7" />
                                                        </Viewbox>
                                                        <TextBlock Margin="6,0,0,0" Text="View" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Margin="4,0,0,0"
                                                        Command="{Binding DataContext.ShowTradeEditCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource PtjEntityActionButtonStyle}"
                                                        ToolTip="Edit trade">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Viewbox Width="14" Height="14">
                                                            <Path Data="{StaticResource PtjIconEdit}"
                                                                  Fill="{x:Null}"
                                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                                  StrokeLineJoin="Round"
                                                                  StrokeThickness="1.7" />
                                                        </Viewbox>
                                                        <TextBlock Margin="6,0,0,0" Text="Edit" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Margin="4,0,0,0"
                                                        AutomationProperties.Name="More trade actions"
                                                        interactions:EntityActionMenu.OpensContextMenu="True"
                                                        Style="{StaticResource PtjIconButtonStyle}"
                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        ToolTip="More trade actions">
                                                    <Button.ContextMenu>
                                                        <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}"
                                                                     Style="{StaticResource PtjEntityActionMenuStyle}">
                                                            <MenuItem Command="{Binding Tag.DeleteTradeCommand}"
                                                                      CommandParameter="{Binding DataContext}"
                                                                      Header="Delete"
                                                                      Style="{StaticResource PtjDeleteMenuItemStyle}">
                                                                <MenuItem.Icon>
                                                                    <Viewbox>
                                                                        <Path Data="{StaticResource PtjIconDelete}"
                                                                              Fill="{x:Null}"
                                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}"
                                                                              StrokeLineJoin="Round"
                                                                              StrokeThickness="1.8" />
                                                                    </Viewbox>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                    <Viewbox Width="18" Height="18">
                                                        <Path Data="{StaticResource PtjIconMore}"
                                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                              Stretch="Uniform" />
                                                    </Viewbox>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource PtjCaptionTextStyle}"
                                       Text="{Binding TotalTradesText}" />

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMultipleTradePages}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button AutomationProperties.Name="Previous trade page"
                                        Command="{Binding PreviousTradePageCommand}"
                                        Content="Previous"
                                        Style="{StaticResource PtjSecondaryButtonStyle}" />
                                <TextBlock Margin="12,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource PtjBodyTextStyle}"
                                           Text="{Binding PageSummary}" />
                                <Button AutomationProperties.Name="Next trade page"
                                        Command="{Binding NextTradePageCommand}"
                                        Content="Next"
                                        Style="{StaticResource PtjSecondaryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
