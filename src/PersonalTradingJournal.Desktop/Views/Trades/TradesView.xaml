<UserControl x:Class="PersonalTradingJournal.Desktop.Views.Trades.TradesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalContentAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  PanningMode="VerticalOnly">
        <ScrollViewer.Resources>
            <Style TargetType="{x:Type ScrollBar}"
                   BasedOn="{StaticResource PtjScrollBarStyle}" />
        </ScrollViewer.Resources>

        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource PtjSecondaryTextStyle}"
                           Text="Record and manage trading activity." />
                <Button Grid.Column="1"
                        Margin="12,0,0,0"
                        Command="{Binding RefreshCommand}"
                        Content="Refresh"
                        Style="{StaticResource PtjButtonStyle}" />
                <Button Grid.Column="2"
                        Margin="8,0,0,0"
                        Command="{Binding ShowManualEntryCommand}"
                        Content="Add Trade"
                        Style="{StaticResource PtjPrimaryButtonStyle}" />
            </Grid>

            <StackPanel Margin="0,12,0,0">
                <TextBlock Text="Loading trade reference data...">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}"
                               BasedOn="{StaticResource PtjCaptionTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="{Binding ErrorMessage}">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}"
                               BasedOn="{StaticResource PtjSecondaryTextStyle}">
                            <Setter Property="Foreground" Value="{StaticResource PtjWarningBrush}" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="{Binding SuccessMessage}">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}"
                               BasedOn="{StaticResource PtjSecondaryTextStyle}">
                            <Setter Property="Foreground" Value="{StaticResource PtjSuccessBrush}" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSuccessMessage}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <Border Margin="0,16,0,0"
                    Padding="24">
                <Border.Style>
                    <Style TargetType="{x:Type Border}"
                           BasedOn="{StaticResource PtjCardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsManualEntryVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <TextBlock Style="{StaticResource PtjSectionTitleTextStyle}"
                               Text="Manual Trade Entry" />
                    <TextBlock Margin="0,6,0,0"
                               Style="{StaticResource PtjSecondaryTextStyle}"
                               Text="Enter the trade facts explicitly. Execution times are UTC." />

                    <StackPanel Margin="0,20,0,0">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="IsEnabled" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock FontWeight="SemiBold"
                                   Style="{StaticResource PtjCaptionTextStyle}"
                                   Text="REFERENCE" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Margin="0,0,0,6"
                                           Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Trading Account" />
                                <ComboBox ItemsSource="{Binding AccountOptions}"
                                          SelectedItem="{Binding SelectedAccount}"
                                          Style="{StaticResource PtjComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold"
                                                           Foreground="{StaticResource PtjTextPrimaryBrush}"
                                                           Text="{Binding Name}" />
                                                <TextBlock FontSize="12"
                                                           Foreground="{StaticResource PtjTextMutedBrush}"
                                                           Text="{Binding ProviderName}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Margin="0,8,0,0"
                                           Text="No active trading accounts are available.">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}"
                                               BasedOn="{StaticResource PtjCaptionTextStyle}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAccountOptions}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Margin="0,0,0,6"
                                           Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Instrument" />
                                <ComboBox ItemsSource="{Binding InstrumentOptions}"
                                          SelectedItem="{Binding SelectedInstrument}"
                                          Style="{StaticResource PtjComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold"
                                                           Foreground="{StaticResource PtjTextPrimaryBrush}"
                                                           Text="{Binding Symbol}" />
                                                <TextBlock FontSize="12"
                                                           Foreground="{StaticResource PtjTextMutedBrush}"
                                                           Text="{Binding DisplayName}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Margin="0,8,0,0"
                                           Text="No active instruments are available.">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}"
                                               BasedOn="{StaticResource PtjCaptionTextStyle}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasInstrumentOptions}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <Separator Style="{StaticResource PtjSeparatorStyle}" />

                        <TextBlock FontWeight="SemiBold"
                                   Style="{StaticResource PtjCaptionTextStyle}"
                                   Text="TRADE" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Margin="0,0,0,6"
                                           Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Direction" />
                                <ComboBox ItemsSource="{Binding DirectionOptions}"
                                          SelectedItem="{Binding SelectedDirection}"
                                          Style="{StaticResource PtjComboBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                <TextBlock Margin="0,0,0,6"
                                           Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Quantity" />
                                <TextBox Style="{StaticResource PtjTextBoxStyle}"
                                         Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                <TextBlock Margin="0,0,0,6"
                                           Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Completion" />
                                <CheckBox MinHeight="36"
                                          VerticalContentAlignment="Center"
                                          Content="Add exit execution"
                                          FontFamily="{StaticResource PtjFontFamily}"
                                          Foreground="{StaticResource PtjTextPrimaryBrush}"
                                          IsChecked="{Binding HasExit, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <Separator Style="{StaticResource PtjSeparatorStyle}" />

                        <TextBlock FontWeight="SemiBold"
                                   Style="{StaticResource PtjCaptionTextStyle}"
                                   Text="ENTRY" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.75*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Margin="0,0,0,6"
                                           Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Entry time (UTC)" />
                                <TextBox Style="{StaticResource PtjTextBoxStyle}"
                                         Text="{Binding EntryExecutedAtUtcText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="UTC, e.g. 2026-09-10 13:30:00" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                <TextBlock Margin="0,0,0,6"
                                           Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Entry price" />
                                <TextBox Style="{StaticResource PtjTextBoxStyle}"
                                         Text="{Binding EntryPriceText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="8,0,8,0">
                                <TextBlock Margin="0,0,0,6"
                                           Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Commission" />
                                <TextBox Style="{StaticResource PtjTextBoxStyle}"
                                         Text="{Binding EntryCommissionText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                <TextBlock Margin="0,0,0,6"
                                           Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Fees" />
                                <TextBox Style="{StaticResource PtjTextBoxStyle}"
                                         Text="{Binding EntryFeesText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasExit}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Separator Style="{StaticResource PtjSeparatorStyle}" />

                            <TextBlock FontWeight="SemiBold"
                                       Style="{StaticResource PtjCaptionTextStyle}"
                                       Text="EXIT" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.75*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Margin="0,0,0,6"
                                               Style="{StaticResource PtjCaptionTextStyle}"
                                               Text="Exit time (UTC)" />
                                    <TextBox Style="{StaticResource PtjTextBoxStyle}"
                                             Text="{Binding ExitExecutedAtUtcText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="0,6,0,0"
                                               Style="{StaticResource PtjCaptionTextStyle}"
                                               Text="UTC, e.g. 2026-09-10 13:30:00" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                    <TextBlock Margin="0,0,0,6"
                                               Style="{StaticResource PtjCaptionTextStyle}"
                                               Text="Exit price" />
                                    <TextBox Style="{StaticResource PtjTextBoxStyle}"
                                             Text="{Binding ExitPriceText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="8,0,8,0">
                                    <TextBlock Margin="0,0,0,6"
                                               Style="{StaticResource PtjCaptionTextStyle}"
                                               Text="Commission" />
                                    <TextBox Style="{StaticResource PtjTextBoxStyle}"
                                             Text="{Binding ExitCommissionText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                    <TextBlock Margin="0,0,0,6"
                                               Style="{StaticResource PtjCaptionTextStyle}"
                                               Text="Fees" />
                                    <TextBox Style="{StaticResource PtjTextBoxStyle}"
                                             Text="{Binding ExitFeesText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Margin="0,16,0,0"
                               Text="{Binding ValidationErrorMessage}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                <Setter Property="Foreground" Value="{StaticResource PtjWarningBrush}" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Margin="0,8,0,0"
                               Text="{Binding SaveErrorMessage}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                <Setter Property="Foreground" Value="{StaticResource PtjWarningBrush}" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSaveError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Margin="0,8,0,0"
                               Text="Saving trade...">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource PtjCaptionTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Margin="0,20,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Command="{Binding CancelManualEntryCommand}"
                                Content="Cancel"
                                Style="{StaticResource PtjButtonStyle}" />
                        <Button Margin="8,0,0,0"
                                Command="{Binding SaveManualTradeCommand}"
                                Content="Save Trade"
                                Style="{StaticResource PtjPrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0"
                    Padding="24">
                <Border.Style>
                    <Style TargetType="{x:Type Border}"
                           BasedOn="{StaticResource PtjCardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTradeDetailVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource PtjSectionTitleTextStyle}"
                                   Text="Trade Details" />
                        <Button Grid.Column="1"
                                Margin="12,0,0,0"
                                Padding="12,4"
                                MinHeight="28"
                                Command="{Binding CloseTradeDetailCommand}"
                                Content="Close"
                                Style="{StaticResource PtjButtonStyle}" />
                    </Grid>

                    <TextBlock Margin="0,16,0,0"
                               Text="Loading trade details...">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource PtjCaptionTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTradeDetailLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Margin="0,16,0,0"
                               Text="{Binding TradeDetailErrorMessage}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                <Setter Property="Foreground" Value="{StaticResource PtjWarningBrush}" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTradeDetailError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Margin="0,16,0,0"
                               Text="Trade details are no longer available.">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTradeDetailNotFound}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Margin="0,16,0,0">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTradeDetail}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock FontSize="24"
                                           FontWeight="SemiBold"
                                           Style="{StaticResource PtjBodyTextStyle}"
                                           Text="{Binding SelectedTradeDetail.InstrumentSymbol}" />
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource PtjSecondaryTextStyle}">
                                    <Run Text="{Binding SelectedTradeDetail.Direction}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding SelectedTradeDetail.Status}" />
                                </TextBlock>
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="{Binding SelectedTradeDetail.InstrumentDisplayName}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Trading Account" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource PtjBodyTextStyle}"
                                           Text="{Binding SelectedTradeDetail.TradingAccountName}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Separator Style="{StaticResource PtjSeparatorStyle}" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,16">
                                <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Opened (UTC)" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource PtjBodyTextStyle}"
                                           Text="{Binding SelectedTradeDetail.OpenedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,8,16">
                                <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Closed (UTC)" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource PtjBodyTextStyle}"
                                           Text="{Binding SelectedTradeDetail.ClosedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}, TargetNullValue=—}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="8,0,8,16">
                                <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Open Qty" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource PtjBodyTextStyle}"
                                           Text="{Binding SelectedTradeDetail.OpenQuantity}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="3" Margin="8,0,0,16">
                                <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Total Costs" />
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource PtjBodyTextStyle}"
                                               Text="{Binding SelectedTradeDetail.TotalCosts}" />
                                    <TextBlock Margin="4,0,0,0"
                                               Style="{StaticResource PtjCaptionTextStyle}"
                                               Text="{Binding SelectedTradeDetail.Currency}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Avg Entry" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource PtjBodyTextStyle}"
                                           Text="{Binding SelectedTradeDetail.AverageEntryPrice}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0">
                                <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Avg Exit" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource PtjBodyTextStyle}"
                                           Text="{Binding SelectedTradeDetail.AverageExitPrice, TargetNullValue=—}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="8,0">
                                <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Gross P&amp;L" />
                                <Grid Margin="0,4,0,0">
                                    <TextBlock Text="—">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}"
                                                   BasedOn="{StaticResource PtjBodyTextStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTradeDetail.GrossPnL}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="{x:Type StackPanel}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTradeDetail.GrossPnL}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Style="{StaticResource PtjBodyTextStyle}"
                                                   Text="{Binding SelectedTradeDetail.GrossPnL}" />
                                        <TextBlock Margin="4,0,0,0"
                                                   Style="{StaticResource PtjCaptionTextStyle}"
                                                   Text="{Binding SelectedTradeDetail.Currency}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="3" Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                           Text="Net P&amp;L" />
                                <Grid Margin="0,4,0,0">
                                    <TextBlock Text="—">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}"
                                                   BasedOn="{StaticResource PtjBodyTextStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTradeDetail.NetPnL}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="{x:Type StackPanel}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTradeDetail.NetPnL}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Style="{StaticResource PtjBodyTextStyle}"
                                                   Text="{Binding SelectedTradeDetail.NetPnL}" />
                                        <TextBlock Margin="4,0,0,0"
                                                   Style="{StaticResource PtjCaptionTextStyle}"
                                                   Text="{Binding SelectedTradeDetail.Currency}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Separator Style="{StaticResource PtjSeparatorStyle}" />

                        <TextBlock Margin="0,8,0,0"
                                   FontWeight="SemiBold"
                                   Style="{StaticResource PtjCaptionTextStyle}"
                                   Text="PRICING SNAPSHOT" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource PtjCaptionTextStyle}"
                                   Text="Captured when the Trade was created." />
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                       Text="Point Value  " />
                            <TextBlock Style="{StaticResource PtjBodyTextStyle}"
                                       Text="{Binding SelectedTradeDetail.PricingPointValue}" />
                            <TextBlock Margin="4,0,0,0"
                                       Style="{StaticResource PtjCaptionTextStyle}"
                                       Text="{Binding SelectedTradeDetail.Currency}" />
                        </StackPanel>

                        <Separator Style="{StaticResource PtjSeparatorStyle}" />

                        <TextBlock Margin="0,8,0,0"
                                   FontWeight="SemiBold"
                                   Style="{StaticResource PtjCaptionTextStyle}"
                                   Text="EXECUTIONS" />
                        <ItemsControl Margin="0,10,0,0"
                                      ItemsSource="{Binding SelectedTradeDetail.Executions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10"
                                            Padding="12"
                                            BorderBrush="{StaticResource PtjBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="1.6*" />
                                                    <ColumnDefinition Width="0.7*" />
                                                    <ColumnDefinition Width="0.7*" />
                                                    <ColumnDefinition Width="0.9*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="0.7*" />
                                                    <ColumnDefinition Width="0.9*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="Sequence" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Style="{StaticResource PtjBodyTextStyle}"
                                                               Text="{Binding Sequence}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0">
                                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="Executed (UTC)" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Style="{StaticResource PtjBodyTextStyle}"
                                                               Text="{Binding ExecutedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="6,0">
                                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="Side" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Style="{StaticResource PtjBodyTextStyle}"
                                                               Text="{Binding Side}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Margin="6,0">
                                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="Qty" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Style="{StaticResource PtjBodyTextStyle}"
                                                               Text="{Binding Quantity}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4" Margin="6,0">
                                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="Price" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Style="{StaticResource PtjBodyTextStyle}"
                                                               Text="{Binding Price}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="5" Margin="6,0">
                                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="Commission" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Style="{StaticResource PtjBodyTextStyle}"
                                                               Text="{Binding Commission}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="6" Margin="6,0">
                                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="Fees" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Style="{StaticResource PtjBodyTextStyle}"
                                                               Text="{Binding Fees}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="7" Margin="6,0,0,0">
                                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="Costs" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Style="{StaticResource PtjBodyTextStyle}"
                                                               Text="{Binding TotalCosts}" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="Broker" />
                                                    <TextBlock Margin="0,3,0,0"
                                                               Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="{Binding BrokerSymbol, TargetNullValue=—}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="8,0">
                                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="Execution ID" />
                                                    <TextBlock Margin="0,3,0,0"
                                                               Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="{Binding ExternalExecutionId, TargetNullValue=—}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="Order ID" />
                                                    <TextBlock Margin="0,3,0,0"
                                                               Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="{Binding ExternalOrderId, TargetNullValue=—}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0"
                    Padding="24"
                    Style="{StaticResource PtjCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PtjSectionTitleTextStyle}"
                               Text="Recent Trades" />

                    <TextBlock Margin="0,12,0,0"
                               Text="Loading trades...">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource PtjCaptionTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTradeListLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Margin="0,12,0,0"
                               Text="{Binding TradeListErrorMessage}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                <Setter Property="Foreground" Value="{StaticResource PtjWarningBrush}" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTradeListError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Margin="0,20,0,4"
                               HorizontalAlignment="Center"
                               Text="No trades recorded yet.">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsTradeListLoading}" Value="False" />
                                            <Condition Binding="{Binding HasTradeListError}" Value="False" />
                                            <Condition Binding="{Binding HasTrades}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Margin="0,16,0,0">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTrades}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource PtjCaptionTextStyle}"
                                       Text="Opened (UTC)" />
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource PtjCaptionTextStyle}"
                                       Text="Trade" />
                            <TextBlock Grid.Column="2"
                                       Style="{StaticResource PtjCaptionTextStyle}"
                                       Text="Account" />
                            <TextBlock Grid.Column="3"
                                       Style="{StaticResource PtjCaptionTextStyle}"
                                       Text="Average Prices" />
                            <TextBlock Grid.Column="4"
                                       Style="{StaticResource PtjCaptionTextStyle}"
                                       Text="Open Qty" />
                            <TextBlock Grid.Column="5"
                                       Style="{StaticResource PtjCaptionTextStyle}"
                                       Text="Net P&amp;L" />
                            <TextBlock Grid.Column="6"
                                       Margin="8,0,0,0"
                                       Style="{StaticResource PtjCaptionTextStyle}"
                                       Text="Details" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding RecentTrades}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,12"
                                            BorderBrush="{StaticResource PtjBorderBrush}"
                                            BorderThickness="0,1,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="1.1*" />
                                                <ColumnDefinition Width="1.25*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="72" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource PtjBodyTextStyle}"
                                                           Text="{Binding OpenedAtUtc, StringFormat={}{0:yyyy-MM-dd}}" />
                                                <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                           Text="{Binding OpenedAtUtc, StringFormat={}{0:HH:mm}}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Margin="8,0">
                                                <TextBlock FontWeight="SemiBold"
                                                           Style="{StaticResource PtjBodyTextStyle}"
                                                           Text="{Binding InstrumentSymbol}" />
                                                <TextBlock Style="{StaticResource PtjCaptionTextStyle}">
                                                    <Run Text="{Binding Direction}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Status}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Margin="8,0"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource PtjBodyTextStyle}"
                                                       Text="{Binding TradingAccountName}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <StackPanel Grid.Column="3"
                                                        Margin="8,0"
                                                        VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="Entry " />
                                                    <TextBlock Style="{StaticResource PtjBodyTextStyle}"
                                                               Text="{Binding AverageEntryPrice}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="Exit " />
                                                    <TextBlock Style="{StaticResource PtjBodyTextStyle}"
                                                               Text="{Binding AverageExitPrice, TargetNullValue=—}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Grid.Column="4"
                                                       Margin="8,0"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource PtjBodyTextStyle}"
                                                       Text="{Binding OpenQuantity}" />

                                            <Grid Grid.Column="5"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center">
                                                <TextBlock Text="—">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}"
                                                               BasedOn="{StaticResource PtjBodyTextStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding NetPnL}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.Style>
                                                        <Style TargetType="{x:Type StackPanel}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding NetPnL}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Style="{StaticResource PtjBodyTextStyle}"
                                                               Text="{Binding NetPnL}" />
                                                    <TextBlock Margin="4,0,0,0"
                                                               Style="{StaticResource PtjCaptionTextStyle}"
                                                               Text="{Binding Currency}" />
                                                </StackPanel>
                                            </Grid>

                                            <Button Grid.Column="6"
                                                    Margin="8,0,0,0"
                                                    Padding="10,4"
                                                    MinHeight="28"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.ShowTradeDetailCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}"
                                                    Content="View"
                                                    Style="{StaticResource PtjButtonStyle}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
