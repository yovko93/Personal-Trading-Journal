<UserControl x:Class="PersonalTradingJournal.Desktop.Views.Trades.TradesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:applicationTrades="clr-namespace:PersonalTradingJournal.Application.Trades;assembly=PersonalTradingJournal.Application"
             xmlns:converters="clr-namespace:PersonalTradingJournal.Desktop.Converters"
             xmlns:interactions="clr-namespace:PersonalTradingJournal.Desktop.Interactions"
             xmlns:validation="clr-namespace:PersonalTradingJournal.Desktop.Validation">
    <UserControl.Resources>
        <converters:PnLOutcomeConverter x:Key="PnLOutcomeConverter" />
        <Style x:Key="TradeSortHeaderButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource PtjSecondaryButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="HeaderChrome"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="{StaticResource PtjCornerRadiusSm}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderChrome"
                                        Property="Background"
                                        Value="{DynamicResource PtjSurfaceElevatedBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource PtjTextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderChrome" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="HeaderChrome"
                                        Property="Background"
                                        Value="{DynamicResource PtjSurfaceElevatedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HeaderChrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalContentAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  PanningMode="VerticalOnly">
        <ScrollViewer.Resources>
            <Style TargetType="{x:Type ScrollBar}"
                   BasedOn="{StaticResource PtjScrollBarStyle}" />
        </ScrollViewer.Resources>

        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource PtjSecondaryTextStyle}"
                           Text="Record and manage trading activity." />
                <Button Grid.Column="1"
                        Margin="12,0,0,0"
                        Command="{Binding RefreshCommand}"
                        Content="Refresh"
                        Style="{StaticResource PtjButtonStyle}" />
                <Button Grid.Column="2"
                        Margin="8,0,0,0"
                        Command="{Binding ShowManualEntryCommand}"
                        Content="Add Trade"
                        Style="{StaticResource PtjPrimaryButtonStyle}" />
            </Grid>

            <StackPanel Margin="0,12,0,0">
                <TextBlock Text="Loading trade reference data...">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}"
                               BasedOn="{StaticResource PtjCaptionTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="{Binding ErrorMessage}">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}"
                               BasedOn="{StaticResource PtjSecondaryTextStyle}">
                            <Setter Property="Foreground" Value="{DynamicResource PtjWarningBrush}" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="{Binding SuccessMessage}">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}"
                               BasedOn="{StaticResource PtjFormSuccessTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSuccessMessage}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Margin="0,8,0,0"
                           Text="{Binding TradeDeleteErrorMessage}">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}"
                               BasedOn="{StaticResource PtjSecondaryTextStyle}">
                            <Setter Property="Foreground" Value="{DynamicResource PtjWarningBrush}" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasTradeDeleteError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Margin="0,8,0,0"
                           Text="{Binding TradeDeleteWarningMessage}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}"
                               BasedOn="{StaticResource PtjSecondaryTextStyle}">
                            <Setter Property="Foreground" Value="{DynamicResource PtjWarningBrush}" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasTradeDeleteWarning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <Border Margin="0,16,0,0">
                <Border.Style>
                    <Style TargetType="{x:Type Border}"
                           BasedOn="{StaticResource PtjFormSectionStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTradeFormVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <TextBlock Style="{StaticResource PtjFormSectionTitleTextStyle}"
                               Text="{Binding TradeFormTitle}" />
                    <TextBlock Margin="0,6,0,0"
                               Style="{StaticResource PtjSecondaryTextStyle}"
                               Text="{Binding TradeFormDescription}" />

                    <StackPanel Margin="0,20,0,0">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="IsEnabled" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsUpdatingTrade}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Style="{StaticResource PtjFormSectionTitleTextStyle}"
                                   Text="Trade Details" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource PtjFormHelperTextStyle}"
                                   Text="Choose the authoritative account and instrument references." />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Margin="0,0,0,6"
                                           Style="{StaticResource PtjFormLabelTextStyle}"
                                           Text="Trading Account" />
                                <ComboBox validation:FormValidation.IsInvalid="{Binding IsTradingAccountInvalid}"
                                          ItemsSource="{Binding AccountOptions}"
                                          SelectedItem="{Binding SelectedAccount}"
                                          Style="{StaticResource PtjComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PtjTextPrimaryBrush}"
                                                           Text="{Binding Name}" />
                                                <TextBlock FontSize="12"
                                                           Foreground="{DynamicResource PtjTextMutedBrush}"
                                                           Text="{Binding ProviderName}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Margin="0,8,0,0"
                                           Text="No active trading accounts are available.">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}"
                                               BasedOn="{StaticResource PtjCaptionTextStyle}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAccountOptions}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Margin="0,0,0,6"
                                           Style="{StaticResource PtjFormLabelTextStyle}"
                                           Text="Instrument" />
                                <ComboBox validation:FormValidation.IsInvalid="{Binding IsInstrumentInvalid}"
                                          ItemsSource="{Binding InstrumentOptions}"
                                          SelectedItem="{Binding SelectedInstrument}"
                                          Style="{StaticResource PtjComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PtjTextPrimaryBrush}"
                                                           Text="{Binding Symbol}" />
                                                <TextBlock FontSize="12"
                                                           Foreground="{DynamicResource PtjTextMutedBrush}"
                                                           Text="{Binding DisplayName}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Margin="0,8,0,0"
                                           Text="No active instruments are available.">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}"
                                               BasedOn="{StaticResource PtjCaptionTextStyle}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasInstrumentOptions}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <Separator Style="{StaticResource PtjSeparatorStyle}" />

                        <TextBlock Style="{StaticResource PtjFormSectionTitleTextStyle}"
                                   Text="Position" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Margin="0,0,0,6"
                                           Style="{StaticResource PtjFormLabelTextStyle}"
                                           Text="Direction" />
                                <ComboBox validation:FormValidation.IsInvalid="{Binding IsDirectionInvalid}"
                                          ItemsSource="{Binding DirectionOptions}"
                                          SelectedItem="{Binding SelectedDirection}"
                                          Style="{StaticResource PtjComboBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                <TextBlock Margin="0,0,0,6"
                                           Style="{StaticResource PtjFormLabelTextStyle}"
                                           Text="{Binding QuantityLabel}" />
                                <TextBox validation:FormValidation.IsInvalid="{Binding IsQuantityInvalid}"
                                          Style="{StaticResource PtjTextBoxStyle}"
                                          Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource PtjFormHelperTextStyle}"
                                           Text="{Binding QuantityHint}"
                                           TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource PtjFormHelperTextStyle}"
                                           Text="{Binding SelectedInstrumentEconomicsText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="8,0,8,0">
                                <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource PtjFormLabelTextStyle}"
                                               Text="Trading Setup" />
                                    <TextBlock Margin="4,0,0,0"
                                               Style="{StaticResource PtjFormOptionalTextStyle}"
                                               Text="(Optional)" />
                                </StackPanel>
                                <ComboBox ItemsSource="{Binding AvailableTradingSetups}"
                                          SelectedItem="{Binding SelectedTradingSetup}"
                                          DisplayMemberPath="Name"
                                          Style="{StaticResource PtjComboBoxStyle}" />
                                <TextBlock Style="{StaticResource PtjFormHelperTextStyle}"
                                           Text="Only active setups can be assigned to a new trade." />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                <TextBlock Margin="0,0,0,6"
                                           Style="{StaticResource PtjFormLabelTextStyle}"
                                           Text="Completion" />
                                <CheckBox MinHeight="36"
                                          VerticalContentAlignment="Center"
                                          Content="Add exit execution"
                                          FontFamily="{StaticResource PtjFontFamily}"
                                          Foreground="{DynamicResource PtjTextPrimaryBrush}"
                                          IsChecked="{Binding HasExit, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <Separator Style="{StaticResource PtjSeparatorStyle}" />

                        <TextBlock Style="{StaticResource PtjFormSectionTitleTextStyle}"
                                   Text="Entry Execution" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource PtjFormHelperTextStyle}"
                                   Text="Record the opening execution and its direct costs." />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.75*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Margin="0,0,0,6"
                                           Style="{StaticResource PtjFormLabelTextStyle}"
                                           Text="Entry time (New York)" />
                                <TextBox validation:FormValidation.IsInvalid="{Binding IsEntryExecutedAtNewYorkInvalid}"
                                         Style="{StaticResource PtjTextBoxStyle}"
                                         Text="{Binding EntryExecutedAtNewYorkText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource PtjFormHelperTextStyle}"
                                           Text="New York, e.g. 2026-09-10 09:30:00" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                <TextBlock Margin="0,0,0,6"
                                           Style="{StaticResource PtjFormLabelTextStyle}"
                                           Text="Entry price" />
                                <TextBox validation:FormValidation.IsInvalid="{Binding IsEntryPriceInvalid}"
                                         Style="{StaticResource PtjTextBoxStyle}"
                                         Text="{Binding EntryPriceText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="8,0,8,0">
                                <TextBlock Margin="0,0,0,6"
                                           Style="{StaticResource PtjFormLabelTextStyle}"
                                           Text="Commission" />
                                <TextBox validation:FormValidation.IsInvalid="{Binding IsEntryCommissionInvalid}"
                                         Style="{StaticResource PtjTextBoxStyle}"
                                         Text="{Binding EntryCommissionText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                <TextBlock Margin="0,0,0,6"
                                           Style="{StaticResource PtjFormLabelTextStyle}"
                                           Text="Fees" />
                                <TextBox validation:FormValidation.IsInvalid="{Binding IsEntryFeesInvalid}"
                                         Style="{StaticResource PtjTextBoxStyle}"
                                         Text="{Binding EntryFeesText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasExit}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Separator Style="{StaticResource PtjSeparatorStyle}" />

                            <TextBlock Style="{StaticResource PtjFormSectionTitleTextStyle}"
                                       Text="Exit Execution" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource PtjFormHelperTextStyle}"
                                       Text="Optional full closing execution and its direct costs." />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.75*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Margin="0,0,0,6"
                                               Style="{StaticResource PtjFormLabelTextStyle}"
                                               Text="Exit time (New York)" />
                                    <TextBox validation:FormValidation.IsInvalid="{Binding IsExitExecutedAtNewYorkInvalid}"
                                             Style="{StaticResource PtjTextBoxStyle}"
                                             Text="{Binding ExitExecutedAtNewYorkText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource PtjFormHelperTextStyle}"
                                               Text="New York, e.g. 2026-09-10 10:30:00" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                    <TextBlock Margin="0,0,0,6"
                                               Style="{StaticResource PtjFormLabelTextStyle}"
                                               Text="Exit price" />
                                    <TextBox validation:FormValidation.IsInvalid="{Binding IsExitPriceInvalid}"
                                             Style="{StaticResource PtjTextBoxStyle}"
                                             Text="{Binding ExitPriceText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="8,0,8,0">
                                    <TextBlock Margin="0,0,0,6"
                                               Style="{StaticResource PtjFormLabelTextStyle}"
                                               Text="Commission" />
                                    <TextBox validation:FormValidation.IsInvalid="{Binding IsExitCommissionInvalid}"
                                             Style="{StaticResource PtjTextBoxStyle}"
                                             Text="{Binding ExitCommissionText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                    <TextBlock Margin="0,0,0,6"
                                               Style="{StaticResource PtjFormLabelTextStyle}"
                                               Text="Fees" />
                                    <TextBox validation:FormValidation.IsInvalid="{Binding IsExitFeesInvalid}"
                                             Style="{StaticResource PtjTextBoxStyle}"
                                             Text="{Binding ExitFeesText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Margin="0,16,0,0"
                               Text="{Binding ValidationErrorMessage}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource PtjFormErrorTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Margin="0,8,0,0"
                               Text="{Binding SaveErrorMessage}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource PtjFormErrorTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSaveError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Margin="0,8,0,0"
                               Text="Saving trade...">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource PtjCaptionTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Margin="0,8,0,0"
                               Text="{Binding TradeUpdateErrorMessage}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                <Setter Property="Foreground" Value="{DynamicResource PtjWarningBrush}" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTradeUpdateError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Margin="0,8,0,0" Text="Saving changes...">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource PtjCaptionTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUpdatingTrade}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Margin="0,20,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTradeEditVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Command="{Binding CancelManualEntryCommand}"
                                Content="Cancel"
                                Style="{StaticResource PtjSecondaryButtonStyle}" />
                        <Button Margin="8,0,0,0"
                                Command="{Binding SaveManualTradeCommand}"
                                Content="Save Trade"
                                Style="{StaticResource PtjPrimaryButtonStyle}" />
                    </StackPanel>

                    <StackPanel Margin="0,20,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTradeEditVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Command="{Binding CancelTradeEditCommand}"
                                Content="Cancel"
                                Style="{StaticResource PtjSecondaryButtonStyle}" />
                        <Button Margin="8,0,0,0"
                                Command="{Binding SaveTradeEditCommand}"
                                Content="Save Changes"
                                Style="{StaticResource PtjPrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0"
                    Padding="24">
                <Border.Style>
                    <Style TargetType="{x:Type Border}"
                           BasedOn="{StaticResource PtjCardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTradeDetailVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource PtjSectionTitleTextStyle}"
                                   Text="Trade Details" />
                        <Button Grid.Column="1"
                                Margin="12,0,0,0"
                                Padding="12,4"
                                MinHeight="28"
                                Command="{Binding CloseTradeDetailCommand}"
                                Content="Close"
                                Style="{StaticResource PtjButtonStyle}" />
                        <Button Grid.Column="2"
                                Margin="8,0,0,0"
                                Padding="12,4"
                                MinHeight="28"
                                Command="{Binding ShowSelectedTradeEditCommand}"
                                Content="Edit"
                                Style="{StaticResource PtjEntityActionButtonStyle}" />
                        <Button Grid.Column="3"
                                Margin="8,0,0,0"
                                AutomationProperties.Name="More trade actions"
                                interactions:EntityActionMenu.OpensContextMenu="True"
                                Style="{StaticResource PtjIconButtonStyle}"
                                Tag="{Binding}"
                                ToolTip="More trade actions">
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}"
                                             Style="{StaticResource PtjEntityActionMenuStyle}">
                                    <MenuItem Command="{Binding Tag.DeleteSelectedTradeCommand}"
                                              Header="Delete"
                                              Style="{StaticResource PtjDeleteMenuItemStyle}">
                                        <MenuItem.Icon>
                                            <Viewbox>
                                                <Path Data="{StaticResource PtjIconDelete}"
                                                      Fill="{x:Null}"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}"
                                                      StrokeLineJoin="Round"
                                                      StrokeThickness="1.8" />
                                            </Viewbox>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Viewbox Width="18" Height="18">
                                <Path Data="{StaticResource PtjIconMore}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      Stretch="Uniform" />
                            </Viewbox>
                        </Button>
