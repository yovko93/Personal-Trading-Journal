<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:trades="clr-namespace:PersonalTradingJournal.Desktop.Views.Trades"
    xmlns:validation="clr-namespace:PersonalTradingJournal.Desktop.Validation">
    <DataTemplate x:Key="TradeEntryFormTemplate">
            <Border Margin="0,16,0,0">
                <Border.Style>
                    <Style TargetType="{x:Type Border}"
                           BasedOn="{StaticResource PtjFormSectionStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTradeFormVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource PtjFormSectionTitleTextStyle}"
                               Text="{Binding TradeFormTitle}" />
                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                               Style="{StaticResource PtjSecondaryTextStyle}"
                               Text="{Binding TradeFormDescription}" />

                    <StackPanel Margin="0,20,0,0">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="IsEnabled" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsUpdatingTrade}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PtjFormSectionTitleTextStyle}"
                                   Text="Trade Details" />
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                   Style="{StaticResource PtjFormHelperTextStyle}"
                                   Text="Choose the authoritative account and instrument references." />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                           Style="{StaticResource PtjFormLabelTextStyle}"
                                           Text="Trading Account" />
                                <ComboBox AutomationProperties.Name="Trading Account"
                                         validation:FormValidation.IsInvalid="{Binding IsTradingAccountInvalid}"
                                          ItemsSource="{Binding AccountOptions}"
                                          SelectedItem="{Binding SelectedAccount}"
                                          Style="{StaticResource PtjComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PtjTextPrimaryBrush}"
                                                           Text="{Binding Name}" />
                                                <TextBlock TextWrapping="Wrap" FontSize="12"
                                                           Foreground="{DynamicResource PtjTextMutedBrush}"
                                                           Text="{Binding ProviderName}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="No active trading accounts are available.">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}"
                                               BasedOn="{StaticResource PtjCaptionTextStyle}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAccountOptions}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                           Style="{StaticResource PtjFormLabelTextStyle}"
                                           Text="Instrument" />
                                <ComboBox AutomationProperties.Name="Instrument"
                                         validation:FormValidation.IsInvalid="{Binding IsInstrumentInvalid}"
                                          ItemsSource="{Binding InstrumentOptions}"
                                          SelectedItem="{Binding SelectedInstrument}"
                                          Style="{StaticResource PtjComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PtjTextPrimaryBrush}"
                                                           Text="{Binding Symbol}" />
                                                <TextBlock TextWrapping="Wrap" FontSize="12"
                                                           Foreground="{DynamicResource PtjTextMutedBrush}"
                                                           Text="{Binding DisplayName}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="No active instruments are available.">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}"
                                               BasedOn="{StaticResource PtjCaptionTextStyle}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasInstrumentOptions}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <Separator Style="{StaticResource PtjSeparatorStyle}" />

                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PtjFormSectionTitleTextStyle}"
                                   Text="Position" />
                        <WrapPanel Margin="0,10,0,0">

                            <StackPanel Width="190" Margin="0,0,12,12">
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                           Style="{StaticResource PtjFormLabelTextStyle}"
                                           Text="Direction" />
                                <ComboBox AutomationProperties.Name="Direction"
                                         validation:FormValidation.IsInvalid="{Binding IsDirectionInvalid}"
                                          ItemsSource="{Binding DirectionOptions}"
                                          SelectedItem="{Binding SelectedDirection}"
                                          Style="{StaticResource PtjComboBoxStyle}" />
                            </StackPanel>

                            <StackPanel Width="190" Margin="0,0,12,12">
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                           Style="{StaticResource PtjFormLabelTextStyle}"
                                           Text="{Binding QuantityLabel}" />
                                <TextBox AutomationProperties.Name="{Binding QuantityLabel}"
                                         validation:FormValidation.IsInvalid="{Binding IsQuantityInvalid}"
                                          Style="{StaticResource PtjTextBoxStyle}"
                                          Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource PtjFormHelperTextStyle}"
                                           Text="{Binding QuantityHint}"
                                           TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource PtjFormHelperTextStyle}"
                                           Text="{Binding SelectedInstrumentEconomicsText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Width="190" Margin="0,0,12,12">
                                <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                                    <TextBlock TextWrapping="Wrap" Style="{StaticResource PtjFormLabelTextStyle}"
                                               Text="Trading Setup" />
                                    <TextBlock TextWrapping="Wrap" Margin="4,0,0,0"
                                               Style="{StaticResource PtjFormOptionalTextStyle}"
                                               Text="(Optional)" />
                                </StackPanel>
                                <ComboBox AutomationProperties.Name="Trading Setup (optional)"
                                          ItemsSource="{Binding AvailableTradingSetups}"
                                          SelectedItem="{Binding SelectedTradingSetup}"
                                          DisplayMemberPath="Name"
                                          Style="{StaticResource PtjComboBoxStyle}" />
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource PtjFormHelperTextStyle}"
                                            Text="Optional classification using an active Setup." />
                            </StackPanel>

                            <StackPanel Width="190" Margin="0,0,12,12">
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                           Style="{StaticResource PtjFormLabelTextStyle}"
                                           Text="Completion" />
                                <CheckBox MinHeight="36"
                                          VerticalContentAlignment="Center"
                                          Content="Add exit execution"
                                          FontFamily="{StaticResource PtjFontFamily}"
                                          Foreground="{DynamicResource PtjTextPrimaryBrush}"
                                          IsChecked="{Binding HasExit, Mode=TwoWay}" />
                            </StackPanel>
                        </WrapPanel>

                        <Separator Style="{StaticResource PtjSeparatorStyle}" />

                        <TextBlock TextWrapping="Wrap" Style="{StaticResource PtjFormSectionTitleTextStyle}"
                                   Text="Entry Execution" />
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                   Style="{StaticResource PtjFormHelperTextStyle}"
                                   Text="Record the opening execution and its direct costs." />
                        <WrapPanel Margin="0,10,0,0">


                            <StackPanel Width="190" Margin="0,0,12,12">
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                           Style="{StaticResource PtjFormLabelTextStyle}"
                                           Text="Entry time (New York)" />
                                <TextBox AutomationProperties.Name="Entry time (New York)"
                                         validation:FormValidation.IsInvalid="{Binding IsEntryExecutedAtNewYorkInvalid}"
                                         Style="{StaticResource PtjTextBoxStyle}"
                                         Text="{Binding EntryExecutedAtNewYorkText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource PtjFormHelperTextStyle}"
                                           Text="New York, e.g. 2026-09-10 09:30:00" />
                            </StackPanel>

                            <StackPanel Width="190" Margin="0,0,12,12">
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                           Style="{StaticResource PtjFormLabelTextStyle}"
                                           Text="Entry price" />
                                <TextBox AutomationProperties.Name="Entry price"
                                         validation:FormValidation.IsInvalid="{Binding IsEntryPriceInvalid}"
                                         Style="{StaticResource PtjTextBoxStyle}"
                                         Text="{Binding EntryPriceText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Width="190" Margin="0,0,12,12">
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                           Style="{StaticResource PtjFormLabelTextStyle}"
                                           Text="Commission" />
                                <TextBox AutomationProperties.Name="Entry commission"
                                         validation:FormValidation.IsInvalid="{Binding IsEntryCommissionInvalid}"
                                         Style="{StaticResource PtjTextBoxStyle}"
                                         Text="{Binding EntryCommissionText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Width="190" Margin="0,0,12,12">
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                           Style="{StaticResource PtjFormLabelTextStyle}"
                                           Text="Fees" />
                                <TextBox AutomationProperties.Name="Entry fees"
                                         validation:FormValidation.IsInvalid="{Binding IsEntryFeesInvalid}"
                                         Style="{StaticResource PtjTextBoxStyle}"
                                         Text="{Binding EntryFeesText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </WrapPanel>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasExit}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Separator Style="{StaticResource PtjSeparatorStyle}" />

                            <TextBlock TextWrapping="Wrap" Style="{StaticResource PtjFormSectionTitleTextStyle}"
                                       Text="Exit Execution" />
                            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                                       Style="{StaticResource PtjFormHelperTextStyle}"
                                       Text="Optional full closing execution and its direct costs." />
                            <WrapPanel Margin="0,10,0,0">


                                <StackPanel Width="190" Margin="0,0,12,12">
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                               Style="{StaticResource PtjFormLabelTextStyle}"
                                               Text="Exit time (New York)" />
                                    <TextBox AutomationProperties.Name="Exit time (New York)"
                                             validation:FormValidation.IsInvalid="{Binding IsExitExecutedAtNewYorkInvalid}"
                                             Style="{StaticResource PtjTextBoxStyle}"
                                             Text="{Binding ExitExecutedAtNewYorkText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock TextWrapping="Wrap" Style="{StaticResource PtjFormHelperTextStyle}"
                                               Text="New York, e.g. 2026-09-10 10:30:00" />
                                </StackPanel>

                                <StackPanel Width="190" Margin="0,0,12,12">
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                               Style="{StaticResource PtjFormLabelTextStyle}"
                                               Text="Exit price" />
                                    <TextBox AutomationProperties.Name="Exit price"
                                             validation:FormValidation.IsInvalid="{Binding IsExitPriceInvalid}"
                                             Style="{StaticResource PtjTextBoxStyle}"
                                             Text="{Binding ExitPriceText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Width="190" Margin="0,0,12,12">
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                               Style="{StaticResource PtjFormLabelTextStyle}"
                                               Text="Commission" />
                                    <TextBox AutomationProperties.Name="Exit commission"
                                             validation:FormValidation.IsInvalid="{Binding IsExitCommissionInvalid}"
                                             Style="{StaticResource PtjTextBoxStyle}"
                                             Text="{Binding ExitCommissionText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Width="190" Margin="0,0,12,12">
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                               Style="{StaticResource PtjFormLabelTextStyle}"
                                               Text="Fees" />
                                    <TextBox AutomationProperties.Name="Exit fees"
                                             validation:FormValidation.IsInvalid="{Binding IsExitFeesInvalid}"
                                             Style="{StaticResource PtjTextBoxStyle}"
                                             Text="{Binding ExitFeesText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Margin="0,16,0,0"
                               Text="{Binding ValidationErrorMessage}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource PtjFormErrorTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Margin="0,8,0,0"
                               Text="{Binding SaveErrorMessage}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource PtjFormErrorTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSaveError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Saving trade...">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource PtjCaptionTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Margin="0,8,0,0"
                               Text="{Binding TradeUpdateErrorMessage}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource PtjSecondaryTextStyle}">
                                <Setter Property="Foreground" Value="{DynamicResource PtjWarningBrush}" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTradeUpdateError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Text="Saving changes...">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource PtjCaptionTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUpdatingTrade}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" Text="Description (optional)" Style="{StaticResource PtjFormLabelTextStyle}" Margin="0,16,0,6" />
                    <TextBox Text="{Binding TradeDescriptionText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxLength="10000" Style="{StaticResource PtjTextBoxStyle}" AutomationProperties.Name="Trade description" />
                    <trades:TradeScreenshotWorkspace Margin="0,16,0,0"><trades:TradeScreenshotWorkspace.Style><Style TargetType="trades:TradeScreenshotWorkspace"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsManualEntryVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></trades:TradeScreenshotWorkspace.Style></trades:TradeScreenshotWorkspace>
                    <StackPanel Margin="0,20,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTradeEditVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Command="{Binding CancelManualEntryCommand}"
                                Content="Cancel"
                                Style="{StaticResource PtjSecondaryButtonStyle}" />
                        <Button Margin="8,0,0,0"
                                Command="{Binding SaveManualTradeCommand}"
                                Content="Save Trade"
                                Style="{StaticResource PtjPrimaryButtonStyle}" />
                    </StackPanel>

                    <StackPanel Margin="0,20,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTradeEditVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Command="{Binding CancelTradeEditCommand}"
                                Content="Cancel"
                                Style="{StaticResource PtjSecondaryButtonStyle}" />
                        <Button Margin="8,0,0,0"
                                Command="{Binding SaveTradeEditCommand}"
                                Content="Save Changes"
                                Style="{StaticResource PtjPrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
    </DataTemplate>
</ResourceDictionary>
