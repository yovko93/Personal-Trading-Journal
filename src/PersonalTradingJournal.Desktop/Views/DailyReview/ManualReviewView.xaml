<UserControl x:Class="PersonalTradingJournal.Desktop.Views.DailyReview.ManualReviewView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:PersonalTradingJournal.Desktop.ViewModels.DailyReview" xmlns:period="clr-namespace:PersonalTradingJournal.Desktop.Views.PeriodReviews"
 Foreground="{DynamicResource PtjTextPrimaryBrush}" FontSize="16">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visible" />
  <Style x:Key="Body" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,5" /></Style>
  <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource PtjButtonStyle}"><Setter Property="Margin" Value="0,4,8,4" /></Style>
  <DataTemplate DataType="{x:Type vm:ManualPreviewCard}">
   <Border Margin="0,6,8,6" Padding="14" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource PtjBorderBrush}">
    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource PtjSurfaceBrush}" /><Style.Triggers>
     <DataTrigger Binding="{Binding Heading}" Value="Strengths"><Setter Property="Background" Value="{DynamicResource PtjReviewStrengthSurfaceBrush}" /></DataTrigger>
     <DataTrigger Binding="{Binding Heading}" Value="Areas for Improvement"><Setter Property="Background" Value="{DynamicResource PtjReviewImproveSurfaceBrush}" /></DataTrigger>
    </Style.Triggers></Style></Border.Style>
    <StackPanel><TextBlock Text="{Binding Heading}" Style="{StaticResource Body}" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="{Binding Text}" Style="{StaticResource Body}" MaxWidth="850" HorizontalAlignment="Left" /></StackPanel>
   </Border>
  </DataTemplate>
 </UserControl.Resources>
 <StackPanel>
  <TextBlock Text="{Binding Disclosure}" Style="{StaticResource Body}" />
  <WrapPanel><Button Content="Prepare ChatGPT Prompt" Command="{Binding PrepareCommand}" Style="{DynamicResource PtjJournalSaveButtonStyle}" Margin="0,8,8,8" AutomationProperties.Name="Prepare ChatGPT Prompt locally" />
   <Button Content="Reload pending work" Command="{Binding ReloadCommand}" Style="{StaticResource Action}" />
   <Button Content="Cancel local operation" Command="{Binding CancelCommand}" Style="{StaticResource Action}" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" /></WrapPanel>
  <TextBlock Text="{Binding Message}" Style="{StaticResource Body}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Manual review status" />
  <ProgressBar IsIndeterminate="True" Height="4" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" AutomationProperties.Name="Local review operation in progress" />
  <StackPanel Visibility="{Binding HasPending, Converter={StaticResource Visible}, FallbackValue=Collapsed}">
   <TextBlock Text="{Binding PendingScope}" Style="{StaticResource Body}" FontWeight="SemiBold" AutomationProperties.Name="Frozen pending review scope" />
   <TextBlock Text="{Binding Size}" Style="{StaticResource Body}" />
   <Expander Header="Exact prompt preview" Foreground="{DynamicResource PtjTextPrimaryBrush}" AutomationProperties.Name="Exact prompt preview">
    <TextBox Text="{Binding Prompt, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="240" AutomationProperties.Name="Exact prepared ChatGPT prompt" Style="{DynamicResource PtjTextBoxStyle}" />
   </Expander>
   <WrapPanel><Button Content="Copy Prompt" Command="{Binding CopyCommand}" Style="{StaticResource Action}" />
    <Button Content="Paste ChatGPT Response" Command="{Binding PasteCommand}" Style="{StaticResource Action}" /></WrapPanel>
   <Label Content="ChatGPT response · single JSON object" Target="{Binding ElementName=Response}" Foreground="{DynamicResource PtjTextPrimaryBrush}" />
   <TextBox x:Name="Response" Text="{Binding ResponseText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditResponse}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="240" VerticalScrollBarVisibility="Auto" Style="{DynamicResource PtjTextBoxStyle}" AutomationProperties.Name="Pasted ChatGPT response" />
   <WrapPanel><Button Content="Keep response draft" Command="{Binding KeepCommand}" Style="{StaticResource Action}" />
    <Button Content="Validate response" Command="{Binding ValidateCommand}" Style="{StaticResource Action}" />
    <Button Content="Save Review" Command="{Binding SaveCommand}" Style="{DynamicResource PtjJournalSaveButtonStyle}" Margin="0,4,8,4" />
    <Button Content="Discard pending work" Command="{Binding DiscardCommand}" Style="{DynamicResource PtjDangerButtonStyle}" Margin="0,4,8,4" /></WrapPanel>
   <TextBlock Text="Pasted external AI response · PTJ cannot verify the originating service or the truth of every claim. Preview is not history until saved." Style="{StaticResource Body}" />
   <ItemsControl ItemsSource="{Binding PreviewCards}" AutomationProperties.Name="Validated external response preview cards"><ItemsControl.Style><Style TargetType="ItemsControl"><Style.Triggers>
    <DataTrigger Binding="{Binding IsPeriod}" Value="True"><Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><period:ReviewCardsPanel /></ItemsPanelTemplate></Setter.Value></Setter></DataTrigger>
   </Style.Triggers></Style></ItemsControl.Style></ItemsControl>
  </StackPanel>
  <Expander Header="Privacy and local draft storage" Foreground="{DynamicResource PtjTextPrimaryBrush}"><TextBlock Text="{Binding Details}" Style="{StaticResource Body}" MaxWidth="850" HorizontalAlignment="Left" /></Expander>
 </StackPanel>
</UserControl>
