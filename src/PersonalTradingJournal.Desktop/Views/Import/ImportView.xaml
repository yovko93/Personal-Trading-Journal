<UserControl x:Class="PersonalTradingJournal.Desktop.Views.Import.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PersonalTradingJournal.Desktop.Views.Import"
             xmlns:interactions="clr-namespace:PersonalTradingJournal.Desktop.Interactions"
             xmlns:converters="clr-namespace:PersonalTradingJournal.Desktop.Converters">
    <UserControl.Resources>
        <converters:TradingTimestampConverter x:Key="TradingTimestamp" />
        <Style x:Key="SourceAction" TargetType="Button" BasedOn="{StaticResource PtjButtonStyle}">
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <DataTemplate x:Key="CostSourceDetails">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding FileName, TargetNullValue=No file selected}"
                           Style="{StaticResource PtjBodyTextStyle}" TextWrapping="Wrap" />
                <TextBlock Margin="0,3,0,0" TextWrapping="Wrap"
                           AutomationProperties.Name="{Binding Announcement}"
                           AutomationProperties.LiveSetting="Polite"
                           interactions:LiveAnnouncement.Text="{Binding Announcement}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PtjFormHelperTextStyle}">
                            <Setter Property="Text" Value="{Binding Status}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                    <Setter Property="Text" Value="✓ Verified" />
                                    <Setter Property="Foreground" Value="{DynamicResource PtjSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource PtjDangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer HorizontalContentAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  PanningMode="VerticalOnly">
        <ScrollViewer.Resources>
            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource PtjScrollBarStyle}" />
        </ScrollViewer.Resources>

        <StackPanel>
            <TextBlock Style="{StaticResource PtjSecondaryTextStyle}"
                       Text="Choose Tradovate or TopstepX before selecting its CSV. Review the preview, then confirm the import."
                       TextWrapping="Wrap" />

            <Border x:Name="SourcePanel" Margin="0,16,0,0" Style="{StaticResource PtjFormSectionStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PtjFormSectionTitleTextStyle}" Text="1. Source file" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource PtjFormHelperTextStyle}"
                               Text="The file is read in place. Its local location is retained only for this workflow so Topstep preview and confirmation can reopen and verify the source; it is not logged."
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,12,0,0" Text="Import source" Style="{StaticResource PtjFormHelperTextStyle}" />
                    <ComboBox Margin="0,4,0,0" ItemsSource="{Binding Sources}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedSource}" AutomationProperties.Name="Import source">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource PtjComboBoxStyle}">
                                <Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SelectPerformance" Command="{Binding SelectCsvCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PtjPrimaryButtonStyle}">
                                    <Setter Property="Content" Value="Select CSV" />
                                    <Setter Property="VerticalAlignment" Value="Top" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSource.Name}" Value="Tradovate">
                                            <Setter Property="Content" Value="Select Performance" />
                                            <Setter Property="Background" Value="{DynamicResource PtjPerformanceSourceBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource PtjTextPrimaryBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource PtjBorderBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Style="{StaticResource PtjBodyTextStyle}" TextWrapping="Wrap"
                                       Text="{Binding SelectedFileName, TargetNullValue=No file selected}" />
                            <TextBlock Style="{StaticResource PtjCaptionTextStyle}" TextWrapping="Wrap"
                                       Text="{Binding Phase}" />
                        </StackPanel>
                    </Grid>
                    <Button Margin="0,8,0,0" HorizontalAlignment="Left" Command="{Binding CancelOperationCommand}"
                            Content="Cancel operation" IsEnabled="{Binding IsBusy}" Style="{StaticResource PtjSecondaryButtonStyle}" />
                    <StackPanel Margin="0,12,0,0">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsTradovate}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock Text="Optional verified Net P/L: select matching Fills and Cash History after Performance. The Account external ID must match the exports. Without both files, costs remain unknown."
                                   TextWrapping="Wrap" Style="{StaticResource PtjFormHelperTextStyle}" />
                        <StackPanel Grid.IsSharedSizeScope="True">
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="SupportingSourceAction" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="SelectFills" Content="{Binding FillsSource.ActionLabel}"
                                        AutomationProperties.Name="{Binding FillsSource.ActionLabel}"
                                        Command="{Binding SelectFillsCommand}" Style="{StaticResource SourceAction}"
                                        Background="{DynamicResource PtjFillsSourceBrush}" />
                                <ContentControl x:Name="FillsDetails" Grid.Column="1" Margin="12,0,0,0"
                                                HorizontalContentAlignment="Stretch" Focusable="False"
                                                Content="{Binding FillsSource}" ContentTemplate="{StaticResource CostSourceDetails}" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="SupportingSourceAction" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="SelectCashHistory" Content="{Binding CashHistorySource.ActionLabel}"
                                        AutomationProperties.Name="{Binding CashHistorySource.ActionLabel}"
                                        Command="{Binding SelectCashHistoryCommand}" Style="{StaticResource SourceAction}"
                                        Background="{DynamicResource PtjCashSourceBrush}" />
                                <ContentControl x:Name="CashHistoryDetails" Grid.Column="1" Margin="12,0,0,0"
                                                HorizontalContentAlignment="Stretch" Focusable="False"
                                                Content="{Binding CashHistorySource}" ContentTemplate="{StaticResource CostSourceDetails}" />
                            </Grid>
                        </StackPanel>
                        <Button x:Name="PerformanceOnly" Content="Use Performance only" HorizontalAlignment="Left" Margin="0,12,0,0"
                                Command="{Binding ClearCostSourcesCommand}" Style="{StaticResource SourceAction}"
                                AutomationProperties.HelpText="Clear the supporting files and continue with unknown costs."
                                Background="{DynamicResource PtjPerformanceOnlyBrush}" />
                        <TextBlock x:Name="VerifiedCostPreview" Text="{Binding VerifiedCostSummary}" Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource PtjBodyTextStyle}" />
                    </StackPanel>
                    <TextBlock Margin="0,12,0,0" Text="{Binding WorkflowErrorMessage}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"
                               interactions:LiveAnnouncement.Text="{Binding WorkflowErrorMessage}">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PtjFormErrorTextStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WorkflowErrorMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0">
                <Border.Style>
                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource PtjFormSectionStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasImportResult}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Style="{StaticResource PtjFormSectionTitleTextStyle}" Text="2. Trading account" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource PtjFormHelperTextStyle}"
                               Text="Choose the destination account explicitly. Inactive accounts remain selectable and are clearly labeled."
                               TextWrapping="Wrap" />
                    <ComboBox Margin="0,12,0,0"
                              ItemsSource="{Binding Accounts}"
                              DisplayMemberPath="DisplayText"
                              SelectedItem="{Binding SelectedAccount}">
                        <ComboBox.Style>
                            <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource PtjComboBoxStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                    <TextBlock Margin="0,12,0,0" Text="{Binding AccountErrorMessage}">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PtjFormErrorTextStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AccountErrorMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Margin="0,16,0,0" HorizontalAlignment="Right"
                            Command="{Binding BuildPreviewCommand}"
                            Content="Build Preview"
                            Style="{StaticResource PtjPrimaryButtonStyle}" />
                </StackPanel>
            </Border>

            <TextBlock Margin="0,12,0,0"
                       Text="{Binding ImportErrorMessage}"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PtjFormErrorTextStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ImportErrorMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Border Margin="0,16,0,0">
                <Border.Style>
                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource PtjCardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAnalysis}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Style="{StaticResource PtjSectionTitleTextStyle}" Text="Analysis summary" />
                    <UniformGrid Margin="0,14,0,0" Columns="5">
                        <StackPanel Margin="0,0,12,8"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="SOURCE ROWS" /><TextBlock Style="{StaticResource PtjSectionTitleTextStyle}" Text="{Binding AnalysisSummary.SourceRecordCount}" /></StackPanel>
                        <StackPanel Margin="0,0,12,8"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="VALID / REJECTED" /><TextBlock Style="{StaticResource PtjSectionTitleTextStyle}"><Run Text="{Binding AnalysisSummary.ValidRecordCount}" /><Run Text=" / " /><Run Text="{Binding AnalysisSummary.RejectedRecordCount}" /></TextBlock></StackPanel>
                        <StackPanel Margin="0,0,12,8">
                            <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsTopstep}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="BUY / SELL FILLS" /><TextBlock Style="{StaticResource PtjSectionTitleTextStyle}"><Run Text="{Binding AnalysisSummary.UniqueBuyFillCount}" /><Run Text=" / " /><Run Text="{Binding AnalysisSummary.UniqueSellFillCount}" /></TextBlock>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="{Binding CandidateLabel}" /><TextBlock Style="{StaticResource PtjSectionTitleTextStyle}" Text="{Binding AnalysisSummary.CandidateCount}" /></StackPanel>
                        <StackPanel Margin="0,0,0,8"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="INSTRUMENTS" /><TextBlock Style="{StaticResource PtjSectionTitleTextStyle}"><Run Text="{Binding AnalysisSummary.ExistingInstrumentCount}" /><Run Text=" existing · " /><Run Text="{Binding AnalysisSummary.ProposedInstrumentCount}" /><Run Text=" new" /></TextBlock></StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0">
                <Border.Style>
                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource PtjCardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding HasAnalysis}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Style="{StaticResource PtjSectionTitleTextStyle}" Text="Instrument resolution" />
                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Instruments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,6,0,6" Padding="12"
                                        Background="{DynamicResource PtjSurfaceElevatedBrush}"
                                        CornerRadius="{StaticResource PtjCornerRadiusSm}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource PtjSectionTitleTextStyle}" Text="{Binding CanonicalSymbol}" />
                                            <TextBlock Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center"
                                                       Style="{StaticResource PtjSecondaryTextStyle}" Text="{Binding SourceSymbols}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                       Style="{StaticResource PtjBodyTextStyle}" FontWeight="SemiBold" Text="{Binding StatusText}" />
                                        </Grid>
                                        <UniformGrid Margin="0,12,0,0" Columns="3">
                                            <StackPanel Margin="0,0,12,8"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="DISPLAY NAME" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding DisplayName}" TextWrapping="Wrap" /></StackPanel>
                                            <StackPanel Margin="0,0,12,8"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="ASSET CLASS" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding AssetClass}" /></StackPanel>
                                            <StackPanel Margin="0,0,0,8"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="EXCHANGE" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding Exchange}" /></StackPanel>
                                            <StackPanel Margin="0,0,12,0"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="CURRENCY" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding Currency}" /></StackPanel>
                                            <StackPanel Margin="0,0,12,0"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="TICK SIZE" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding TickSize}" /></StackPanel>
                                            <StackPanel><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="TICK VALUE" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding TickValue}" /></StackPanel>
                                        </UniformGrid>
                                        <TextBlock Margin="0,12,0,0"
                                                   Text="Will be created only when the import is confirmed."
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PtjBodyTextStyle}">
                                                    <Setter Property="Foreground" Value="{DynamicResource PtjWarningBrush}" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding CreationNotice}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0">
                <Border.Style>
                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource PtjCardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding HasPreview}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding IsTopstep}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Style="{StaticResource PtjSectionTitleTextStyle}" Text="Preview summary" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource PtjDetailLabelTextStyle}" Text="File" /><TextBlock Grid.Column="1" Style="{StaticResource PtjDetailValueTextStyle}" Text="{Binding PreviewSummary.FileName}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource PtjDetailLabelTextStyle}" Text="Account" /><TextBlock Grid.Column="3" Style="{StaticResource PtjDetailValueTextStyle}" Text="{Binding PreviewSummary.AccountName}" />
                        <TextBlock Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource PtjDetailLabelTextStyle}" Text="Time policy" /><TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,0,0" Style="{StaticResource PtjDetailValueTextStyle}"><Run Text="Source: Europe/Sofia · Canonical: UTC · Preview: America/New_York" /></TextBlock>
                        <TextBlock Grid.Row="2" Margin="0,8,0,0" Style="{StaticResource PtjDetailLabelTextStyle}" Text="Period start" /><TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource PtjDetailValueTextStyle}" Text="{Binding PreviewSummary.PeriodStartNewYork, Converter={StaticResource TradingTimestamp}, ConverterParameter='yyyy-MM-dd HH:mm:ss'}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,8,0,0" Style="{StaticResource PtjDetailLabelTextStyle}" Text="Period end" /><TextBlock Grid.Row="2" Grid.Column="3" Margin="0,8,0,0" Style="{StaticResource PtjDetailValueTextStyle}" Text="{Binding PreviewSummary.PeriodEndNewYork, Converter={StaticResource TradingTimestamp}, ConverterParameter='yyyy-MM-dd HH:mm:ss'}" />
                        <TextBlock Grid.Row="3" Margin="0,8,0,0" Style="{StaticResource PtjDetailLabelTextStyle}" Text="Diagnostics" /><TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,0,0" Style="{StaticResource PtjDetailValueTextStyle}"><Run Text="{Binding PreviewSummary.WarningCount}" /><Run Text=" warnings · " /><Run Text="{Binding PreviewSummary.ErrorCount}" /><Run Text=" errors" /></TextBlock>
                    </Grid>
                    <TextBlock Margin="0,14,0,0" Foreground="{DynamicResource PtjWarningBrush}"
                               Style="{StaticResource PtjBodyTextStyle}"
                               Text="Performance alone has unknown costs and Net P&amp;L. With matching Fills and Cash History, review the verified Gross, costs and Net above before confirmation."
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0">
                <Border.Style>
                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource PtjCardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding HasPreview}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding IsTopstep}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Style="{StaticResource PtjSectionTitleTextStyle}" Text="Trade candidates" />
                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Trades}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,5,0,5" Padding="12" Background="{DynamicResource PtjSurfaceElevatedBrush}" CornerRadius="{StaticResource PtjCornerRadiusSm}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.55*" /><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1.7*" /><ColumnDefinition Width="1.7*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <StackPanel Margin="0,0,10,10"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="CANDIDATE" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding CandidateIndex}" /></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,10,10"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="BROKER → CANONICAL" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" FontWeight="SemiBold" Text="{Binding Symbols}" /></StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,10,10"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="ACCOUNT" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding AccountName}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                        <StackPanel Grid.Column="3" Margin="0,0,10,10"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="DIRECTION" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding Direction}" /></StackPanel>
                                        <StackPanel Grid.Column="4" Margin="0,0,10,10"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="OPENED · NEW YORK" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding OpenedAt}" /></StackPanel>
                                        <StackPanel Grid.Column="5" Margin="0,0,0,10"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="CLOSED · NEW YORK" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding ClosedAt}" /></StackPanel>
                                        <StackPanel Grid.Row="1" Margin="0,0,10,0"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="EXECUTIONS" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding ExecutionCount}" /></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,0"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="OPENING QUANTITY" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding OpeningQuantity}" /></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,10,0" ClipToBounds="True"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="WEIGHTED AVG ENTRY" TextTrimming="CharacterEllipsis" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding AverageEntry, StringFormat={}{0:F2}}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,10,0" ClipToBounds="True"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="WEIGHTED AVG EXIT" TextTrimming="CharacterEllipsis" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding AverageExit, StringFormat={}{0:F2}, TargetNullValue=—}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,10,0"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="SOURCE P&amp;L" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding SourcePnL}" /></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="5"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="INSTRUMENT RESOLUTION" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding Resolution}" /></StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <local:TopstepReviewView>
                <local:TopstepReviewView.Style>
                    <Style TargetType="local:TopstepReviewView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasAnalysis}" Value="True" />
                                    <Condition Binding="{Binding IsTopstep}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </local:TopstepReviewView.Style>
            </local:TopstepReviewView>

            <Border x:Name="DiagnosticsSection" Margin="0,16,0,0">
                <Border.Style>
                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource PtjCardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDiagnostics}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Style="{StaticResource PtjSectionTitleTextStyle}" Text="Diagnostics" />
                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Diagnostics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5,0,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="90" /><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="{Binding Stage}" />
                                    <TextBlock Grid.Column="1" Foreground="{DynamicResource PtjWarningBrush}" Style="{StaticResource PtjCaptionTextStyle}" Text="{Binding Severity}" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource PtjCaptionTextStyle}" Text="{Binding Code}" TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="3"><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding Message}" TextWrapping="Wrap" /><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="{Binding Context}" /></StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0">
                <Border.Style>
                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource PtjFormSectionStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowConfirmationSection}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="3. Confirm import">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource PtjFormSectionTitleTextStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasImportResult}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="Confirm import">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource PtjFormSectionTitleTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasImportResult}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource PtjFormHelperTextStyle}"
                               Text="The preview is read-only. Trades and proposed Instruments are persisted only after you review and confirm the operation."
                               TextWrapping="Wrap" />
                    <Button Margin="0,16,0,0"
                            HorizontalAlignment="Right"
                            Command="{Binding ConfirmImportCommand}"
                            Content="Import Trades"
                            Style="{StaticResource PtjPrimaryButtonStyle}" />
                    <TextBlock Margin="0,12,0,0"
                               Text="{Binding ImportSuccessMessage}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PtjFormSuccessTextStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ImportSuccessMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Margin="0,12,0,0"
                            Padding="12"
                            Background="{DynamicResource PtjSurfaceElevatedBrush}"
                            CornerRadius="{StaticResource PtjCornerRadiusSm}">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasImportResult}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <UniformGrid Columns="4">
                            <StackPanel Margin="0,0,12,0"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="OUTCOME" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" FontWeight="SemiBold" Text="{Binding ImportResultStatus}" /></StackPanel>
                            <StackPanel Margin="0,0,12,0"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="IMPORTED TRADES" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding ImportedTradeCount}" /></StackPanel>
                            <StackPanel Margin="0,0,12,0"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="DUPLICATES SKIPPED" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding SkippedDuplicateTradeCount}" /></StackPanel>
                            <StackPanel><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="INSTRUMENTS CREATED" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding CreatedInstrumentCount}" /></StackPanel>
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
