<UserControl x:Class="PersonalTradingJournal.Desktop.Views.Import.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalContentAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  PanningMode="VerticalOnly">
        <ScrollViewer.Resources>
            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource PtjScrollBarStyle}" />
        </ScrollViewer.Resources>

        <StackPanel>
            <TextBlock Style="{StaticResource PtjSecondaryTextStyle}"
                       Text="Analyze a Tradovate matched-fills CSV and review the normalized trades before a future import."
                       TextWrapping="Wrap" />

            <Border Margin="0,16,0,0" Style="{StaticResource PtjFormSectionStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PtjFormSectionTitleTextStyle}" Text="1. Source file" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource PtjFormHelperTextStyle}"
                               Text="The file is read in place, then its stream is closed. Raw CSV data and full paths are not retained."
                               TextWrapping="Wrap" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding SelectCsvCommand}"
                                Content="Select CSV"
                                Style="{StaticResource PtjPrimaryButtonStyle}" />
                        <TextBlock Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center"
                                   Style="{StaticResource PtjBodyTextStyle}"
                                   Text="{Binding SelectedFileName, TargetNullValue=No file selected}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                   Style="{StaticResource PtjCaptionTextStyle}"
                                   Text="{Binding Phase}" />
                    </Grid>
                    <TextBlock Margin="0,12,0,0" Text="{Binding WorkflowErrorMessage}">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PtjFormErrorTextStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WorkflowErrorMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0" Style="{StaticResource PtjFormSectionStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PtjFormSectionTitleTextStyle}" Text="2. Trading account" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource PtjFormHelperTextStyle}"
                               Text="Choose the destination account explicitly. Inactive accounts remain selectable and are clearly labeled."
                               TextWrapping="Wrap" />
                    <ComboBox Margin="0,12,0,0"
                              ItemsSource="{Binding Accounts}"
                              DisplayMemberPath="DisplayText"
                              SelectedItem="{Binding SelectedAccount}"
                              Style="{StaticResource PtjComboBoxStyle}" />
                    <TextBlock Margin="0,12,0,0" Text="{Binding AccountErrorMessage}">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PtjFormErrorTextStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AccountErrorMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Margin="0,16,0,0" HorizontalAlignment="Right"
                            Command="{Binding BuildPreviewCommand}"
                            Content="Build Preview"
                            Style="{StaticResource PtjPrimaryButtonStyle}" />
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0">
                <Border.Style>
                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource PtjCardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAnalysis}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Style="{StaticResource PtjSectionTitleTextStyle}" Text="Analysis summary" />
                    <UniformGrid Margin="0,14,0,0" Columns="5">
                        <StackPanel Margin="0,0,12,8"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="SOURCE ROWS" /><TextBlock Style="{StaticResource PtjSectionTitleTextStyle}" Text="{Binding AnalysisSummary.SourceRecordCount}" /></StackPanel>
                        <StackPanel Margin="0,0,12,8"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="VALID / REJECTED" /><TextBlock Style="{StaticResource PtjSectionTitleTextStyle}"><Run Text="{Binding AnalysisSummary.ValidRecordCount}" /><Run Text=" / " /><Run Text="{Binding AnalysisSummary.RejectedRecordCount}" /></TextBlock></StackPanel>
                        <StackPanel Margin="0,0,12,8"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="BUY / SELL FILLS" /><TextBlock Style="{StaticResource PtjSectionTitleTextStyle}"><Run Text="{Binding AnalysisSummary.UniqueBuyFillCount}" /><Run Text=" / " /><Run Text="{Binding AnalysisSummary.UniqueSellFillCount}" /></TextBlock></StackPanel>
                        <StackPanel Margin="0,0,12,8"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="TRADE CANDIDATES" /><TextBlock Style="{StaticResource PtjSectionTitleTextStyle}" Text="{Binding AnalysisSummary.CandidateCount}" /></StackPanel>
                        <StackPanel Margin="0,0,0,8"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="INSTRUMENTS" /><TextBlock Style="{StaticResource PtjSectionTitleTextStyle}"><Run Text="{Binding AnalysisSummary.ExistingInstrumentCount}" /><Run Text=" existing · " /><Run Text="{Binding AnalysisSummary.ProposedInstrumentCount}" /><Run Text=" new" /></TextBlock></StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0">
                <Border.Style>
                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource PtjCardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding HasAnalysis}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Style="{StaticResource PtjSectionTitleTextStyle}" Text="Instrument resolution" />
                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Instruments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,6,0,6" Padding="12"
                                        Background="{DynamicResource PtjSurfaceElevatedBrush}"
                                        CornerRadius="{StaticResource PtjCornerRadiusSm}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource PtjSectionTitleTextStyle}" Text="{Binding CanonicalSymbol}" />
                                            <TextBlock Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center"
                                                       Style="{StaticResource PtjSecondaryTextStyle}" Text="{Binding SourceSymbols}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                       Style="{StaticResource PtjBodyTextStyle}" FontWeight="SemiBold" Text="{Binding StatusText}" />
                                        </Grid>
                                        <UniformGrid Margin="0,12,0,0" Columns="3">
                                            <StackPanel Margin="0,0,12,8"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="DISPLAY NAME" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding DisplayName}" TextWrapping="Wrap" /></StackPanel>
                                            <StackPanel Margin="0,0,12,8"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="ASSET CLASS" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding AssetClass}" /></StackPanel>
                                            <StackPanel Margin="0,0,0,8"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="EXCHANGE" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding Exchange}" /></StackPanel>
                                            <StackPanel Margin="0,0,12,0"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="CURRENCY" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding Currency}" /></StackPanel>
                                            <StackPanel Margin="0,0,12,0"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="TICK SIZE" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding TickSize}" /></StackPanel>
                                            <StackPanel><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="TICK VALUE" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding TickValue}" /></StackPanel>
                                        </UniformGrid>
                                        <TextBlock Margin="0,12,0,0"
                                                   Text="Will be created only when the import is confirmed."
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PtjBodyTextStyle}">
                                                    <Setter Property="Foreground" Value="{DynamicResource PtjWarningBrush}" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding CreationNotice}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0">
                <Border.Style>
                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource PtjCardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding HasPreview}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Style="{StaticResource PtjSectionTitleTextStyle}" Text="Preview summary" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource PtjDetailLabelTextStyle}" Text="File" /><TextBlock Grid.Column="1" Style="{StaticResource PtjDetailValueTextStyle}" Text="{Binding PreviewSummary.FileName}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource PtjDetailLabelTextStyle}" Text="Account" /><TextBlock Grid.Column="3" Style="{StaticResource PtjDetailValueTextStyle}" Text="{Binding PreviewSummary.AccountName}" />
                        <TextBlock Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource PtjDetailLabelTextStyle}" Text="Time policy" /><TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,0,0" Style="{StaticResource PtjDetailValueTextStyle}"><Run Text="Source: Europe/Sofia · Canonical: UTC · Preview: America/New_York" /></TextBlock>
                        <TextBlock Grid.Row="2" Margin="0,8,0,0" Style="{StaticResource PtjDetailLabelTextStyle}" Text="Period start" /><TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource PtjDetailValueTextStyle}" Text="{Binding PreviewSummary.PeriodStartNewYork, StringFormat={}{0:yyyy-MM-dd HH:mm:ss zzz}}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,8,0,0" Style="{StaticResource PtjDetailLabelTextStyle}" Text="Period end" /><TextBlock Grid.Row="2" Grid.Column="3" Margin="0,8,0,0" Style="{StaticResource PtjDetailValueTextStyle}" Text="{Binding PreviewSummary.PeriodEndNewYork, StringFormat={}{0:yyyy-MM-dd HH:mm:ss zzz}}" />
                        <TextBlock Grid.Row="3" Margin="0,8,0,0" Style="{StaticResource PtjDetailLabelTextStyle}" Text="Diagnostics" /><TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,0,0" Style="{StaticResource PtjDetailValueTextStyle}"><Run Text="{Binding PreviewSummary.WarningCount}" /><Run Text=" warnings · " /><Run Text="{Binding PreviewSummary.ErrorCount}" /><Run Text=" errors" /></TextBlock>
                    </Grid>
                    <TextBlock Margin="0,14,0,0" Foreground="{DynamicResource PtjWarningBrush}"
                               Style="{StaticResource PtjBodyTextStyle}"
                               Text="Read-only preview. Final import is unavailable until commission and fee policy is defined."
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0">
                <Border.Style>
                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource PtjCardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding HasPreview}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Style="{StaticResource PtjSectionTitleTextStyle}" Text="Trade candidates" />
                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Trades}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,5,0,5" Padding="12" Background="{DynamicResource PtjSurfaceElevatedBrush}" CornerRadius="{StaticResource PtjCornerRadiusSm}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.55*" /><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1.7*" /><ColumnDefinition Width="1.7*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <StackPanel Margin="0,0,10,10"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="CANDIDATE" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding CandidateIndex}" /></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,10,10"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="BROKER → CANONICAL" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" FontWeight="SemiBold" Text="{Binding Symbols}" /></StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,10,10"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="ACCOUNT" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding AccountName}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                        <StackPanel Grid.Column="3" Margin="0,0,10,10"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="DIRECTION" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding Direction}" /></StackPanel>
                                        <StackPanel Grid.Column="4" Margin="0,0,10,10"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="OPENED · NEW YORK" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding OpenedAt}" /></StackPanel>
                                        <StackPanel Grid.Column="5" Margin="0,0,0,10"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="CLOSED · NEW YORK" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding ClosedAt}" /></StackPanel>
                                        <StackPanel Grid.Row="1" Margin="0,0,10,0"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="EXECUTIONS" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding ExecutionCount}" /></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,0"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="OPENING QUANTITY" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding OpeningQuantity}" /></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,10,0"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="WEIGHTED AVG ENTRY" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding AverageEntry}" /></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,10,0"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="WEIGHTED AVG EXIT" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding AverageExit}" /></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,10,0"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="SOURCE P&amp;L" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding SourcePnL}" /></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="5"><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="INSTRUMENT RESOLUTION" /><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding Resolution}" /></StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0">
                <Border.Style>
                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource PtjCardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding HasAnalysis}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Style="{StaticResource PtjSectionTitleTextStyle}" Text="Diagnostics" />
                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Diagnostics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5,0,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="90" /><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="{Binding Stage}" />
                                    <TextBlock Grid.Column="1" Foreground="{DynamicResource PtjWarningBrush}" Style="{StaticResource PtjCaptionTextStyle}" Text="{Binding Severity}" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource PtjCaptionTextStyle}" Text="{Binding Code}" TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="3"><TextBlock Style="{StaticResource PtjBodyTextStyle}" Text="{Binding Message}" TextWrapping="Wrap" /><TextBlock Style="{StaticResource PtjCaptionTextStyle}" Text="{Binding Context}" /></StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
