<UserControl x:Class="PersonalTradingJournal.Desktop.Views.Import.TopstepReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Margin="0,16,0,0" Style="{StaticResource PtjCardStyle}">
        <StackPanel>
            <TextBlock Style="{StaticResource PtjSectionTitleTextStyle}" Text="TopstepX Trade candidates" TextWrapping="Wrap" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource PtjBodyTextStyle}" Text="{Binding TopstepPreview.DestinationAccount.Name, StringFormat=Reviewed account: {0}}" TextWrapping="Wrap" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource PtjBodyTextStyle}" Text="{Binding TopstepTotals}" TextWrapping="Wrap" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource PtjCaptionTextStyle}" Text="Reviewed TopstepX USD schema: PnL is Gross; Fees and Commissions are separate row totals. Net = Gross − Fees − Commissions. No fee schedule is substituted. Entry/exit below use UTC; broker TradeDay remains source evidence." TextWrapping="Wrap" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource PtjBodyTextStyle}" Text="{Binding TopstepPreview.State}" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource PtjCaptionTextStyle}" Text="TopstepX Trades rows are imported individually." TextWrapping="Wrap" />
            <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding TopstepCandidates}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,6,0,6" Padding="12" Background="{DynamicResource PtjSurfaceElevatedBrush}" CornerRadius="{StaticResource PtjCornerRadiusSm}">
                            <StackPanel>
                                <TextBlock Text="{Binding Identity}" TextWrapping="Wrap" Style="{StaticResource PtjBodyTextStyle}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Quantity}" TextWrapping="Wrap" Style="{StaticResource PtjBodyTextStyle}" />
                                <TextBlock Text="{Binding Times}" TextWrapping="Wrap" Style="{StaticResource PtjCaptionTextStyle}" />
                                <TextBlock Text="{Binding Prices}" TextWrapping="Wrap" Style="{StaticResource PtjBodyTextStyle}" />
                                <TextBlock Text="{Binding Economics}" TextWrapping="Wrap" Style="{StaticResource PtjBodyTextStyle}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
