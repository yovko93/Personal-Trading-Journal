<UserControl x:Class="PersonalTradingJournal.Desktop.Views.Journals.JournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dashboard="clr-namespace:PersonalTradingJournal.Desktop.Views.Dashboard"
             xmlns:journals="clr-namespace:PersonalTradingJournal.Desktop.Views.Journals"
             Background="{DynamicResource PtjBackgroundBrush}"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Dashboard/DashboardCalendarResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVisibility" />
            <Style x:Key="JournalCalendarDay" TargetType="CalendarDayButton" BasedOn="{StaticResource RangeCalendarDay}">
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Tag" Value="{x:Static dashboard:RangeDay.Single}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="JournalCalendar" TargetType="Calendar" BasedOn="{StaticResource RangeCalendar}">
                <Setter Property="CalendarDayButtonStyle" Value="{StaticResource JournalCalendarDay}" />
            </Style>
            <Style x:Key="JournalDatePicker" TargetType="DatePicker">
                <Setter Property="CalendarStyle" Value="{StaticResource JournalCalendar}" />
                <Setter Property="FontFamily" Value="{StaticResource PtjFontFamily}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DatePicker">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox" Style="{DynamicResource PtjTextBoxStyle}"
                                                   AutomationProperties.Name="Journal date in New York" />
                                <Button x:Name="PART_Button" Grid.Column="1" Content="▾" Margin="4,0,0,0"
                                        Style="{DynamicResource PtjSecondaryButtonStyle}" Padding="4"
                                        AutomationProperties.Name="Open journal date calendar" ToolTip="Choose date (Alt+Down)" />
                                <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    </UserControl.InputBindings>
    <ScrollViewer x:Name="JournalScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource PtjScrollBarStyle}" /></ScrollViewer.Resources>
        <Grid Margin="0,0,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <WrapPanel x:Name="ScopeControls">
                <StackPanel Width="220" Margin="0,0,16,12">
                    <Label Content="_Date (New York)" Target="{Binding ElementName=JournalDate}" Padding="0,0,0,6"
                           Foreground="{DynamicResource PtjTextPrimaryBrush}" />
                    <DatePicker x:Name="JournalDate" Style="{StaticResource JournalDatePicker}"
                                IsEnabled="{Binding CanChangeScope}" SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                SelectedDateFormat="Short" DateValidationError="OnDateValidationError"
                                SelectedDateChanged="OnDateChanged" AutomationProperties.Name="Journal date in New York"
                                AutomationProperties.HelpText="Explicit New York calendar date. Empty trading days are supported." />
                </StackPanel>
                <StackPanel Width="280" Margin="0,0,0,12">
                    <Label Content="_Account scope" Target="{Binding ElementName=JournalAccount}" Padding="0,0,0,6"
                           Foreground="{DynamicResource PtjTextPrimaryBrush}" />
                    <ComboBox x:Name="JournalAccount" Style="{DynamicResource PtjComboBoxStyle}"
                              ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                              DisplayMemberPath="Name" IsEnabled="{Binding CanChangeScope}"
                              AutomationProperties.Name="Journal Account scope"
                              AutomationProperties.HelpText="All accounts is a separate journal, not a combination of Account journals." />
                </StackPanel>
            </WrapPanel>
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock x:Name="JournalStatus" Text="{Binding StatusText}" TextWrapping="Wrap"
                           Style="{DynamicResource PtjFormLabelTextStyle}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding ScopeMessage}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Style="{DynamicResource PtjSecondaryTextStyle}" />
                <journals:JournalHistoryView DataContext="{Binding History}" Margin="0,12,0,0" />
                <ProgressBar Height="3" Margin="0,8,0,0" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                             Foreground="{DynamicResource PtjAccentBrush}" AutomationProperties.Name="Journal operation in progress" />
            </StackPanel>
            <Border Grid.Row="2" Style="{DynamicResource PtjCardStyle}">
                <StackPanel>
                    <Label Content="Journal _text (optional)" Target="{Binding ElementName=JournalText}" Padding="0,0,0,8"
                           Foreground="{DynamicResource PtjTextPrimaryBrush}" />
                    <TextBox x:Name="JournalText" Style="{DynamicResource PtjTextBoxStyle}"
                             Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanReadContent}" IsReadOnly="{Binding IsReadOnly}" AcceptsReturn="True" AcceptsTab="False"
                             TextWrapping="Wrap" VerticalContentAlignment="Stretch" MinHeight="300" Height="360"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Daily journal text"
                             AutomationProperties.HelpText="Plain text. Ctrl+S saves. Tab moves to the next control. Unsaved edits are protected when changing scope or page." />
                    <TextBlock Text="{Binding CharacterCountText}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Style="{DynamicResource PtjCaptionTextStyle}" />
                </StackPanel>
            </Border>
            <Border Grid.Row="3" Margin="0,16,0,0" Style="{DynamicResource PtjCardStyle}">
                <StackPanel>
                    <TextBlock Text="Daily Review" Style="{DynamicResource PtjSectionTitleTextStyle}" />
                    <TextBlock Text="Completed review. Reopen to make changes." Margin="0,8,0,0" TextWrapping="Wrap"
                               Style="{DynamicResource PtjSecondaryTextStyle}"
                               Visibility="{Binding IsCompleted, Converter={StaticResource BoolVisibility}}" />
                    <Label Content="_What went well?" Target="{Binding ElementName=WentWellAnswer}" Margin="0,12,0,6" Padding="0"
                           Foreground="{DynamicResource PtjTextPrimaryBrush}" />
                    <TextBox x:Name="WentWellAnswer" Style="{DynamicResource PtjTextBoxStyle}"
                             Text="{Binding WentWell, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanReadContent}" IsReadOnly="{Binding IsReadOnly}"
                             AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" MinHeight="90" Height="110"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="What went well?"
                             AutomationProperties.HelpText="Required to complete. Partial answers may be saved as a draft. Tab moves to the next control." />
                    <Label Content="What _needs improvement?" Target="{Binding ElementName=NeedsImprovementAnswer}" Margin="0,16,0,6" Padding="0"
                           Foreground="{DynamicResource PtjTextPrimaryBrush}" />
                    <TextBox x:Name="NeedsImprovementAnswer" Style="{DynamicResource PtjTextBoxStyle}"
                             Text="{Binding NeedsImprovement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanReadContent}" IsReadOnly="{Binding IsReadOnly}"
                             AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" MinHeight="90" Height="110"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="What needs improvement?"
                             AutomationProperties.HelpText="Required to complete. Partial answers may be saved as a draft. Tab moves to the next control." />
                    <Label Content="What will I _do differently next trading day?" Target="{Binding ElementName=NextTradingDayAnswer}" Margin="0,16,0,6" Padding="0"
                           Foreground="{DynamicResource PtjTextPrimaryBrush}" />
                    <TextBox x:Name="NextTradingDayAnswer" Style="{DynamicResource PtjTextBoxStyle}"
                             Text="{Binding NextTradingDay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanReadContent}" IsReadOnly="{Binding IsReadOnly}"
                             AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" MinHeight="90" Height="110"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="What will I do differently next trading day?"
                             AutomationProperties.HelpText="Required to complete. Partial answers may be saved as a draft. Tab moves to the next control." />
                </StackPanel>
            </Border>
            <TextBlock x:Name="JournalError" Grid.Row="4" Text="{Binding ErrorMessage}" Margin="0,12,0,0"
                       Style="{DynamicResource PtjFormErrorTextStyle}" AutomationProperties.LiveSetting="Assertive" />
            <WrapPanel Grid.Row="5" Margin="0,12,0,0">
                <Button x:Name="SaveJournal" Content="_Save draft" Command="{Binding SaveCommand}" Margin="0,0,8,8"
                        Visibility="{Binding IsDraft, Converter={StaticResource BoolVisibility}}"
                        Style="{DynamicResource PtjPrimaryButtonStyle}" AutomationProperties.Name="Save journal draft" ToolTip="Save journal draft (Ctrl+S)" />
                <Button x:Name="CompleteJournalReview" Content="_Complete review" Command="{Binding CompleteReviewCommand}" Margin="0,0,8,8"
                        Visibility="{Binding IsDraft, Converter={StaticResource BoolVisibility}}"
                        Style="{DynamicResource PtjSecondaryButtonStyle}" AutomationProperties.Name="Complete daily review"
                        ToolTip="Save and complete this review. All three answers require meaningful text." />
                <Button x:Name="ReopenJournalReview" Content="_Reopen review" Command="{Binding ReopenReviewCommand}" Margin="0,0,8,8"
                        Visibility="{Binding IsCompleted, Converter={StaticResource BoolVisibility}}"
                        Style="{DynamicResource PtjPrimaryButtonStyle}" AutomationProperties.Name="Reopen completed daily review"
                        ToolTip="Create a draft revision before editing this completed review." />
                <Button x:Name="ReloadJournal" Content="_Reload latest" Command="{Binding ReloadCommand}" Margin="0,0,8,8"
                        Style="{DynamicResource PtjSecondaryButtonStyle}" AutomationProperties.Name="Reload latest journal"
                        ToolTip="Read the latest revision. Discarding unsaved text requires confirmation." />
                <Button x:Name="CancelJournalOperation" Content="Cancel operation" Command="{Binding CancelOperationCommand}" Margin="0,0,0,8"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"
                        Style="{DynamicResource PtjSecondaryButtonStyle}" AutomationProperties.Name="Cancel journal operation" />
            </WrapPanel>
            <journals:JournalTradeContextView Grid.Row="6" Margin="0,16,0,0" DataContext="{Binding TradeContext}" />
        </Grid>
    </ScrollViewer>
</UserControl>
