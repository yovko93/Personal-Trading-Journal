<UserControl x:Class="PersonalTradingJournal.Desktop.Views.Journals.JournalReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontSize="16">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="JournalPresentationResources.xaml" /></ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style x:Key="SnapshotText" TargetType="TextBox" BasedOn="{StaticResource JournalTextBox}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="0,6,0,12" />
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
                <StackPanel x:Name="OpenedReview" Visibility="{Binding HasSelectedEntry, Converter={StaticResource BoolVisibility}}">
                <Grid Margin="0,12,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SelectedEntry.Description}" TextWrapping="Wrap" VerticalAlignment="Center"
                               Style="{DynamicResource JournalLabel}" />
                    <Button x:Name="CloseOpenedReview" Grid.Column="1" Content="Close _review" Command="{Binding CloseReviewCommand}"
                            Margin="8,0,0,0" VerticalAlignment="Top" Style="{DynamicResource JournalCloseButton}"
                            AutomationProperties.Name="Close opened review and its revisions"
                            ToolTip="Collapse revisions and return to this history page without changing your date, Account or editor." />
                </Grid>
                <Button Content="Open in editor" Command="{Binding OpenInEditorCommand}" HorizontalAlignment="Left"
                        Style="{DynamicResource JournalButton}" Margin="0,0,0,8"
                        ToolTip="Select this review's exact date and Account for editing or deletion. Unsaved editor changes remain protected." />
                <TextBlock Text="{Binding RevisionStatusText}" TextWrapping="Wrap" Style="{DynamicResource JournalBody}"
                           AutomationProperties.LiveSetting="Polite" />
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Previous revisions" Command="{Binding PreviousRevisionsCommand}" Margin="0,0,8,8"
                            Style="{DynamicResource JournalButton}" />
                    <Button Content="Next revisions" Command="{Binding NextRevisionsCommand}" Margin="0,0,8,8"
                            Style="{DynamicResource JournalButton}" />
                    <TextBlock Text="{Binding RevisionPageText}" Style="{DynamicResource JournalCaption}" VerticalAlignment="Center" />
                </WrapPanel>
                    <ItemsControl x:Name="HistoryRevisions" ItemsSource="{Binding Revisions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StateText}" TextWrapping="Wrap" Style="{DynamicResource JournalBody}" />
                                        <TextBlock Text="{Binding SavedAtText}" TextWrapping="Wrap" Style="{DynamicResource JournalCaption}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="View revision" Style="{DynamicResource JournalButton}"
                                            Command="{Binding DataContext.ViewRevisionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding ViewAccessibleName}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                <StackPanel Visibility="{Binding HasRevisionView, Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0">
                    <Button x:Name="CloseRevisionView" Content="_Close view" Command="{Binding CloseViewCommand}"
                            HorizontalAlignment="Left" Margin="0,0,0,8" Style="{DynamicResource JournalCloseButton}"
                            AutomationProperties.Name="Close read-only revision view"
                            ToolTip="Return to the selected review. Viewing and closing never saves or restores a revision." />
                    <TextBlock Text="{Binding SnapshotStatusText}" TextWrapping="Wrap" Style="{DynamicResource JournalBody}"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <StackPanel Visibility="{Binding HasSnapshot, Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0" MaxWidth="760">
                    <TextBlock Text="{Binding SnapshotDescription}" TextWrapping="Wrap" Style="{DynamicResource JournalLabel}" />
                    <TextBlock Text="Journal text (read-only)" Style="{DynamicResource JournalBody}" />
                    <TextBox x:Name="RevisionText" Text="{Binding Snapshot.Text, Mode=OneWay}" Style="{StaticResource SnapshotText}"
                             AutomationProperties.Name="Revision journal text, read-only" />
                    <TextBlock Text="What went well?" Style="{DynamicResource JournalBody}" />
                    <TextBox x:Name="RevisionWentWell" Text="{Binding Snapshot.Review.WentWell, Mode=OneWay}" Style="{StaticResource SnapshotText}"
                             AutomationProperties.Name="Revision what went well, read-only" />
                    <TextBlock Text="What needs improvement?" Style="{DynamicResource JournalBody}" />
                    <TextBox x:Name="RevisionNeedsImprovement" Text="{Binding Snapshot.Review.NeedsImprovement, Mode=OneWay}" Style="{StaticResource SnapshotText}"
                             AutomationProperties.Name="Revision what needs improvement, read-only" />
                    <TextBlock Text="What will I do differently next trading day?" Style="{DynamicResource JournalBody}" />
                    <TextBox x:Name="RevisionNextTradingDay" Text="{Binding Snapshot.Review.NextTradingDay, Mode=OneWay}" Style="{StaticResource SnapshotText}"
                             AutomationProperties.Name="Revision next trading day, read-only" />
                </StackPanel>
                </StackPanel>
</UserControl>
