<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Journal-only typography: do not enlarge unrelated Trades or Calendar controls. -->
    <Style x:Key="JournalBody" TargetType="TextBlock" BasedOn="{StaticResource PtjBodyTextStyle}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="24" />
    </Style>
    <Style x:Key="JournalHeading" TargetType="TextBlock" BasedOn="{StaticResource JournalBody}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="LineHeight" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="JournalLabel" TargetType="TextBlock" BasedOn="{StaticResource JournalBody}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="JournalCaption" TargetType="TextBlock" BasedOn="{StaticResource JournalBody}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="21" />
        <Setter Property="Foreground" Value="{DynamicResource PtjTextSecondaryBrush}" />
    </Style>
    <Style x:Key="JournalNote" TargetType="TextBlock" BasedOn="{StaticResource JournalBody}">
        <Setter Property="MaxWidth" Value="760" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,4,0,12" />
        <Style.Triggers>
            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="JournalTextBox" TargetType="TextBox" BasedOn="{StaticResource PtjTextBoxStyle}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MaxWidth" Value="760" />
        <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style x:Key="JournalPrimaryButton" TargetType="Button" BasedOn="{StaticResource PtjPrimaryButtonStyle}">
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style x:Key="JournalButton" TargetType="Button" BasedOn="{StaticResource PtjSecondaryButtonStyle}">
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style x:Key="JournalComboBox" TargetType="ComboBox" BasedOn="{StaticResource PtjComboBoxStyle}">
        <Setter Property="FontSize" Value="16" />
    </Style>
    <!-- Closing a read-only view is red outlined; permanent deletion is solid danger. -->
    <Style x:Key="JournalCloseButton" TargetType="Button" BasedOn="{StaticResource JournalButton}">
        <Setter Property="Foreground" Value="{DynamicResource PtjDangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PtjDangerBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PtjDangerSurfaceBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="JournalDeleteButton" TargetType="Button" BasedOn="{StaticResource PtjDangerButtonStyle}">
        <Setter Property="FontSize" Value="16" />
    </Style>
</ResourceDictionary>
