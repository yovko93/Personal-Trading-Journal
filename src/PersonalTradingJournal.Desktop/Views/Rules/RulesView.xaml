<UserControl x:Class="PersonalTradingJournal.Desktop.Views.Rules.RulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:validation="clr-namespace:PersonalTradingJournal.Desktop.Validation"
             FontSize="16" Background="{DynamicResource PtjBackgroundBrush}" DataContextChanged="OnDataContextChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIf" />
        <Style TargetType="ScrollBar" BasedOn="{StaticResource PtjScrollBarStyle}" />
        <Style x:Key="Body" TargetType="TextBlock" BasedOn="{StaticResource PtjBodyTextStyle}">
            <Setter Property="FontSize" Value="16" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="LineHeight" Value="24" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontSize" Value="21" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PtjAccentBrush}" /><Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
            <Setter Property="Margin" Value="0,12,0,6" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource PtjSecondaryButtonStyle}"><Setter Property="Margin" Value="0,0,8,8" /></Style>
    </UserControl.Resources>
    <UserControl.InputBindings><KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" /></UserControl.InputBindings>
    <ScrollViewer x:Name="RulesScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" PreviewMouseWheel="OnMouseWheel" AutomationProperties.Name="Rule management content">
        <StackPanel Margin="0,0,12,12">
            <WrapPanel>
                <Button x:Name="CreateRule" Content="Create rule" Command="{Binding CreateCommand}" Style="{StaticResource PtjPlaybookCreateButtonStyle}" VerticalAlignment="Bottom" Margin="0,0,8,8" AutomationProperties.Name="Create Trading Rule" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource PtjPlaybookRefreshButtonStyle}" VerticalAlignment="Bottom" Margin="0,0,8,8" AutomationProperties.Name="Refresh Rules" />
            </WrapPanel>
            <WrapPanel>
                <TextBlock Text="{Binding PageLabel}" Style="{StaticResource Body}" Margin="0,4,12,8" />
                <Button Content="Previous rules" Command="{Binding PreviousCommand}" AutomationProperties.Name="Previous Rules page" />
                <Button Content="Next rules" Command="{Binding NextCommand}" AutomationProperties.Name="Next Rules page" />
            </WrapPanel>
            <Border Margin="0,4,0,12" Visibility="{Binding HasMessage, Converter={StaticResource VisibleIf}}">
                <StackPanel>
                    <TextBlock x:Name="Status" Text="{Binding Message}" Style="{StaticResource Body}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Rule operation status" />
                    <Button Content="Cancel operation" Command="{Binding CancelOperationCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource VisibleIf}}" AutomationProperties.Name="Cancel Rule loading or saving" />
                </StackPanel>
            </Border>
            <TextBlock Text="No rules yet. Create a trading principle to get started." Style="{StaticResource Body}" Visibility="{Binding ShowEmpty, Converter={StaticResource VisibleIf}}" />
            <ItemsControl x:Name="RuleRows" ItemsSource="{Binding Rules}" Margin="0,8,0,12">
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Border BorderBrush="{DynamicResource PtjBorderBrush}" BorderThickness="0,0,0,1" Padding="12,8" Background="{DynamicResource PtjSurfaceBrush}">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Heading}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding Statement}" Style="{StaticResource Body}" MaxHeight="72" TextTrimming="CharacterEllipsis" ToolTip="{Binding Statement}" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Edit" Command="{Binding DataContext.EditRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat=Edit rule {0}}" />
                                <Button Content="Delete" Style="{StaticResource PtjDangerButtonStyle}" Margin="0,0,8,8" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat=Delete rule {0}}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel x:Name="Editor" Visibility="{Binding IsEditing, Converter={StaticResource VisibleIf}}" IsEnabled="{Binding CanEdit}">
                <TextBlock Text="Rule editor" Style="{StaticResource Heading}" />
                <TextBlock Text="Write a general trading principle. All three fields are required." Style="{StaticResource Body}" Margin="0,0,0,12" />
                <CheckBox Content="Enable typed maximum closed-loss check" IsChecked="{Binding Automatic}" Foreground="{DynamicResource PtjTextPrimaryBrush}" AutomationProperties.Name="Enable typed loss criterion"><CheckBox.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></CheckBox.ContentTemplate></CheckBox>
                <WrapPanel Visibility="{Binding Automatic, Converter={StaticResource VisibleIf}}">
                    <StackPanel Width="260" Margin="0,8,12,12">
                        <Label Content="Check metric" Target="{Binding ElementName=CheckCapability}" Foreground="{DynamicResource PtjTextPrimaryBrush}" />
                        <ComboBox x:Name="CheckCapability" ItemsSource="{Binding Capabilities}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Capability}" Style="{StaticResource PtjComboBoxStyle}" AutomationProperties.Name="Optional check metric" />
                    </StackPanel>
                    <StackPanel Width="260" Margin="0,8,12,12">
                        <Label Content="P&amp;L basis" Target="{Binding ElementName=CheckBasis}" Foreground="{DynamicResource PtjTextPrimaryBrush}" />
                        <ComboBox x:Name="CheckBasis" ItemsSource="{Binding Bases}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Basis}" Style="{StaticResource PtjComboBoxStyle}" AutomationProperties.Name="Typed check Gross or strict Net basis" />
                    </StackPanel>
                    <StackPanel Width="180" Margin="0,8,12,12">
                        <Label Content="Maximum loss" Target="{Binding ElementName=CheckLimit}" Foreground="{DynamicResource PtjTextPrimaryBrush}" />
                        <TextBox x:Name="CheckLimit" Text="{Binding LossLimit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PtjTextBoxStyle}" AutomationProperties.Name="Maximum closed loss, nonnegative" />
                    </StackPanel>
                    <StackPanel Width="120" Margin="0,8,12,12">
                        <Label Content="Currency" Target="{Binding ElementName=CheckCurrency}" Foreground="{DynamicResource PtjTextPrimaryBrush}" />
                        <TextBox x:Name="CheckCurrency" Text="{Binding CheckCurrency, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PtjTextBoxStyle}" AutomationProperties.Name="Criterion currency, three-letter code" />
                    </StackPanel>
                </WrapPanel>
                <Border x:Name="ValidationSummary" Background="{DynamicResource PtjDangerSurfaceBrush}" BorderBrush="{DynamicResource PtjDangerBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,12" Visibility="{Binding HasErrors, Converter={StaticResource VisibleIf}}">
                    <TextBlock Text="Cannot save. Correct each highlighted field. Your entered text is retained." Style="{StaticResource Body}" Foreground="{DynamicResource PtjDangerBrush}" AutomationProperties.LiveSetting="Assertive" />
                </Border>
                <ItemsControl x:Name="EditorFields" ItemsSource="{Binding Fields}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <StackPanel MaxWidth="760" Margin="0,0,0,12">
                            <Label Content="{Binding Label}" Target="{Binding ElementName=FieldText}" Foreground="{DynamicResource PtjAccentBrush}" FontSize="20" FontWeight="SemiBold" />
                            <TextBox x:Name="FieldText" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" MinWidth="0" MinHeight="44" FontSize="16" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     validation:FormValidation.IsInvalid="{Binding IsInvalid}" AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Help}" AutomationProperties.ItemStatus="{Binding Error}" AutomationProperties.IsRequiredForForm="True">
                                <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource PtjTextBoxStyle}">
                                    <Setter Property="Height" Value="100" /><Setter Property="AcceptsReturn" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Label}" Value="Rule name"><Setter Property="Height" Value="44" /><Setter Property="AcceptsReturn" Value="False" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsInvalid}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource PtjDangerBrush}" /><Setter Property="BorderThickness" Value="2" /></DataTrigger>
                                    </Style.Triggers>
                                </Style></TextBox.Style>
                            </TextBox>
                            <TextBlock Text="{Binding Error}" Style="{StaticResource Body}" Foreground="{DynamicResource PtjDangerBrush}" Visibility="{Binding IsInvalid, Converter={StaticResource VisibleIf}}" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel>
                    <Button x:Name="SaveRule" Content="Save rule" Command="{Binding SaveCommand}" Style="{StaticResource PtjJournalSaveButtonStyle}" Margin="0,0,8,8" AutomationProperties.Name="Save rule" />
                    <Button Content="Cancel editing" Command="{Binding CancelEditCommand}" AutomationProperties.Name="Cancel Rule editing with unsaved-change protection" />
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
