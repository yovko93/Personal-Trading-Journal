<UserControl x:Class="PersonalTradingJournal.Desktop.Views.Rules.RulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PersonalTradingJournal.Desktop.Views.Rules"
             xmlns:validation="clr-namespace:PersonalTradingJournal.Desktop.Validation"
             FontSize="16" Background="{DynamicResource PtjBackgroundBrush}" DataContextChanged="OnDataContextChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIf" />
        <Style TargetType="ScrollBar" BasedOn="{StaticResource PtjScrollBarStyle}" />
        <Style x:Key="Body" TargetType="TextBlock" BasedOn="{StaticResource PtjBodyTextStyle}">
            <Setter Property="FontSize" Value="16" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="LineHeight" Value="24" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontSize" Value="21" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PtjAccentBrush}" /><Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
            <Setter Property="Margin" Value="0,12,0,6" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource PtjSecondaryButtonStyle}"><Setter Property="Margin" Value="0,0,8,8" /></Style>
        <local:RuleInlineEditorConverter x:Key="InlineEditor" />
        <DataTemplate x:Key="RuleEditorTemplate">
            <StackPanel x:Name="Editor" IsEnabled="{Binding CanEdit}" Loaded="OnEditorLoaded">
                <Border x:Name="ValidationSummary" Background="{DynamicResource PtjDangerSurfaceBrush}" BorderBrush="{DynamicResource PtjDangerBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,12" Visibility="{Binding HasErrors, Converter={StaticResource VisibleIf}}">
                    <TextBlock Text="Cannot save. Correct each highlighted field. Your entered text is retained." Style="{StaticResource Body}" Foreground="{DynamicResource PtjDangerBrush}" AutomationProperties.LiveSetting="Assertive" />
                </Border>
                <ItemsControl x:Name="EditorFields" ItemsSource="{Binding Fields}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <StackPanel MaxWidth="760" Margin="0,0,0,12">
                            <Label Content="{Binding Label}" Target="{Binding ElementName=FieldText}" Foreground="{DynamicResource PtjAccentBrush}" FontSize="20" FontWeight="SemiBold" />
                            <TextBox x:Name="FieldText" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" MinWidth="0" MinHeight="44" FontSize="16" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     validation:FormValidation.IsInvalid="{Binding IsInvalid}" AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Help}" AutomationProperties.ItemStatus="{Binding Error}" AutomationProperties.IsRequiredForForm="{Binding IsRequired}">
                                <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource PtjTextBoxStyle}">
                                    <Setter Property="Height" Value="100" /><Setter Property="AcceptsReturn" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInvalid}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource PtjDangerBrush}" /><Setter Property="BorderThickness" Value="2" /></DataTrigger>
                                    </Style.Triggers>
                                </Style></TextBox.Style>
                            </TextBox>
                            <TextBlock Text="{Binding Error}" Style="{StaticResource Body}" Foreground="{DynamicResource PtjDangerBrush}" Visibility="{Binding IsInvalid, Converter={StaticResource VisibleIf}}" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>

                <WrapPanel>
                    <Button x:Name="SaveRule" Content="Save rule" Command="{Binding SaveCommand}" Style="{StaticResource PtjJournalSaveButtonStyle}" Margin="0,0,8,8" AutomationProperties.Name="Save rule" />
                    <Button Content="Cancel editing" Command="{Binding CancelEditCommand}" AutomationProperties.Name="Cancel Rule editing with unsaved-change protection" />
                </WrapPanel>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="EditorHostStyle" TargetType="ContentControl">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <Trigger Property="HasContent" Value="True">
                    <Setter Property="ContentTemplate" Value="{StaticResource RuleEditorTemplate}" />
                    <Setter Property="Visibility" Value="Visible" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <UserControl.InputBindings><KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" /></UserControl.InputBindings>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border x:Name="FeedbackBox" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,12,12"
                Visibility="{Binding HasMessage, Converter={StaticResource VisibleIf}}">
            <Border.Style><Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource PtjInformationSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PtjInformationBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding FeedbackKind}" Value="Success"><Setter Property="Background" Value="{DynamicResource PtjSuccessSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource PtjSuccessBrush}" /></DataTrigger>
                    <DataTrigger Binding="{Binding FeedbackKind}" Value="Error"><Setter Property="Background" Value="{DynamicResource PtjDangerSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource PtjDangerBrush}" /></DataTrigger>
                </Style.Triggers>
            </Style></Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding FeedbackHeading}" FontWeight="SemiBold" Style="{StaticResource Body}" Foreground="{Binding BorderBrush, ElementName=FeedbackBox}" />
                <TextBlock x:Name="Status" Text="{Binding Message}" Style="{StaticResource Body}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Rule operation status" />
            </StackPanel>
        </Border>
    <ScrollViewer Grid.Row="1" x:Name="RulesScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" PreviewMouseWheel="OnMouseWheel" AutomationProperties.Name="Rule management content">
        <StackPanel Margin="0,0,12,12">
            <WrapPanel>
                <Button x:Name="CreateRule" Content="Create rule" Command="{Binding CreateCommand}" Style="{StaticResource PtjPlaybookCreateButtonStyle}" VerticalAlignment="Bottom" Margin="0,0,8,8" AutomationProperties.Name="Create Trading Rule" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource PtjPlaybookRefreshButtonStyle}" VerticalAlignment="Bottom" Margin="0,0,8,8" AutomationProperties.Name="Refresh Rules" />
            </WrapPanel>

            <Button Content="Cancel operation" Command="{Binding CancelOperationCommand}" HorizontalAlignment="Left" Visibility="{Binding IsBusy, Converter={StaticResource VisibleIf}}" AutomationProperties.Name="Cancel Rule loading or saving" />
            <TextBlock Text="No rules yet. Create a trading principle to get started." Style="{StaticResource Body}" Visibility="{Binding ShowEmpty, Converter={StaticResource VisibleIf}}" />
            <ContentControl x:Name="CreateEditorHost" Content="{Binding NewRuleEditor}" Style="{StaticResource EditorHostStyle}" Margin="0,8,0,12" />
            <ItemsControl x:Name="RuleRows" ItemsSource="{Binding Rules}" Margin="0,8,0,12">
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Border BorderBrush="{DynamicResource PtjBorderBrush}" BorderThickness="0,0,0,1" Padding="12,8" Background="{DynamicResource PtjSurfaceBrush}">
                        <Grid x:Name="RuleRowLayout">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border x:Name="RuleNumberBadge" MinWidth="32" MinHeight="32" Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}" CornerRadius="100" Padding="6,0" Margin="0,0,12,0" VerticalAlignment="Top"
                                    Background="{DynamicResource PtjSurfaceElevatedBrush}" BorderBrush="{DynamicResource PtjAccentBrush}" BorderThickness="1" Focusable="False" IsHitTestVisible="False">
                                <TextBlock x:Name="RuleMarker" Text="{Binding DisplayNumber}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PtjAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Focusable="False" IsHitTestVisible="False" AutomationProperties.Name="{Binding PositionDescription}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Heading}" Margin="0,0,0,4" />
                                <TextBlock x:Name="RuleCriterion" Text="{Binding Statement}" Style="{StaticResource Body}" MaxHeight="72" TextTrimming="CharacterEllipsis" ToolTip="{Binding Statement}" Visibility="{Binding HasStatement, Converter={StaticResource VisibleIf}}" />
                                <TextBlock Text="{Binding AutomaticCondition}" Style="{StaticResource Body}" Margin="0,6,0,0"
                                           Visibility="{Binding HasAutomaticCondition, Converter={StaticResource VisibleIf}}" AutomationProperties.Name="{Binding AutomaticCondition}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Button Content="Edit" Margin="0,0,8,0" Command="{Binding DataContext.EditRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat=Edit rule {0}}" />
                                <Button Content="Delete" Style="{StaticResource PtjDangerButtonStyle}" Margin="0" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat=Delete rule {0}}" />
                            </StackPanel>
                            <ContentControl x:Name="InlineEditorHost" Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource EditorHostStyle}" Margin="0,12,0,0">
                                <ContentControl.Content>
                                    <MultiBinding Converter="{StaticResource InlineEditor}">
                                        <Binding Path="Id" />
                                        <Binding Path="DataContext.EditingRuleId" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                    </MultiBinding>
                                </ContentControl.Content>
                            </ContentControl>
                        </Grid>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>


        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>
