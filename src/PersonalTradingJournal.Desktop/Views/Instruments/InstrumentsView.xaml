<UserControl x:Class="PersonalTradingJournal.Desktop.Views.Instruments.InstrumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:interactions="clr-namespace:PersonalTradingJournal.Desktop.Interactions"
             xmlns:validation="clr-namespace:PersonalTradingJournal.Desktop.Validation">
    <UserControl.Resources>
        <Style x:Key="InstrumentColumnHeaderStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource PtjCaptionTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="InstrumentCellTextStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource PtjBodyTextStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalContentAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  PanningMode="VerticalOnly">
        <ScrollViewer.Resources>
            <Style TargetType="{x:Type ScrollBar}"
                   BasedOn="{StaticResource PtjScrollBarStyle}" />
        </ScrollViewer.Resources>

        <StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center"
                       Style="{StaticResource PtjSecondaryTextStyle}"
                       Text="Reference instruments used across trades and journal activity."
                       TextWrapping="Wrap" />

            <StackPanel Grid.Column="1"
                        Margin="16,0,0,0"
                        Orientation="Horizontal">
                <Button Command="{Binding RefreshCommand}"
                        Content="Refresh"
                        Style="{StaticResource PtjButtonStyle}" />
                <Button Margin="8,0,0,0"
                        Command="{Binding ShowCreateFormCommand}"
                        Content="Add Instrument"
                        Style="{StaticResource PtjPrimaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <Border Margin="0,16,0,0">
            <Border.Style>
                <Style TargetType="{x:Type Border}"
                       BasedOn="{StaticResource PtjFormSectionStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCreateFormVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <TextBlock Style="{StaticResource PtjFormSectionTitleTextStyle}"
                           Text="Add Instrument" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource PtjSecondaryTextStyle}"
                           Text="Define the instrument identity and its authoritative pricing increments."
                           TextWrapping="Wrap" />

                <Grid Margin="0,16,0,0">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCreating}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                        <TextBlock Margin="0,0,0,6"
                                   Style="{StaticResource PtjFormLabelTextStyle}"
                                   Text="Symbol" />
                        <TextBox validation:FormValidation.IsInvalid="{Binding IsSymbolInvalid}"
                                 Style="{StaticResource PtjTextBoxStyle}"
                                 Text="{Binding Symbol, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,12">
                        <TextBlock Margin="0,0,0,6"
                                   Style="{StaticResource PtjFormLabelTextStyle}"
                                   Text="Display Name" />
                        <TextBox validation:FormValidation.IsInvalid="{Binding IsDisplayNameInvalid}"
                                 Style="{StaticResource PtjTextBoxStyle}"
                                 Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,12">
                        <TextBlock Margin="0,0,0,6"
                                   Style="{StaticResource PtjFormLabelTextStyle}"
                                   Text="Asset Class" />
                        <ComboBox ItemsSource="{Binding AssetClasses}"
                                  SelectedItem="{Binding SelectedAssetClass}"
                                  Style="{StaticResource PtjComboBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,12">
                        <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource PtjFormLabelTextStyle}"
                                       Text="Exchange" />
                            <TextBlock Margin="4,0,0,0"
                                       Style="{StaticResource PtjFormOptionalTextStyle}"
                                       Text="(Optional)" />
                        </StackPanel>
                        <TextBox Style="{StaticResource PtjTextBoxStyle}"
                                 Text="{Binding Exchange, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,12">
                        <TextBlock Margin="0,0,0,6"
                                   Style="{StaticResource PtjFormLabelTextStyle}"
                                   Text="Currency" />
                        <TextBox validation:FormValidation.IsInvalid="{Binding IsCurrencyInvalid}"
                                 Style="{StaticResource PtjTextBoxStyle}"
                                 Text="{Binding Currency, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,12">
                        <TextBlock Margin="0,0,0,6"
                                   Style="{StaticResource PtjFormLabelTextStyle}"
                                   Text="Tick Size" />
                        <TextBox validation:FormValidation.IsInvalid="{Binding IsTickSizeInvalid}"
                                 Style="{StaticResource PtjTextBoxStyle}"
                                 Text="{Binding TickSizeText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource PtjFormHelperTextStyle}"
                                   Text="The minimum price increment for this instrument." />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Margin="0,0,0,6"
                                   Style="{StaticResource PtjFormLabelTextStyle}"
                                   Text="Tick Value" />
                        <TextBox validation:FormValidation.IsInvalid="{Binding IsTickValueInvalid}"
                                 Style="{StaticResource PtjTextBoxStyle}"
                                 Text="{Binding TickValueText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource PtjFormHelperTextStyle}"
                                   Text="Monetary value of one minimum price increment. Point Value is derived automatically." />
                    </StackPanel>
                </Grid>

                <TextBlock Margin="0,12,0,0"
                           Text="{Binding CreateErrorMessage}">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}"
                               BasedOn="{StaticResource PtjFormErrorTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCreateError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Margin="0,12,0,0"
                           Text="Creating instrument...">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}"
                               BasedOn="{StaticResource PtjFormHelperTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCreating}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Margin="0,16,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button Command="{Binding CancelCreateCommand}"
                            Content="Cancel"
                            Style="{StaticResource PtjSecondaryButtonStyle}" />
                    <Button Margin="8,0,0,0"
                            Command="{Binding CreateInstrumentCommand}"
                            Content="Create Instrument"
                            Style="{StaticResource PtjPrimaryButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Margin="0,16,0,0">
            <Border.Style>
                <Style TargetType="{x:Type Border}" BasedOn="{StaticResource PtjFormSectionStyle}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSelectedInstrument}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsEditFormVisible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PtjFormSectionTitleTextStyle}" Text="{Binding SelectedInstrument.Symbol}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource PtjSecondaryTextStyle}" Text="{Binding SelectedInstrument.DisplayName}" />
                    </StackPanel>
                    <Border Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource PtjStatusBadgeStyle}">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PtjInactiveStatusTextStyle}">
                                    <Setter Property="Text" Value="Inactive" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedInstrument.IsActive}" Value="True">
                                            <Setter Property="Text" Value="Active" />
                                            <Setter Property="Foreground" Value="{DynamicResource PtjSuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource PtjDetailLabelTextStyle}" Text="Symbol" />
                    <TextBlock Grid.Column="1" Style="{StaticResource PtjDetailValueTextStyle}" Text="{Binding SelectedInstrument.Symbol}" />
                    <TextBlock Grid.Column="2" Margin="24,0,0,0" Style="{StaticResource PtjDetailLabelTextStyle}" Text="Display Name" />
                    <TextBlock Grid.Column="3" Style="{StaticResource PtjDetailValueTextStyle}" Text="{Binding SelectedInstrument.DisplayName}" />
                    <TextBlock Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource PtjDetailLabelTextStyle}" Text="Asset Class" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Style="{StaticResource PtjDetailValueTextStyle}" Text="{Binding SelectedInstrument.AssetClass}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Margin="24,10,0,0" Style="{StaticResource PtjDetailLabelTextStyle}" Text="Exchange" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,10,0,0" Style="{StaticResource PtjDetailValueTextStyle}" Text="{Binding SelectedInstrument.Exchange, TargetNullValue=—}" />
                    <TextBlock Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource PtjDetailLabelTextStyle}" Text="Currency" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" Style="{StaticResource PtjDetailValueTextStyle}" Text="{Binding SelectedInstrument.Currency}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Margin="24,10,0,0" Style="{StaticResource PtjDetailLabelTextStyle}" Text="Point Value" />
                    <StackPanel Grid.Row="2" Grid.Column="3" Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource PtjDetailValueTextStyle}" Text="{Binding SelectedInstrument.PointValue, StringFormat={}{0:0.########}}" />
                        <TextBlock Style="{StaticResource PtjFormHelperTextStyle}" Text="Derived from Tick Value / Tick Size" />
                    </StackPanel>
                    <TextBlock Grid.Row="3" Margin="0,10,0,0" Style="{StaticResource PtjDetailLabelTextStyle}" Text="Tick Size" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" Style="{StaticResource PtjDetailValueTextStyle}" Text="{Binding SelectedInstrument.TickSize, StringFormat={}{0:0.########}}" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Margin="24,10,0,0" Style="{StaticResource PtjDetailLabelTextStyle}" Text="Tick Value" />
                    <TextBlock Grid.Row="3" Grid.Column="3" Margin="0,10,0,0" Style="{StaticResource PtjDetailValueTextStyle}" Text="{Binding SelectedInstrument.TickValue, StringFormat={}{0:0.########}}" />
                    <TextBlock Grid.Row="4" Margin="0,10,0,0" Style="{StaticResource PtjDetailLabelTextStyle}" Text="Created" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,10,0,0" Style="{StaticResource PtjDetailValueTextStyle}" Text="{Binding SelectedInstrument.CreatedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm} UTC}" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Margin="24,10,0,0" Style="{StaticResource PtjDetailLabelTextStyle}" Text="Updated" />
                    <TextBlock Grid.Row="4" Grid.Column="3" Margin="0,10,0,0" Style="{StaticResource PtjDetailValueTextStyle}" Text="{Binding SelectedInstrument.UpdatedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm} UTC}" />
                </Grid>

                <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Command="{Binding CloseInstrumentDetailsCommand}" Content="Close" Style="{StaticResource PtjSecondaryButtonStyle}" />
                    <Button Margin="8,0,0,0" Command="{Binding EditInstrumentCommand}" CommandParameter="{Binding SelectedInstrument.Id}"
                            Content="Edit" Style="{StaticResource PtjEntityActionButtonStyle}" />
                    <Button Margin="8,0,0,0" AutomationProperties.Name="More instrument actions"
                            interactions:EntityActionMenu.OpensContextMenu="True" Style="{StaticResource PtjIconButtonStyle}"
                            Tag="{Binding}" ToolTip="More instrument actions">
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}" Style="{StaticResource PtjEntityActionMenuStyle}">
                                <MenuItem Command="{Binding Tag.ActivateInstrumentCommand}" CommandParameter="{Binding Tag.SelectedInstrumentListItem}" Header="Activate">
                                    <MenuItem.Icon><Viewbox><Path Data="{StaticResource PtjIconActivate}" Fill="{x:Null}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}" StrokeLineJoin="Round" StrokeThickness="1.8" /></Viewbox></MenuItem.Icon>
                                    <MenuItem.Style><Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource PtjLifecycleMenuItemStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Tag.SelectedInstrument.IsActive}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></MenuItem.Style>
                                </MenuItem>
                                <MenuItem Command="{Binding Tag.DeactivateInstrumentCommand}" CommandParameter="{Binding Tag.SelectedInstrumentListItem}" Header="Deactivate">
                                    <MenuItem.Icon><Viewbox><Path Data="{StaticResource PtjIconDeactivate}" Fill="{x:Null}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}" StrokeLineJoin="Round" StrokeThickness="1.8" /></Viewbox></MenuItem.Icon>
                                    <MenuItem.Style><Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource PtjLifecycleMenuItemStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Tag.SelectedInstrument.IsActive}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></MenuItem.Style>
                                </MenuItem>
                                <Separator Style="{StaticResource PtjEntityActionMenuSeparatorStyle}" />
                                <MenuItem Command="{Binding Tag.DeleteInstrumentCommand}" CommandParameter="{Binding Tag.SelectedInstrument.Id}" Header="Delete" Style="{StaticResource PtjDeleteMenuItemStyle}">
                                    <MenuItem.Icon><Viewbox><Path Data="{StaticResource PtjIconDelete}" Fill="{x:Null}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}" StrokeLineJoin="Round" StrokeThickness="1.8" /></Viewbox></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Viewbox Width="18" Height="18"><Path Data="{StaticResource PtjIconMore}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Stretch="Uniform" /></Viewbox>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Margin="0,16,0,0">
            <Border.Style>
                <Style TargetType="{x:Type Border}" BasedOn="{StaticResource PtjFormSectionStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding IsEditFormVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Style="{StaticResource PtjFormSectionTitleTextStyle}" Text="Edit Instrument" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource PtjSecondaryTextStyle}" Text="Update catalog data for future use without changing historical trade snapshots." TextWrapping="Wrap" />
                <Grid Margin="0,16,0,0">
                    <Grid.Style><Style TargetType="{x:Type Grid}"><Setter Property="IsEnabled" Value="True" /><Style.Triggers><DataTrigger Binding="{Binding IsUpdating}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,8,12">
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource PtjFormLabelTextStyle}" Text="Symbol" />
                        <TextBox validation:FormValidation.IsInvalid="{Binding IsEditSymbolInvalid}" Text="{Binding EditSymbol, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PtjTextBoxStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,12">
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource PtjFormLabelTextStyle}" Text="Display Name" />
                        <TextBox validation:FormValidation.IsInvalid="{Binding IsEditDisplayNameInvalid}" Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PtjTextBoxStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,8,12">
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource PtjFormLabelTextStyle}" Text="Asset Class" />
                        <ComboBox ItemsSource="{Binding AssetClasses}" SelectedItem="{Binding EditSelectedAssetClass}" Style="{StaticResource PtjComboBoxStyle}" />
                        <TextBlock Style="{StaticResource PtjFormHelperTextStyle}" Text="Cannot change after the instrument is used by a trade." />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,12">
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource PtjFormLabelTextStyle}" Text="Exchange (Optional)" />
                        <TextBox Text="{Binding EditExchange, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PtjTextBoxStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,0,8,12">
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource PtjFormLabelTextStyle}" Text="Currency" />
                        <TextBox validation:FormValidation.IsInvalid="{Binding IsEditCurrencyInvalid}" Text="{Binding EditCurrency, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PtjTextBoxStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,12">
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource PtjFormLabelTextStyle}" Text="Point Value" />
                        <TextBlock Style="{StaticResource PtjDetailValueTextStyle}" Text="{Binding EditPointValuePreview, StringFormat={}{0:0.########}, TargetNullValue=—}" />
                        <TextBlock Style="{StaticResource PtjFormHelperTextStyle}" Text="Read-only; derived from Tick Value / Tick Size." />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Margin="0,0,8,0">
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource PtjFormLabelTextStyle}" Text="Tick Size" />
                        <TextBox validation:FormValidation.IsInvalid="{Binding IsEditTickSizeInvalid}" Text="{Binding EditTickSizeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PtjTextBoxStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource PtjFormLabelTextStyle}" Text="Tick Value" />
                        <TextBox validation:FormValidation.IsInvalid="{Binding IsEditTickValueInvalid}" Text="{Binding EditTickValueText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PtjTextBoxStyle}" />
                    </StackPanel>
                </Grid>
                <TextBlock Margin="0,12,0,0" Text="{Binding EditErrorMessage}" Style="{StaticResource PtjFormErrorTextStyle}" />
                <TextBlock Margin="0,12,0,0" Text="Saving changes...">
                    <TextBlock.Style><Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PtjFormHelperTextStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsUpdating}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Command="{Binding CancelEditCommand}" Content="Cancel" Style="{StaticResource PtjSecondaryButtonStyle}" />
                    <Button Margin="8,0,0,0" Command="{Binding SaveChangesCommand}" Content="Save Changes" Style="{StaticResource PtjPrimaryButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Margin="0,12,0,12">
            <TextBlock Text="Loading instruments...">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}"
                           BasedOn="{StaticResource PtjCaptionTextStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="{Binding ErrorMessage}">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}"
                           BasedOn="{StaticResource PtjSecondaryTextStyle}">
                        <Setter Property="Foreground" Value="{DynamicResource PtjWarningBrush}" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="{Binding LifecycleErrorMessage}">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}"
                           BasedOn="{StaticResource PtjSecondaryTextStyle}">
                        <Setter Property="Foreground" Value="{DynamicResource PtjWarningBrush}" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasLifecycleError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding ActionErrorMessage}">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PtjSecondaryTextStyle}">
                        <Setter Property="Foreground" Value="{DynamicResource PtjWarningBrush}" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding HasActionError}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <Grid>
            <Border Padding="24"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top">
                <Border.Style>
                    <Style TargetType="{x:Type Border}"
                           BasedOn="{StaticResource PtjCardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                    <Condition Binding="{Binding HasInstruments}" Value="False" />
                                    <Condition Binding="{Binding HasError}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock HorizontalAlignment="Center"
                           Style="{StaticResource PtjSecondaryTextStyle}"
                           Text="No instruments yet." />
            </Border>

            <Grid>
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasInstruments}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="16,0,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.7*" />
                        <ColumnDefinition Width="1.8*" />
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="0.7*" />
                        <ColumnDefinition Width="0.55*" />
                        <ColumnDefinition Width="0.65*" />
                        <ColumnDefinition Width="0.65*" />
                        <ColumnDefinition Width="0.7*" />
                        <ColumnDefinition Width="0.65*" />
                        <ColumnDefinition Width="224" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Style="{StaticResource InstrumentColumnHeaderStyle}"
                               Text="Symbol" />
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource InstrumentColumnHeaderStyle}"
                               Text="Display Name" />
                    <TextBlock Grid.Column="2"
                               Style="{StaticResource InstrumentColumnHeaderStyle}"
                               Text="Asset Class" />
                    <TextBlock Grid.Column="3"
                               Style="{StaticResource InstrumentColumnHeaderStyle}"
                               Text="Exchange" />
                    <TextBlock Grid.Column="4"
                               Style="{StaticResource InstrumentColumnHeaderStyle}"
                               Text="Currency" />
                    <TextBlock Grid.Column="5"
                               HorizontalAlignment="Right"
                               Style="{StaticResource InstrumentColumnHeaderStyle}"
                               Text="Tick Size" />
                    <TextBlock Grid.Column="6"
                               HorizontalAlignment="Right"
                               Style="{StaticResource InstrumentColumnHeaderStyle}"
                               Text="Tick Value" />
                    <TextBlock Grid.Column="7"
                               HorizontalAlignment="Right"
                               Style="{StaticResource InstrumentColumnHeaderStyle}"
                               Text="Point Value" />
                    <TextBlock Grid.Column="8"
                               HorizontalAlignment="Right"
                               Style="{StaticResource InstrumentColumnHeaderStyle}"
                               Text="Status" />
                    <TextBlock Grid.Column="9"
                               HorizontalAlignment="Right"
                               Style="{StaticResource InstrumentColumnHeaderStyle}"
                               Text="Actions" />
                </Grid>

                <ItemsControl Grid.Row="1"
                              HorizontalContentAlignment="Stretch"
                              ItemsSource="{Binding Instruments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border MinHeight="52"
                                        Margin="0,0,0,8"
                                        Padding="16,12"
                                        Style="{StaticResource PtjCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.7*" />
                                            <ColumnDefinition Width="1.8*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="0.7*" />
                                            <ColumnDefinition Width="0.55*" />
                                            <ColumnDefinition Width="0.65*" />
                                            <ColumnDefinition Width="0.65*" />
                                            <ColumnDefinition Width="0.7*" />
                                            <ColumnDefinition Width="0.65*" />
                                            <ColumnDefinition Width="224" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   FontWeight="SemiBold"
                                                   Style="{StaticResource InstrumentCellTextStyle}"
                                                   Text="{Binding Symbol}" />
                                        <TextBlock Grid.Column="1"
                                                   Style="{StaticResource InstrumentCellTextStyle}"
                                                   Text="{Binding DisplayName}" />
                                        <TextBlock Grid.Column="2"
                                                   Style="{StaticResource InstrumentCellTextStyle}"
                                                   Text="{Binding AssetClass}" />
                                        <TextBlock Grid.Column="3"
                                                   Style="{StaticResource InstrumentCellTextStyle}"
                                                   Text="{Binding Exchange, TargetNullValue=—}" />
                                        <TextBlock Grid.Column="4"
                                                   Style="{StaticResource InstrumentCellTextStyle}"
                                                   Text="{Binding Currency}" />
                                        <TextBlock Grid.Column="5"
                                                   HorizontalAlignment="Right"
                                                   Style="{StaticResource InstrumentCellTextStyle}"
                                                   Text="{Binding TickSize, StringFormat={}{0:0.########}}" />
                                        <TextBlock Grid.Column="6"
                                                   HorizontalAlignment="Right"
                                                   Style="{StaticResource InstrumentCellTextStyle}"
                                                   Text="{Binding TickValue, StringFormat={}{0:0.########}}" />
                                        <TextBlock Grid.Column="7"
                                                   HorizontalAlignment="Right"
                                                   Style="{StaticResource InstrumentCellTextStyle}"
                                                   Text="{Binding PointValue, StringFormat={}{0:0.########}}" />
                                        <TextBlock Grid.Column="8"
                                                   HorizontalAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}"
                                                       BasedOn="{StaticResource PtjCaptionTextStyle}">
                                                    <Setter Property="Text" Value="Inactive" />
                                                    <Setter Property="Foreground" Value="{DynamicResource PtjTextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Text" Value="Active" />
                                                            <Setter Property="Foreground" Value="{DynamicResource PtjSuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <StackPanel Grid.Column="9" Margin="8,0,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                                            <Button Command="{Binding DataContext.ViewInstrumentCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding Id}" Style="{StaticResource PtjEntityActionButtonStyle}" ToolTip="View instrument details">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="14" Height="14"><Path Data="{StaticResource PtjIconView}" Fill="{x:Null}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeLineJoin="Round" StrokeThickness="1.7" /></Viewbox>
                                                    <TextBlock Margin="6,0,0,0" Text="View" />
                                                </StackPanel>
                                            </Button>
                                            <Button Margin="4,0,0,0" Command="{Binding DataContext.EditInstrumentCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding Id}" Style="{StaticResource PtjEntityActionButtonStyle}" ToolTip="Edit instrument">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="14" Height="14"><Path Data="{StaticResource PtjIconEdit}" Fill="{x:Null}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeLineJoin="Round" StrokeThickness="1.7" /></Viewbox>
                                                    <TextBlock Margin="6,0,0,0" Text="Edit" />
                                                </StackPanel>
                                            </Button>
                                            <Button Margin="4,0,0,0" AutomationProperties.Name="More instrument actions"
                                                    interactions:EntityActionMenu.OpensContextMenu="True" Style="{StaticResource PtjIconButtonStyle}"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" ToolTip="More instrument actions">
                                                <Button.ContextMenu>
                                                    <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}" Style="{StaticResource PtjEntityActionMenuStyle}">
                                                        <MenuItem Command="{Binding Tag.ActivateInstrumentCommand}" CommandParameter="{Binding DataContext}" Header="Activate">
                                                            <MenuItem.Icon><Viewbox><Path Data="{StaticResource PtjIconActivate}" Fill="{x:Null}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}" StrokeLineJoin="Round" StrokeThickness="1.8" /></Viewbox></MenuItem.Icon>
                                                            <MenuItem.Style><Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource PtjLifecycleMenuItemStyle}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsActive}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></MenuItem.Style>
                                                        </MenuItem>
                                                        <MenuItem Command="{Binding Tag.DeactivateInstrumentCommand}" CommandParameter="{Binding DataContext}" Header="Deactivate">
                                                            <MenuItem.Icon><Viewbox><Path Data="{StaticResource PtjIconDeactivate}" Fill="{x:Null}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}" StrokeLineJoin="Round" StrokeThickness="1.8" /></Viewbox></MenuItem.Icon>
                                                            <MenuItem.Style><Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource PtjLifecycleMenuItemStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsActive}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></MenuItem.Style>
                                                        </MenuItem>
                                                        <Separator Style="{StaticResource PtjEntityActionMenuSeparatorStyle}" />
                                                        <MenuItem Command="{Binding Tag.DeleteInstrumentCommand}" CommandParameter="{Binding DataContext.Id}" Header="Delete" Style="{StaticResource PtjDeleteMenuItemStyle}">
                                                            <MenuItem.Icon><Viewbox><Path Data="{StaticResource PtjIconDelete}" Fill="{x:Null}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}" StrokeLineJoin="Round" StrokeThickness="1.8" /></Viewbox></MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <Viewbox Width="18" Height="18"><Path Data="{StaticResource PtjIconMore}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Stretch="Uniform" /></Viewbox>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
