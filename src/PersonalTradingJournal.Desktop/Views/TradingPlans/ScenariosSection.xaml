<UserControl x:Class="PersonalTradingJournal.Desktop.Views.TradingPlans.ScenariosSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PersonalTradingJournal.Desktop.Views.TradingPlans"
             xmlns:trades="clr-namespace:PersonalTradingJournal.Domain.Trades;assembly=PersonalTradingJournal.Domain"
             xmlns:validation="clr-namespace:PersonalTradingJournal.Desktop.Validation"
             xmlns:interactions="clr-namespace:PersonalTradingJournal.Desktop.Interactions"
             DataContextChanged="OnDataContextChanged"
             Background="{DynamicResource PtjBackgroundBrush}" Foreground="{DynamicResource PtjTextPrimaryBrush}"
             FontSize="16" KeyboardNavigation.TabNavigation="Continue">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIf" />
        <Style TargetType="ScrollBar" BasedOn="{StaticResource PtjScrollBarStyle}" />
        <Style x:Key="Body" TargetType="TextBlock" BasedOn="{StaticResource PtjBodyTextStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource PtjTextPrimaryBrush}" />
            <Setter Property="Padding" Value="0,4,0,6" />
        </Style>
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource PtjSecondaryButtonStyle}">
            <Setter Property="Margin" Value="0,4,8,4" />
        </Style>
        <Style x:Key="ScenarioHeading" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PtjAccentBrush}" />
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Direction}" Value="{x:Static trades:TradeDirection.Short}">
                    <Setter Property="Foreground" Value="{DynamicResource PtjDangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="Field">
            <StackPanel>
                <Label Content="{Binding Label}" Target="{Binding ElementName=Input}" />
                <TextBox x:Name="Input" Style="{StaticResource PtjTextBoxStyle}"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="130"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Error}"
                         AutomationProperties.ItemStatus="{Binding Error}" validation:FormValidation.IsInvalid="{Binding IsInvalid}" />
                <TextBlock Text="{Binding Error}" Style="{StaticResource Body}" Foreground="{DynamicResource PtjDangerBrush}"
                           Visibility="{Binding IsInvalid, Converter={StaticResource VisibleIf}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel Margin="12">
        <TextBlock Text="02 If / Then Scenarios" FontSize="20" FontWeight="SemiBold" Style="{StaticResource Body}"
                   Foreground="{DynamicResource PtjAccentBrush}" AutomationProperties.HeadingLevel="Level2" />
        <TextBlock Text="{Binding StateLabel}" Style="{StaticResource Body}" Margin="0,6" Visibility="{Binding ShowComponentContext, Converter={StaticResource VisibleIf}}" />
        <TextBlock Text="{Binding Message}" Style="{StaticResource Body}" Margin="0,4"
                   interactions:LiveAnnouncement.Text="{Binding Message}" AutomationProperties.LiveSetting="Polite" Visibility="{Binding ShowComponentContext, Converter={StaticResource VisibleIf}}" />
        <WrapPanel>
            <Button Content="Add Scenario" Command="{Binding AddScenarioCommand}" Style="{StaticResource Action}" AutomationProperties.Name="Add Scenario" />
            <Button Content="Load Playbooks" Command="{Binding ReloadPlaybooksCommand}" Style="{StaticResource Action}" AutomationProperties.Name="Load Playbook choices and availability" />
        </WrapPanel>
        <TextBlock Text="No scenarios. Add Scenario using an instrument context from Session Preparation, or choose Stand Aside below. No example conditions are filled automatically."
                   Visibility="{Binding HasNoScenarios, Converter={StaticResource VisibleIf}}" Style="{StaticResource Body}" Margin="0,4" />
        <ItemsControl x:Name="ScenarioCards" ItemsSource="{Binding Scenarios}" SizeChanged="OnCardsSizeChanged">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Width" Value="{Binding CardWidth, RelativeSource={RelativeSource AncestorType={x:Type local:ScenariosSection}}}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,6,12,10" Padding="14" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{DynamicResource PtjBorderBrush}" Background="{DynamicResource PtjSurfaceElevatedBrush}">
                        <StackPanel>
                            <TextBlock Text="{Binding Heading}" Style="{StaticResource ScenarioHeading}" />
                            <ContentControl Content="{Binding Name}" ContentTemplate="{StaticResource Field}" />
                            <Label Content="Designation" Target="{Binding ElementName=Role}" />
                            <ComboBox x:Name="Role" ItemsSource="{Binding Owner.ScenarioRoles}" SelectedItem="{Binding Role}"
                                      Style="{StaticResource PtjComboBoxStyle}" IsEnabled="{Binding Owner.CanEdit}" AutomationProperties.Name="Scenario designation" />
                            <Label Content="Instrument context" Target="{Binding ElementName=Instrument}" />
                            <ComboBox x:Name="Instrument" ItemsSource="{Binding Owner.Contexts}" DisplayMemberPath="Label" SelectedValuePath="InstrumentId"
                                      SelectedValue="{Binding InstrumentId}" IsEnabled="{Binding Owner.CanEdit}" Style="{StaticResource PtjComboBoxStyle}"
                                      AutomationProperties.Name="Scenario instrument context" />
                            <Label Content="Direction" Target="{Binding ElementName=Direction}" />
                            <ComboBox x:Name="Direction" ItemsSource="{Binding Owner.ScenarioDirections}" SelectedItem="{Binding Direction}"
                                      Style="{StaticResource PtjComboBoxStyle}" IsEnabled="{Binding Owner.CanEdit}" AutomationProperties.Name="Scenario Long or Short direction" />
                            <ContentControl Content="{Binding Condition}" ContentTemplate="{StaticResource Field}" />
                            <ContentControl Content="{Binding Response}" ContentTemplate="{StaticResource Field}" />
                            <ContentControl Content="{Binding Invalidation}" ContentTemplate="{StaticResource Field}" />
                            <Label Content="PLAYBOOK — optional existing Setup" Target="{Binding ElementName=Playbook}" />
                            <ComboBox x:Name="Playbook" ItemsSource="{Binding Owner.AvailablePlaybooks}" DisplayMemberPath="Name" SelectedItem="{Binding Candidate}"
                                      Style="{StaticResource PtjComboBoxStyle}" IsEnabled="{Binding Owner.CanEdit}" AutomationProperties.Name="Playbook candidate" />
                            <WrapPanel>
                                <Button Content="Select revision" Command="{Binding LinkCommand}" Style="{StaticResource Action}" />
                                <Button Content="Unlink" Command="{Binding UnlinkCommand}" Style="{StaticResource Action}" />
                                <Button Content="Open Playbook" Command="{Binding OpenPlaybookCommand}" Style="{StaticResource Action}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding PlaybookText}" Style="{StaticResource Body}" Margin="0,6" />
                            <WrapPanel>
                                <Button Content="Move earlier" Command="{Binding MoveUpCommand}" Style="{StaticResource Action}" AutomationProperties.Name="Move scenario earlier" />
                                <Button Content="Move later" Command="{Binding MoveDownCommand}" Style="{StaticResource Action}" AutomationProperties.Name="Move scenario later" />
                                <Button Content="Remove scenario" Command="{Binding RemoveCommand}" Style="{StaticResource Action}" AutomationProperties.Name="Remove Draft scenario" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Padding="14" Margin="0,8,12,0" CornerRadius="8" Background="{DynamicResource PtjSurfaceElevatedBrush}"
                BorderBrush="{DynamicResource PtjAccentBrush}" BorderThickness="3,0,0,0">
            <StackPanel>
                <TextBlock Text="Stand Aside" Style="{StaticResource Body}" FontSize="18" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level3" />
                <CheckBox Content="Intentionally stand aside — no trading scenarios" IsChecked="{Binding IsStandAside}" IsEnabled="{Binding CanEdit}"
                          Foreground="{DynamicResource PtjTextPrimaryBrush}" Margin="0,10" AutomationProperties.Name="Intentionally stand aside">
                    <CheckBox.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></CheckBox.ContentTemplate>
                </CheckBox>
                <TextBlock Text="{Binding IntentMessage}" Style="{StaticResource Body}" />
                <ContentControl Content="{Binding StandAside}" ContentTemplate="{StaticResource Field}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
