<UserControl x:Class="PersonalTradingJournal.Desktop.Views.TradingPlans.ScenariosSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PersonalTradingJournal.Desktop.Views.TradingPlans"
             xmlns:trades="clr-namespace:PersonalTradingJournal.Domain.Trades;assembly=PersonalTradingJournal.Domain"
             xmlns:validation="clr-namespace:PersonalTradingJournal.Desktop.Validation"
             xmlns:interactions="clr-namespace:PersonalTradingJournal.Desktop.Interactions"
             DataContextChanged="OnDataContextChanged"
             Background="Transparent" Foreground="{DynamicResource PtjTextPrimaryBrush}"
             FontSize="13" KeyboardNavigation.TabNavigation="Continue">
    <UserControl.Resources>
      <ResourceDictionary>
       <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SessionBriefStyles.xaml" /></ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="VisibleIf" />
        <Style TargetType="ScrollBar" BasedOn="{StaticResource PtjScrollBarStyle}" />
        <Style x:Key="Body" TargetType="TextBlock" BasedOn="{StaticResource PtjBodyTextStyle}">
            <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource PtjTextPrimaryBrush}" />
            <Setter Property="Padding" Value="0,2" />
        </Style>
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource PlanAction}">
            <Setter Property="Margin" Value="0,4,8,4" />
        </Style>
        <Style x:Key="ScenarioHeading" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PtjAccentBrush}" />
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Direction}" Value="{x:Static trades:TradeDirection.Short}">
                    <Setter Property="Foreground" Value="{DynamicResource PtjDangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="Field">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Label Content="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}" ToolTip="{Binding Label}" Target="{Binding ElementName=Input}" VerticalAlignment="Center" FontSize="12" />
                <TextBox x:Name="Input" Grid.Column="1" Style="{StaticResource PlanInput}"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="32" MaxHeight="130"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Error}"
                         AutomationProperties.ItemStatus="{Binding Error}" validation:FormValidation.IsInvalid="{Binding IsInvalid}" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Error}" Style="{StaticResource Body}" Foreground="{DynamicResource PtjDangerBrush}"
                           Visibility="{Binding IsInvalid, Converter={StaticResource VisibleIf}}" />
            </Grid>
        </DataTemplate>
          </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="12">
<DockPanel>
 <Button DockPanel.Dock="Right" Content="Add Scenario" Command="{Binding AddScenarioCommand}" Style="{StaticResource Action}" AutomationProperties.Name="Add Scenario" VerticalAlignment="Top" />
 <ContentControl Content="If / Then Scenarios" Tag="02" Style="{StaticResource PlanSectionHeading}" />
</DockPanel>
        <TextBlock Text="{Binding StateLabel}" Style="{StaticResource Body}" Margin="0,6" Visibility="{Binding ShowComponentContext, Converter={StaticResource VisibleIf}}" />
        <TextBlock Text="{Binding Message}" Style="{StaticResource Body}" Margin="0,4"
                   interactions:LiveAnnouncement.Text="{Binding Message}" AutomationProperties.LiveSetting="Polite" Visibility="{Binding ShowComponentContext, Converter={StaticResource VisibleIf}}" />
        <TextBlock Text="No scenarios. Add Scenario using an instrument context from Session Preparation, or choose Stand Aside below. No example conditions are filled automatically."
                   Visibility="{Binding HasNoScenarios, Converter={StaticResource VisibleIf}}" Style="{StaticResource Body}" Margin="0,4" />
        <ItemsControl x:Name="ScenarioCards" ItemsSource="{Binding Scenarios}" SizeChanged="OnCardsSizeChanged">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Width" Value="{Binding CardWidth, RelativeSource={RelativeSource AncestorType={x:Type local:ScenariosSection}}}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,6,12,10" Padding="10" CornerRadius="6" BorderThickness="0,3,0,0"
                            BorderBrush="{DynamicResource PtjAccentBrush}" Background="{DynamicResource PtjSurfaceBrush}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                             <Grid.ColumnDefinitions><ColumnDefinition Width="124" /><ColumnDefinition Width="96" /><ColumnDefinition /></Grid.ColumnDefinitions>
                             <ComboBox x:Name="Role" Margin="0,0,6,0" ItemsSource="{Binding Owner.ScenarioRoles}" SelectedItem="{Binding Role}" Style="{StaticResource PlanSelect}" IsEnabled="{Binding Owner.CanEdit}" AutomationProperties.Name="Scenario designation" />
                             <ComboBox x:Name="Direction" Grid.Column="1" Margin="0,0,6,0" ItemsSource="{Binding Owner.ScenarioDirections}" SelectedItem="{Binding Direction}" Style="{StaticResource PlanSelect}" IsEnabled="{Binding Owner.CanEdit}" AutomationProperties.Name="Scenario Long or Short direction" />
                             <StackPanel Grid.Column="2" DataContext="{Binding Name}">
                              <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}" Style="{StaticResource PlanInput}" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="80" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Error}" validation:FormValidation.IsInvalid="{Binding IsInvalid}" />
                              <TextBlock Text="{Binding Error}" Style="{StaticResource Body}" Foreground="{DynamicResource PtjDangerBrush}" Visibility="{Binding IsInvalid, Converter={StaticResource VisibleIf}}" />
                             </StackPanel>
                            </Grid>
                            <ContentControl Tag="IF" Content="{Binding Condition}" ContentTemplate="{StaticResource Field}" />
                            <ContentControl Tag="THEN" Content="{Binding Response}" ContentTemplate="{StaticResource Field}" />
                            <ContentControl Tag="INVALID IF" Content="{Binding Invalidation}" ContentTemplate="{StaticResource Field}" />
                            <Expander Header="Playbook &amp; scenario options" Foreground="{DynamicResource PtjAccentBrush}" Margin="0,4">
                             <StackPanel>
                              <Label Content="Instrument context" Target="{Binding ElementName=Instrument}" />
                              <ComboBox x:Name="Instrument" ItemsSource="{Binding Owner.Contexts}" DisplayMemberPath="Label" SelectedValuePath="InstrumentId" SelectedValue="{Binding InstrumentId}" IsEnabled="{Binding Owner.CanEdit}" Style="{StaticResource PlanSelect}" AutomationProperties.Name="Scenario instrument context" />
                            <Button Content="Load Playbooks" Command="{Binding Owner.ReloadPlaybooksCommand}" Style="{StaticResource Action}" HorizontalAlignment="Left" AutomationProperties.Name="Load Playbook choices and availability" />
                            <Label Content="PLAYBOOK — optional existing Setup" Target="{Binding ElementName=Playbook}" />
                            <ComboBox x:Name="Playbook" ItemsSource="{Binding Owner.AvailablePlaybooks}" DisplayMemberPath="Name" SelectedItem="{Binding Candidate}"
                                      Style="{StaticResource PlanSelect}" IsEnabled="{Binding Owner.CanEdit}" AutomationProperties.Name="Playbook candidate" />
                            <WrapPanel>
                                <Button Content="Select revision" Command="{Binding LinkCommand}" Style="{StaticResource Action}" />
                                <Button Content="Unlink" Command="{Binding UnlinkCommand}" Style="{StaticResource Action}" />
                                <Button Content="Open Playbook" Command="{Binding OpenPlaybookCommand}" Style="{StaticResource Action}" />
                            </WrapPanel>
                             <WrapPanel>
                                <Button Content="Move earlier" Command="{Binding MoveUpCommand}" Style="{StaticResource Action}" AutomationProperties.Name="Move scenario earlier" />
                                <Button Content="Move later" Command="{Binding MoveDownCommand}" Style="{StaticResource Action}" AutomationProperties.Name="Move scenario later" />
                                <Button Content="Remove scenario" Command="{Binding RemoveCommand}" Style="{StaticResource Action}" AutomationProperties.Name="Remove Draft scenario" />
                             </WrapPanel>
                             </StackPanel>
                            </Expander>
                            <TextBlock Margin="0,4" ToolTip="{Binding PlaybookText}" AutomationProperties.HelpText="{Binding PlaybookText}">
                             <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Body}"><Setter Property="Text" Value="{Binding PlaybookText}" />
                              <Style.Triggers><DataTrigger Binding="{Binding Setup}" Value="{x:Null}"><Setter Property="Text" Value="Playbook: none linked · optional" /></DataTrigger></Style.Triggers>
                             </Style></TextBlock.Style>
                            </TextBlock>

                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Padding="10,6" Margin="0,4,0,0" CornerRadius="8" Background="{DynamicResource PtjSurfaceElevatedBrush}"
                BorderBrush="{DynamicResource PtjAccentBrush}" BorderThickness="3,0,0,0">
            <Grid>
             <Grid.ColumnDefinitions><ColumnDefinition Width="155" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <CheckBox Content="Stand Aside" IsChecked="{Binding IsStandAside}" IsEnabled="{Binding CanEdit}"
                          Foreground="{DynamicResource PtjTextPrimaryBrush}" Margin="0,4" VerticalAlignment="Center" AutomationProperties.Name="Intentionally stand aside" AutomationProperties.HelpText="{Binding IntentMessage}" ToolTip="{Binding IntentMessage}">
                    <CheckBox.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></CheckBox.ContentTemplate>
                </CheckBox>
                <StackPanel Grid.Column="1" DataContext="{Binding StandAside}">
                 <TextBox Style="{StaticResource PlanInput}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="130" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Error}" validation:FormValidation.IsInvalid="{Binding IsInvalid}" />
                 <TextBlock Text="{Binding Error}" Style="{StaticResource Body}" Foreground="{DynamicResource PtjDangerBrush}" Visibility="{Binding IsInvalid, Converter={StaticResource VisibleIf}}" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
