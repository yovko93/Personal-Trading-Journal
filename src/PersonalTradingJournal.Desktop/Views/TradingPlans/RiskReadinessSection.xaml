<UserControl x:Class="PersonalTradingJournal.Desktop.Views.TradingPlans.RiskReadinessSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:validation="clr-namespace:PersonalTradingJournal.Desktop.Validation"
             xmlns:interactions="clr-namespace:PersonalTradingJournal.Desktop.Interactions"
             xmlns:plan="clr-namespace:PersonalTradingJournal.Domain.TradingPlans;assembly=PersonalTradingJournal.Domain"
             DataContextChanged="OnDataContextChanged" SizeChanged="OnSizeChanged"
             Background="Transparent" Foreground="{DynamicResource PtjTextPrimaryBrush}"
             FontSize="13" KeyboardNavigation.TabNavigation="Continue">
    <UserControl.Resources>
      <ResourceDictionary>
       <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SessionBriefStyles.xaml" /></ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="VisibleIf" />
        <Style TargetType="ScrollBar" BasedOn="{StaticResource PtjScrollBarStyle}" />
        <Style x:Key="Body" TargetType="TextBlock" BasedOn="{StaticResource PtjBodyTextStyle}">
            <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PtjAccentBrush}" />
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level3" />
        </Style>
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource PlanAction}">
            <Setter Property="Margin" Value="0,6,8,6" />
        </Style>
        <DataTemplate x:Key="Field">
            <StackPanel Margin="0,2,8,4">
                <Label Content="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}" ToolTip="{Binding Label}" Target="{Binding ElementName=Input}" Padding="0,2"
                       Foreground="{DynamicResource PtjTextPrimaryBrush}"><Label.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" /></DataTemplate></Label.ContentTemplate></Label>
                <TextBox x:Name="Input" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"
                         Style="{StaticResource PlanInput}" HorizontalScrollBarVisibility="Auto"
                         AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Error}"
                         AutomationProperties.ItemStatus="{Binding Error}" validation:FormValidation.IsInvalid="{Binding IsInvalid}" />
                <TextBlock Text="{Binding Error}" Style="{StaticResource Body}" Foreground="{DynamicResource PtjDangerBrush}"
                           Visibility="{Binding IsInvalid, Converter={StaticResource VisibleIf}}" />
            </StackPanel>
        </DataTemplate>
          </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="12">
        <ContentControl Content="Risk &amp; Rules" Tag="03" Style="{StaticResource PlanSectionHeading}" />
        <TextBlock Text="{Binding StateLabel}" Style="{StaticResource Body}" Margin="0,6" Visibility="{Binding ShowComponentContext, Converter={StaticResource VisibleIf}}" />
        <TextBlock Text="{Binding Message}" Style="{StaticResource Body}" Margin="0,4" Visibility="{Binding ShowComponentContext, Converter={StaticResource VisibleIf}}" />
        <Grid x:Name="Columns" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel x:Name="LimitsAndRules" Margin="0,0,14,0">
                <Border Padding="0" CornerRadius="8" Background="Transparent">
                    <StackPanel>
                        <TextBlock Text="Planned Limits" Style="{StaticResource Heading}" />
                        <TextBlock Text="{Binding CurrencyLabel}" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,4" ToolTip="{Binding CurrencyMessage}" AutomationProperties.HelpText="{Binding CurrencyMessage}" />
                        <TextBlock Text="{Binding CurrencyMessage}" Style="{StaticResource Body}" Visibility="{Binding RequiresReferenceRefresh, Converter={StaticResource VisibleIf}}" />
                        <UniformGrid x:Name="LimitsGrid" Columns="2">
                        <ContentControl Tag="Risk / Trade" Content="{Binding RiskPerTrade}" ContentTemplate="{StaticResource Field}" />
                        <ContentControl Tag="Daily Loss Limit" Content="{Binding DailyLossLimit}" ContentTemplate="{StaticResource Field}" />
                        <ContentControl Tag="Max Trades" Content="{Binding MaximumTrades}" ContentTemplate="{StaticResource Field}" />
                        <ContentControl Tag="Stop After Losses" Content="{Binding ConsecutiveLosses}" ContentTemplate="{StaticResource Field}" />
                        </UniformGrid>
                        <TextBlock Text="Optional limits · blank means unset" Style="{StaticResource Body}" ToolTip="Counts must be whole numbers. Maximum trades may be zero; a consecutive-loss stop must be at least one." />
                    </StackPanel>
                </Border>
                <Border Padding="0" CornerRadius="8" Background="Transparent" Margin="0,12,0,0">
                    <StackPanel>
                        <Expander Header="{Binding LinkedRuleCount}" Foreground="{DynamicResource PtjAccentBrush}" AutomationProperties.Name="Linked Trading Rules"><StackPanel>
                        <Button Content="Load Rules" Command="{Binding LoadRulesCommand}" Style="{StaticResource Action}" HorizontalAlignment="Left" />
                        <Label Content="Rule to link or update" Target="{Binding ElementName=RuleSelector}" Padding="0,4,0,6" Foreground="{DynamicResource PtjTextPrimaryBrush}" />
                        <ComboBox x:Name="RuleSelector" ItemsSource="{Binding RuleChoices}" DisplayMemberPath="Name" SelectedItem="{Binding RuleCandidate}"
                                  IsEnabled="{Binding CanEdit}" Style="{StaticResource PlanSelect}" AutomationProperties.Name="Existing global Rule to link" />
                        <Button Content="Link selected rule" Command="{Binding LinkRuleCommand}" Style="{StaticResource Action}" HorizontalAlignment="Left"
                                AutomationProperties.Name="Link selected rule" AutomationProperties.HelpText="Link the selected Rule definition to this Draft. Save rechecks its version; linking is not an assessment."
                                ToolTip="Link the selected Rule definition; no compliance assessment or automatic check is performed." />
                        <ItemsControl x:Name="LinkedRuleList" ItemsSource="{Binding LinkedRules}" HorizontalContentAlignment="Stretch">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border BorderBrush="{DynamicResource PtjBorderBrush}" BorderThickness="0,1,0,0" Padding="0,4">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold" Focusable="True"
                                                       ToolTip="{Binding ContextHelp}" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding ContextHelp}" />
                                            <TextBlock Text="{Binding Availability}" Style="{StaticResource Body}" Foreground="{DynamicResource PtjWarningBrush}"
                                                       Visibility="{Binding HasAvailabilityWarning, Converter={StaticResource VisibleIf}}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="×" Command="{Binding RemoveCommand}" Style="{StaticResource PlanRemove}" VerticalAlignment="Center"
                                                AutomationProperties.Name="{Binding Name, StringFormat=Unlink rule: {0}}" ToolTip="Unlink from this Draft only; the catalog Rule and saved Ready snapshots are retained." />
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl></StackPanel></Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
            <Button Grid.Row="1" Content="Check references" Command="{Binding CheckReferencesCommand}" Style="{StaticResource Action}" HorizontalAlignment="Left" />
        </Grid>
    </StackPanel>
</UserControl>
