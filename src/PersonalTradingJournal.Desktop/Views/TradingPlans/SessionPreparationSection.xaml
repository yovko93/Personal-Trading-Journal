<UserControl x:Class="PersonalTradingJournal.Desktop.Views.TradingPlans.SessionPreparationSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:validation="clr-namespace:PersonalTradingJournal.Desktop.Validation"
             xmlns:plan="clr-namespace:PersonalTradingJournal.Domain.TradingPlans;assembly=PersonalTradingJournal.Domain"
             xmlns:interactions="clr-namespace:PersonalTradingJournal.Desktop.Interactions"
             DataContextChanged="OnDataContextChanged" SizeChanged="OnSizeChanged"
             Background="{DynamicResource PtjBackgroundBrush}" Foreground="{DynamicResource PtjTextPrimaryBrush}"
             FontSize="16" KeyboardNavigation.TabNavigation="Continue">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIf" />
        <Style TargetType="ScrollBar" BasedOn="{StaticResource PtjScrollBarStyle}" />
        <Style x:Key="Body" TargetType="TextBlock" BasedOn="{StaticResource PtjBodyTextStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="Foreground" Value="{DynamicResource PtjAccentBrush}" />
            <Setter Property="FontSize" Value="20" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource PtjTextPrimaryBrush}" />
            <Setter Property="Padding" Value="0,4,0,6" />
        </Style>
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource PtjTextBoxStyle}">
            <Setter Property="Text" Value="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="IsReadOnly" Value="{Binding IsReadOnly}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding Error}" />
            <Setter Property="AutomationProperties.ItemStatus" Value="{Binding Error}" />
            <Setter Property="validation:FormValidation.IsInvalid" Value="{Binding IsInvalid}" />
        </Style>
        <DataTemplate x:Key="TextField">
            <StackPanel>
                <Label Content="{Binding Label}" Target="{Binding ElementName=TextInput}" />
                <TextBox x:Name="TextInput" Style="{StaticResource Field}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="76" MaxHeight="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
                <TextBlock Text="{Binding Error}" Style="{StaticResource Body}" Foreground="{DynamicResource PtjDangerBrush}"
                           Visibility="{Binding IsInvalid, Converter={StaticResource VisibleIf}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="LevelField">
            <StackPanel Margin="0,0,10,8">
                <Label Content="{Binding Label}" Target="{Binding ElementName=PriceInput}" />
                <TextBox x:Name="PriceInput" Style="{StaticResource Field}" MinWidth="0" HorizontalScrollBarVisibility="Auto" />
                <TextBlock Text="{Binding Error}" Style="{StaticResource Body}" Foreground="{DynamicResource PtjDangerBrush}"
                           Visibility="{Binding IsInvalid, Converter={StaticResource VisibleIf}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel Margin="12">
        <Border Background="{DynamicResource PtjSurfaceElevatedBrush}" BorderBrush="{DynamicResource PtjAccentBrush}"
                BorderThickness="3,1,1,1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
            <ContentControl Content="{Binding Focus}" ContentTemplate="{StaticResource TextField}" />
        </Border>
        <TextBlock Text="01 Session Preparation" Style="{StaticResource Heading}" />
        <TextBlock Text="{Binding StateLabel}" Style="{StaticResource Body}" Margin="0,4,0,8" Visibility="{Binding ShowComponentContext, Converter={StaticResource VisibleIf}}" />
        <TextBlock Text="{Binding Message}" Style="{StaticResource Body}" AutomationProperties.Name="{Binding Message}"
                   interactions:LiveAnnouncement.Text="{Binding Message}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8" Visibility="{Binding ShowComponentContext, Converter={StaticResource VisibleIf}}" />
        <WrapPanel>
            <StackPanel Width="210" Margin="0,0,12,8" Visibility="{Binding ShowComponentContext, Converter={StaticResource VisibleIf}}">
                <Label Content="_Session" Target="{Binding ElementName=SessionSelector}" />
                <ComboBox x:Name="SessionSelector" ItemsSource="{Binding Sessions}" SelectedItem="{Binding Session}"
                          Style="{StaticResource PtjComboBoxStyle}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Session, optional in Draft">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{Binding}" />
                        <Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Static plan:TradingPlanSession.NewYork}"><Setter Property="Text" Value="New York" /></DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style></TextBlock></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <StackPanel Width="280" Margin="0,0,12,8">
                <Label Content="_Instrument context" Target="{Binding ElementName=ContextSelector}" />
                <ComboBox x:Name="ContextSelector" ItemsSource="{Binding Contexts}" SelectedItem="{Binding SelectedInstrument}" DisplayMemberPath="Label"
                          IsEnabled="{Binding CanSelectContext}" Style="{StaticResource PtjComboBoxStyle}" AutomationProperties.Name="Selected instrument context" />
            </StackPanel>
            <Button Content="Remove context" Command="{Binding RemoveInstrumentCommand}" Style="{StaticResource PtjSecondaryButtonStyle}"
                    VerticalAlignment="Bottom" Margin="0,0,0,8" AutomationProperties.Name="Remove selected instrument context" />
        </WrapPanel>
        <WrapPanel>
            <StackPanel Width="280" Margin="0,0,12,8">
                <Label Content="_Add from Instruments" Target="{Binding ElementName=CatalogSelector}" />
                <ComboBox x:Name="CatalogSelector" ItemsSource="{Binding AvailableInstruments}" SelectedItem="{Binding InstrumentToAdd}" DisplayMemberPath="Symbol"
                          Style="{StaticResource PtjComboBoxStyle}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Instrument catalog for new context" />
            </StackPanel>
            <Button Content="Add context" Command="{Binding AddInstrumentCommand}" Style="{StaticResource PtjSecondaryButtonStyle}"
                    VerticalAlignment="Bottom" Margin="0,0,0,8" AutomationProperties.Name="Add instrument context" />
        </WrapPanel>
        <TextBlock Text="Add an instrument to prepare its context and optional levels." Style="{StaticResource Body}"
                   Visibility="{Binding HasNoContext, Converter={StaticResource VisibleIf}}" Margin="0,8,0,12" />
        <Grid x:Name="ContextGrid" Margin="0,8,0,12" Visibility="{Binding HasSelectedContext, Converter={StaticResource VisibleIf}}">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel x:Name="ContextFields" Margin="0,0,14,0" DataContext="{Binding SelectedInstrument}">
                <TextBlock Text="{Binding Label}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                <Label Content="_Bias" Target="{Binding ElementName=BiasSelector}" />
                <ComboBox x:Name="BiasSelector" ItemsSource="{Binding DataContext.Biases, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedItem="{Binding Bias}" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          Style="{StaticResource PtjComboBoxStyle}" AutomationProperties.Name="Instrument bias, blank means not selected" />
                <ContentControl Content="{Binding Thesis}" ContentTemplate="{StaticResource TextField}" Margin="0,8,0,0" />
            </StackPanel>
            <StackPanel x:Name="LevelFields" Grid.Column="1">
                <TextBlock Text="Key Levels" Style="{StaticResource Heading}" />
                <TextBlock Text="Manual prices · blank means unknown. Prices are not rounded to tick size." Style="{StaticResource Body}" Margin="0,4,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ContentControl Content="{Binding SelectedInstrument.Levels[0]}" ContentTemplate="{StaticResource LevelField}" />
                    <ContentControl Grid.Column="1" Content="{Binding SelectedInstrument.Levels[1]}" ContentTemplate="{StaticResource LevelField}" />
                    <ContentControl Grid.Row="1" Content="{Binding SelectedInstrument.Levels[2]}" ContentTemplate="{StaticResource LevelField}" />
                    <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding SelectedInstrument.Levels[3]}" ContentTemplate="{StaticResource LevelField}" />
                    <ContentControl Grid.Row="2" Content="{Binding SelectedInstrument.Levels[4]}" ContentTemplate="{StaticResource LevelField}" />
                    <ContentControl Grid.Row="2" Grid.Column="1" Content="{Binding SelectedInstrument.Levels[5]}" ContentTemplate="{StaticResource LevelField}" />
                </Grid>
            </StackPanel>
        </Grid>
        <ContentControl Content="{Binding News}" ContentTemplate="{StaticResource TextField}" />
    </StackPanel>
</UserControl>
