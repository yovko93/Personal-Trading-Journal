<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:PersonalTradingJournal.Desktop.Views.TradingPlans"
 xmlns:interactions="clr-namespace:PersonalTradingJournal.Desktop.Interactions">
 <Style x:Key="PlanSectionExpander" TargetType="{x:Type local:PlanSectionExpander}">
  <Setter Property="Foreground" Value="{DynamicResource PtjAccentBrush}" />
  <Setter Property="IsExpanded" Value="True" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:PlanSectionExpander}">
   <StackPanel>
    <ToggleButton x:Name="HeaderToggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
      HorizontalContentAlignment="Stretch" Foreground="{TemplateBinding Foreground}"
      AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" ToolTip="{Binding ActionDescription, RelativeSource={RelativeSource TemplatedParent}}" Padding="4,5" Margin="0,0,0,4">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
      <Border x:Name="Chrome" CornerRadius="4" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PtjSurfaceElevatedBrush}" /></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PtjJournalReviewBorderBrush}" /></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PtjAccentBrush}" /></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource PtjTextSecondaryBrush}" /></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate></ToggleButton.Template>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
      <Border Width="36" Height="36" CornerRadius="6" Margin="0,0,6,0" Background="{DynamicResource PtjSurfaceElevatedBrush}" VerticalAlignment="Center" IsHitTestVisible="False">
       <local:PlanFoldIcon IsExpanded="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
      </Border>
      <Border x:Name="Number" Grid.Column="1" Width="30" Height="30" CornerRadius="15" Margin="0,0,10,0" Background="{DynamicResource PtjSurfaceElevatedBrush}" BorderBrush="{DynamicResource PtjBorderBrush}" BorderThickness="1">
       <TextBlock Text="{TemplateBinding Tag}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <TextBlock Grid.Column="2" Text="{TemplateBinding Header}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
     </Grid>
    </ToggleButton>
    <ContentPresenter x:Name="Body" ContentSource="Content" HorizontalAlignment="Stretch" Visibility="Collapsed" />
   </StackPanel>
   <ControlTemplate.Triggers>
    <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible" /></Trigger>
    <Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="Number" Property="Visibility" Value="Collapsed" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- Same semantic border/surface presentation as Rules feedback, without another notification service. -->
 <DataTemplate x:Key="PlanInfoBox">
  <Border x:Name="Box" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,2,0,6"
          Background="{DynamicResource PtjInformationSurfaceBrush}" BorderBrush="{DynamicResource PtjInformationBrush}">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Icon}" FontSize="16" FontWeight="Bold" Foreground="{Binding BorderBrush, ElementName=Box}" Margin="0,0,10,0" />
    <TextBlock x:Name="NoticeText" Grid.Column="1" Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource PtjTextPrimaryBrush}"
      AutomationProperties.Name="{Binding AccessibleText}" AutomationProperties.LiveSetting="Polite" interactions:LiveAnnouncement.Text="{Binding AccessibleText}" />
   </Grid>
  </Border>
  <DataTemplate.Triggers>
   <DataTrigger Binding="{Binding HasText}" Value="False"><Setter TargetName="Box" Property="Visibility" Value="Collapsed" /></DataTrigger>
   <DataTrigger Binding="{Binding Kind}" Value="Success"><Setter TargetName="Box" Property="Background" Value="{DynamicResource PtjSuccessSurfaceBrush}" /><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PtjSuccessBrush}" /></DataTrigger>
   <DataTrigger Binding="{Binding Kind}" Value="Warning"><Setter TargetName="Box" Property="Background" Value="{DynamicResource PtjJournalReviewBrush}" /><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PtjWarningBrush}" /></DataTrigger>
   <DataTrigger Binding="{Binding Kind}" Value="Error"><Setter TargetName="Box" Property="Background" Value="{DynamicResource PtjDangerSurfaceBrush}" /><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PtjDangerBrush}" /><Setter TargetName="NoticeText" Property="AutomationProperties.LiveSetting" Value="Assertive" /></DataTrigger>
  </DataTemplate.Triggers>
 </DataTemplate>
 <Style x:Key="PlanSaveDraft" TargetType="Button" BasedOn="{StaticResource PtjJournalActionButtonStyle}">
  <Setter Property="Background" Value="{DynamicResource PtjJournalReviewSurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource PtjAccentBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource PtjAccentBrush}" />
  <Setter Property="FontSize" Value="13" /><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="12,4" /><Setter Property="Margin" Value="0,2,6,2" />
  <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource PtjSurfaceElevatedBrush}" /></Trigger>
   <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource PtjJournalReviewBorderBrush}" /></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource PtjSurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource PtjTextSecondaryBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource PtjBorderBrush}" /></Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="PlanReadyAction" TargetType="Button" BasedOn="{StaticResource PlanSaveDraft}">
  <Setter Property="Background" Value="{DynamicResource PtjPlanReadyBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource PtjPlanReadyBrush}" /><Setter Property="Foreground" Value="{DynamicResource PtjPlanOnActionBrush}" /><Setter Property="FontWeight" Value="SemiBold" />
  <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource PtjPlanReadyHoverBrush}" /></Trigger>
   <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource PtjPlanReadyPressedBrush}" /></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource PtjSurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource PtjTextSecondaryBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource PtjBorderBrush}" /></Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="PlanEditAction" TargetType="Button" BasedOn="{StaticResource PlanReadyAction}">
  <Setter Property="Background" Value="{DynamicResource PtjPlanEditBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource PtjPlanEditBrush}" />
  <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource PtjPlanEditHoverBrush}" /></Trigger>
   <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource PtjPlanEditPressedBrush}" /></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource PtjSurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource PtjTextSecondaryBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource PtjBorderBrush}" /></Trigger>
  </Style.Triggers>
 </Style>
 <!-- Local to the Trading Plan components; shared templates retain focus, validation and all interaction states. -->
 <Style x:Key="PlanStatusBadge" TargetType="ContentControl">
  <Setter Property="Foreground" Value="{DynamicResource PtjTextSecondaryBrush}" /><Setter Property="Background" Value="{DynamicResource PtjSurfaceElevatedBrush}" />
  <Setter Property="BorderBrush" Value="{DynamicResource PtjBorderBrush}" /><Setter Property="Margin" Value="0,0,6,4" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
   <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="9,3">
    <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="12" TextWrapping="Wrap" />
   </Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="PlanInput" TargetType="TextBox" BasedOn="{StaticResource PtjTextBoxStyle}">
  <Setter Property="FontSize" Value="13" /><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="8,4" />
  <Setter Property="VerticalContentAlignment" Value="Center" />
 </Style>
 <Style x:Key="PlanSelect" TargetType="ComboBox" BasedOn="{StaticResource PtjComboBoxStyle}">
  <Setter Property="FontSize" Value="13" /><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="8,4" />
  <Setter Property="VerticalContentAlignment" Value="Center" />
 </Style>
 <Style x:Key="PlanAction" TargetType="Button" BasedOn="{StaticResource PtjSecondaryButtonStyle}">
  <Setter Property="FontSize" Value="13" /><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="10,4" />
  <Setter Property="Margin" Value="0,2,6,2" />
 </Style>
 <Style x:Key="PlanPrimary" TargetType="Button" BasedOn="{StaticResource PtjPlaybookCreateButtonStyle}">
  <Setter Property="FontSize" Value="13" /><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="12,4" />
  <Setter Property="Margin" Value="0,2,6,2" />
 </Style>
 <Style x:Key="PlanRemove" TargetType="Button" BasedOn="{StaticResource PtjPlaybookCloseButtonStyle}">
  <Setter Property="FontSize" Value="13" /><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="8,4" /><Setter Property="Margin" Value="4,2" />
 </Style>
 <Style x:Key="PlanPill" TargetType="Button" BasedOn="{StaticResource PlanAction}">
  <Setter Property="Foreground" Value="{DynamicResource PtjAccentBrush}" /><Setter Property="Background" Value="{DynamicResource PtjSurfaceElevatedBrush}" />
  <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Padding" Value="8,4" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid>
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" CornerRadius="12">
     <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
    </Border>
    <Border x:Name="Focus" Margin="3" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9" IsHitTestVisible="False" />
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource PtjBorderBrush}" /></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource PtjTextPrimaryBrush}" /></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource PtjTextPrimaryBrush}" /></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PtjSurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource PtjTextSecondaryBrush}" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="PlanSectionHeading" TargetType="ContentControl">
  <Setter Property="Foreground" Value="{DynamicResource PtjAccentBrush}" />
  <Setter Property="Margin" Value="0,0,0,8" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
   <DockPanel LastChildFill="True">
    <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource PtjSurfaceElevatedBrush}" BorderBrush="{DynamicResource PtjBorderBrush}" BorderThickness="1" Margin="0,0,10,0">
     <TextBlock Text="{TemplateBinding Tag}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <TextBlock Text="{TemplateBinding Content}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
    <Border Height="1" Background="{DynamicResource PtjBorderBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
   </DockPanel>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="PlanTab" TargetType="RadioButton">
  <Setter Property="Foreground" Value="{DynamicResource PtjTextSecondaryBrush}" />
  <Setter Property="FontSize" Value="14" /><Setter Property="Padding" Value="12,8" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
   <Border x:Name="TabSurface" Background="Transparent" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,2" BorderBrush="Transparent">
    <ContentPresenter RecognizesAccessKey="True" />
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource PtjAccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource PtjAccentBrush}" /></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource PtjSurfaceElevatedBrush}" /></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="BorderThickness" Value="1,1,1,2" /><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource PtjAccentBrush}" /></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
