<UserControl x:Class="PersonalTradingJournal.Desktop.Views.TradingPlans.TradingPlanWorkspaceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:PersonalTradingJournal.Desktop.Views.TradingPlans"
 xmlns:plan="clr-namespace:PersonalTradingJournal.Domain.TradingPlans;assembly=PersonalTradingJournal.Domain"
 xmlns:interactions="clr-namespace:PersonalTradingJournal.Desktop.Interactions"
 xmlns:validation="clr-namespace:PersonalTradingJournal.Desktop.Validation"
 Background="Transparent" Foreground="{DynamicResource PtjTextPrimaryBrush}"
 DataContextChanged="OnDataContextChanged" KeyboardNavigation.TabNavigation="Continue">
 <UserControl.Resources>
      <ResourceDictionary>
       <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SessionBriefStyles.xaml" /></ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="VisibleIf" />
  <Style TargetType="ScrollBar" BasedOn="{StaticResource PtjScrollBarStyle}" />
  <Style x:Key="Body" TargetType="TextBlock" BasedOn="{StaticResource PtjBodyTextStyle}"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="FontSize" Value="13" /></Style>
  <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource PlanAction}"><Setter Property="Margin" Value="0,4,8,4" /></Style>
  <Style x:Key="Section" TargetType="Border" BasedOn="{StaticResource PtjCardStyle}"><Setter Property="Margin" Value="0,0,0,12" /><Setter Property="Padding" Value="0" /></Style>
  <Style x:Key="Date" TargetType="DatePicker">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePicker">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
     <!-- Raw input is deliberately not PART_TextBox: native reparsing discards malformed dates on blur. -->
     <TextBox x:Name="RawDate" Style="{StaticResource PlanInput}"
       Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
       AutomationProperties.Name="New York plan date" AutomationProperties.HelpText="{Binding DateError}"
       validation:FormValidation.IsInvalid="{Binding HasDateError}" KeyDown="OnDateKey" />
     <Button x:Name="PART_Button" Grid.Column="1" Content="▾" Style="{StaticResource PlanAction}" Padding="0" AutomationProperties.Name="Choose New York date" />
     <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" />
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
       </ResourceDictionary>
    </UserControl.Resources>
 <DockPanel Margin="0" TextElement.FontSize="13">
  <Grid DockPanel.Dock="Top" Margin="0,0,0,8" SizeChanged="OnTopBarSizeChanged">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <StackPanel x:Name="Tabs" Orientation="Horizontal">
    <RadioButton Content="Session Brief" IsChecked="{Binding IsBriefSelected, Mode=OneWay}" Command="{Binding ShowBriefCommand}" GroupName="PlanTab" Style="{StaticResource PlanTab}" AutomationProperties.Name="Session Brief tab" />
    <RadioButton Content="History" IsChecked="{Binding IsHistorySelected, Mode=OneWay}" Command="{Binding ShowHistoryCommand}" GroupName="PlanTab" Style="{StaticResource PlanTab}" AutomationProperties.Name="History tab" />
   </StackPanel>
   <WrapPanel x:Name="TopActions" Grid.Column="1" HorizontalAlignment="Right" Visibility="{Binding IsBriefSelected, Converter={StaticResource VisibleIf}}">
    <Button x:Name="SaveDraft" Content="Save Draft" Command="{Binding SaveCommand}" Style="{StaticResource PlanSaveDraft}" />
    <Button Content="Mark as Ready" Command="{Binding MarkReadyCommand}" Style="{StaticResource PlanReadyAction}" />
    <Button x:Name="StartDraft" Content="Start Draft / Edit" Command="{Binding StartDraftCommand}" Style="{StaticResource PlanEditAction}" Visibility="{Binding Editor.IsReadOnly, Converter={StaticResource VisibleIf}, FallbackValue=Collapsed, TargetNullValue=Collapsed}" />
    <Button Content="Cancel operation" Command="{Binding CancelCommand}" Style="{StaticResource Action}" Visibility="{Binding IsBusy, Converter={StaticResource VisibleIf}}" />
   </WrapPanel>
  </Grid>
  <Grid>
  <local:TradingPlanHistoryView Visibility="{Binding IsHistorySelected, Converter={StaticResource VisibleIf}}" />
  <Grid Visibility="{Binding IsBriefSelected, Converter={StaticResource VisibleIf}}">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <WrapPanel x:Name="Toolbar">
   <StackPanel Margin="0,0,12,4">
    <WrapPanel>
     <Button Content="‹" Command="{Binding PreviousDayCommand}" Style="{StaticResource Action}" Padding="8,4" AutomationProperties.Name="Previous calendar day" />
     <DatePicker x:Name="PlanDate" Width="148" Margin="0,4,8,4" Style="{StaticResource Date}" Tag="{Binding DateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        SelectedDate="{Binding CalendarDate}" IsEnabled="{Binding CanSelectContext}" AutomationProperties.Name="New York plan date" />
     <Button Content="›" Command="{Binding NextDayCommand}" Style="{StaticResource Action}" Padding="10,6" AutomationProperties.Name="Next calendar day" />
     <Button Content="Go" ToolTip="Apply typed New York date (Enter)" AutomationProperties.Name="Open typed New York date" Command="{Binding OpenDateCommand}" Style="{StaticResource Action}" />
     <Button Content="Today" Command="{Binding TodayCommand}" Style="{StaticResource Action}" />
    </WrapPanel>
   </StackPanel>
   <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
    <Label Content="Account" Target="{Binding ElementName=Account}" Padding="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource PtjTextPrimaryBrush}" />
    <ComboBox x:Name="Account" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" DisplayMemberPath="Label"
      Style="{StaticResource PlanSelect}" Width="190" IsEnabled="{Binding CanSelectContext}" Margin="0,4,0,0" AutomationProperties.Name="Trading Plan scope: All Accounts or exact Account" />
   </StackPanel>
   <StackPanel Orientation="Horizontal" Margin="0,0,12,4" Visibility="{Binding HasEditor, Converter={StaticResource VisibleIf}}">
    <Label Content="Session" Target="{Binding ElementName=Session}" Padding="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource PtjTextPrimaryBrush}" />
    <ComboBox x:Name="Session" ItemsSource="{Binding Editor.Sessions}" SelectedItem="{Binding Editor.Session}" IsEnabled="{Binding Editor.CanEdit}"
      Style="{StaticResource PlanSelect}" Width="135" Margin="0,4,0,0" AutomationProperties.Name="Planned session, optional in Draft">
     <ComboBox.ItemTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding}" />
      <Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Static plan:TradingPlanSession.NewYork}"><Setter Property="Text" Value="New York" /></DataTrigger></Style.Triggers>
     </Style></TextBlock.Style></TextBlock></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
   </StackPanel>
   <StackPanel Visibility="{Binding IsGlobalScope, Converter={StaticResource VisibleIf}}" Margin="0,0,12,4">
    <TextBox Width="110" Text="{Binding PlanCurrency, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding Editor.IsReadOnly}" Style="{StaticResource PlanInput}" AutomationProperties.Name="Shared plan currency" AutomationProperties.HelpText="Trader-wide limits, not multiplied by Account. No currency conversion." />
    <TextBlock Text="{Binding Editor.CurrencyError}" Foreground="{DynamicResource PtjDangerBrush}" TextWrapping="Wrap" />
   </StackPanel>
   <Border VerticalAlignment="Center" Background="{DynamicResource PtjSurfaceElevatedBrush}" BorderBrush="{DynamicResource PtjBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,4,0,0">
    <TextBlock ToolTip="{Binding StateLabel}" AutomationProperties.HelpText="{Binding ContextLabel}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
     <Setter Property="Text" Value="Draft" /><Style.Triggers><DataTrigger Binding="{Binding Editor.IsReadOnly}" Value="True"><Setter Property="Text" Value="Ready" /></DataTrigger>
      <DataTrigger Binding="{Binding HasEditor}" Value="False"><Setter Property="Text" Value="No Plan" /></DataTrigger></Style.Triggers>
    </Style></TextBlock.Style></TextBlock>
   </Border>

  </WrapPanel>
  <StackPanel Grid.Row="1" Margin="0,4,0,8">
   <TextBlock Text="{Binding DateError}" Style="{StaticResource Body}" Foreground="{DynamicResource PtjDangerBrush}" Visibility="{Binding HasDateError, Converter={StaticResource VisibleIf}}" />

   <ContentControl x:Name="Status" Content="{Binding Notice}" ContentTemplate="{StaticResource PlanInfoBox}" HorizontalContentAlignment="Stretch" />
  </StackPanel>
  <ScrollViewer x:Name="PageScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
   <StackPanel>
    <Border Style="{StaticResource Section}" Visibility="{Binding ShowEmpty, Converter={StaticResource VisibleIf}}" Padding="20">
     <StackPanel><TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource Body}" />
      <Button Content="Create Draft" Command="{Binding CreateDraftCommand}" Style="{StaticResource PlanPrimary}" HorizontalAlignment="Left" Margin="0,12,0,0" />
     </StackPanel>
    </Border>
    <StackPanel Visibility="{Binding HasEditor, Converter={StaticResource VisibleIf}}" IsEnabled="{Binding CanInteractEditor}">
     <local:SessionPreparationSection x:Name="Preparation" DataContext="{Binding Editor}" Margin="0,0,0,8" />
     <Border Style="{StaticResource Section}"><local:ScenariosSection x:Name="Scenarios" DataContext="{Binding Editor}" /></Border>
     <Border Style="{StaticResource Section}"><local:RiskReadinessSection x:Name="Risk" DataContext="{Binding Editor}" /></Border>
     <WrapPanel DataContext="{Binding Editor}">
      <Button Content="Refresh references and save Draft" Command="{Binding RefreshReferencesCommand}" Style="{StaticResource Action}" />
      <TextBlock Text="Review changed sources first. Refresh clears all confirmations." Style="{StaticResource Body}" VerticalAlignment="Center" />
     </WrapPanel>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="3" Margin="0,6,0,0">
   <WrapPanel>
    <Button Content="Review this plan after the session →" Command="{Binding OpenDailyReviewCommand}" Style="{StaticResource Action}" />
    <Button Content="Return to Review" Command="{Binding ReturnToReviewCommand}" Style="{StaticResource Action}" Visibility="{Binding CanReturnToReview, Converter={StaticResource VisibleIf}}" />
    <Button x:Name="Reload" Content="Reload" Command="{Binding ReloadCommand}" Style="{StaticResource Action}" />
    <TextBlock Text="New York dates · session is selected above" Style="{StaticResource Body}" VerticalAlignment="Center" />
   </WrapPanel>
   <TextBlock Text="{Binding Editor.PreservedReadyLabel}" Style="{StaticResource Body}" />
  </StackPanel>
 </Grid>
  </Grid>
 </DockPanel>
</UserControl>
