<UserControl x:Class="PersonalTradingJournal.Desktop.Views.Accounts.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:PersonalTradingJournal.Desktop.Converters"
             xmlns:interactions="clr-namespace:PersonalTradingJournal.Desktop.Interactions"
             xmlns:validation="clr-namespace:PersonalTradingJournal.Desktop.Validation">
    <UserControl.Resources>
        <converters:TradingAccountTypeDisplayConverter x:Key="AccountTypeDisplayConverter" />

        <Style x:Key="AccountColumnHeaderStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource PtjCaptionTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="AccountCellTextStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource PtjBodyTextStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalContentAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  PanningMode="VerticalOnly">
        <ScrollViewer.Resources>
            <Style TargetType="{x:Type ScrollBar}"
                   BasedOn="{StaticResource PtjScrollBarStyle}" />
        </ScrollViewer.Resources>

        <StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center"
                       Style="{StaticResource PtjSecondaryTextStyle}"
                       Text="Trading accounts used to organize journal activity."
                       TextWrapping="Wrap" />

            <Button Grid.Column="1"
                    Margin="16,0,0,0"
                    Command="{Binding RefreshCommand}"
                    Content="Refresh"
                    Style="{StaticResource PtjButtonStyle}" />

            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    Command="{Binding ShowCreateFormCommand}"
                    Content="Add Account"
                    Style="{StaticResource PtjPrimaryButtonStyle}" />
        </Grid>

        <Border Margin="0,16,0,0">
            <Border.Style>
                <Style TargetType="{x:Type Border}"
                       BasedOn="{StaticResource PtjFormSectionStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCreateFormVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <TextBlock Style="{StaticResource PtjFormSectionTitleTextStyle}"
                           Text="Add Account" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource PtjSecondaryTextStyle}"
                           Text="Identify the account and record its starting financial reference."
                           TextWrapping="Wrap" />

                <Grid Margin="0,16,0,0">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCreating}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                        <TextBlock Margin="0,0,0,6"
                                   Style="{StaticResource PtjFormLabelTextStyle}"
                                   Text="Name" />
                        <TextBox validation:FormValidation.IsInvalid="{Binding IsAccountNameInvalid}"
                                 Text="{Binding AccountName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource PtjTextBoxStyle}" />
                        <TextBlock Style="{StaticResource PtjFormHelperTextStyle}"
                                   Text="A clear name used throughout the journal." />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,12">
                        <TextBlock Margin="0,0,0,6"
                                   Style="{StaticResource PtjFormLabelTextStyle}"
                                   Text="Account Type" />
                        <ComboBox ItemsSource="{Binding AccountTypes}"
                                  SelectedItem="{Binding SelectedAccountType}"
                                  Style="{StaticResource PtjComboBoxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource AccountTypeDisplayConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,12">
                        <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource PtjFormLabelTextStyle}"
                                       Text="Provider" />
                            <TextBlock Margin="4,0,0,0"
                                       Style="{StaticResource PtjFormOptionalTextStyle}"
                                       Text="(Optional)" />
                        </StackPanel>
                        <TextBox Text="{Binding ProviderName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource PtjTextBoxStyle}" />
                        <TextBlock Style="{StaticResource PtjFormHelperTextStyle}"
                                   Text="Broker or provider name." />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,12">
                        <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource PtjFormLabelTextStyle}"
                                       Text="External Account ID" />
                            <TextBlock Margin="4,0,0,0"
                                       Style="{StaticResource PtjFormOptionalTextStyle}"
                                       Text="(Optional)" />
                        </StackPanel>
                        <TextBox Text="{Binding ExternalAccountId, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource PtjTextBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Margin="0,0,0,6"
                                   Style="{StaticResource PtjFormLabelTextStyle}"
                                   Text="Currency" />
                        <TextBox validation:FormValidation.IsInvalid="{Binding IsCurrencyInvalid}"
                                 Text="{Binding Currency, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource PtjTextBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,0">
                        <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource PtjFormLabelTextStyle}"
                                       Text="Starting Balance" />
                            <TextBlock Margin="4,0,0,0"
                                       Style="{StaticResource PtjFormOptionalTextStyle}"
                                       Text="(Optional)" />
                        </StackPanel>
                        <TextBox validation:FormValidation.IsInvalid="{Binding IsStartingBalanceInvalid}"
                                 Text="{Binding StartingBalanceText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource PtjTextBoxStyle}" />
                        <TextBlock Style="{StaticResource PtjFormHelperTextStyle}"
                                   Text="Opening reference only; this is not a current balance." />
                    </StackPanel>
                </Grid>

                <TextBlock Margin="0,12,0,0"
                           Text="{Binding CreateErrorMessage}">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}"
                               BasedOn="{StaticResource PtjFormErrorTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCreateError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Margin="0,12,0,0"
                           Text="Creating account...">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}"
                               BasedOn="{StaticResource PtjFormHelperTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCreating}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Margin="0,16,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button Command="{Binding CancelCreateCommand}"
                            Content="Cancel"
                            Style="{StaticResource PtjSecondaryButtonStyle}" />
                    <Button Margin="8,0,0,0"
                            Command="{Binding CreateAccountCommand}"
                            Content="Create Account"
                            Style="{StaticResource PtjPrimaryButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Margin="0,16,0,0">
            <Border.Style>
                <Style TargetType="{x:Type Border}"
                       BasedOn="{StaticResource PtjFormSectionStyle}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSelectedAccount}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsEditFormVisible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PtjFormSectionTitleTextStyle}"
                                   Text="{Binding SelectedAccount.Name}" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource PtjSecondaryTextStyle}"
                                   Text="Trading Account" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            VerticalAlignment="Top"
                            Style="{StaticResource PtjStatusBadgeStyle}">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}"
                                       BasedOn="{StaticResource PtjInactiveStatusTextStyle}">
                                    <Setter Property="Text" Value="Inactive" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedAccount.IsActive}" Value="True">
                                            <Setter Property="Text" Value="Active" />
                                            <Setter Property="Foreground" Value="{DynamicResource PtjSuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource PtjDetailLabelTextStyle}" Text="Name" />
                    <TextBlock Grid.Column="1" Style="{StaticResource PtjDetailValueTextStyle}" Text="{Binding SelectedAccount.Name}" />
                    <TextBlock Grid.Column="2" Margin="24,0,0,0" Style="{StaticResource PtjDetailLabelTextStyle}" Text="Provider" />
                    <TextBlock Grid.Column="3" Style="{StaticResource PtjDetailValueTextStyle}" Text="{Binding SelectedAccount.ProviderName, TargetNullValue=—}" />

                    <TextBlock Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource PtjDetailLabelTextStyle}" Text="Account Type" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Style="{StaticResource PtjDetailValueTextStyle}"
                               Text="{Binding SelectedAccount.AccountType, Converter={StaticResource AccountTypeDisplayConverter}}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Margin="24,10,0,0" Style="{StaticResource PtjDetailLabelTextStyle}" Text="External Account ID" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,10,0,0" Style="{StaticResource PtjDetailValueTextStyle}"
                               Text="{Binding SelectedAccount.ExternalAccountId, TargetNullValue=—}" />

                    <TextBlock Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource PtjDetailLabelTextStyle}" Text="Starting Balance" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" Style="{StaticResource PtjDetailValueTextStyle}"
                               Text="{Binding SelectedAccount.StartingBalance, StringFormat={}{0:N2}, TargetNullValue=—}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Margin="24,10,0,0" Style="{StaticResource PtjDetailLabelTextStyle}" Text="Currency" />
                    <TextBlock Grid.Row="2" Grid.Column="3" Margin="0,10,0,0" Style="{StaticResource PtjDetailValueTextStyle}" Text="{Binding SelectedAccount.Currency}" />

                    <TextBlock Grid.Row="3" Margin="0,10,0,0" Style="{StaticResource PtjDetailLabelTextStyle}" Text="Created" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" Style="{StaticResource PtjDetailValueTextStyle}"
                               Text="{Binding SelectedAccount.CreatedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm} UTC}" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Margin="24,10,0,0" Style="{StaticResource PtjDetailLabelTextStyle}" Text="Updated" />
                    <TextBlock Grid.Row="3" Grid.Column="3" Margin="0,10,0,0" Style="{StaticResource PtjDetailValueTextStyle}"
                               Text="{Binding SelectedAccount.UpdatedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm} UTC}" />
                </Grid>

                <StackPanel Margin="0,20,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button Command="{Binding CloseAccountDetailsCommand}"
                            Content="Close"
                            Style="{StaticResource PtjSecondaryButtonStyle}" />
                    <Button Margin="8,0,0,0"
                            Command="{Binding EditAccountCommand}"
                            CommandParameter="{Binding SelectedAccount.Id}"
                            Content="Edit"
                            Style="{StaticResource PtjEntityActionButtonStyle}" />
                    <Button Margin="8,0,0,0"
                            AutomationProperties.Name="More account actions"
                            interactions:EntityActionMenu.OpensContextMenu="True"
                            Style="{StaticResource PtjIconButtonStyle}"
                            Tag="{Binding}"
                            ToolTip="More account actions">
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}"
                                         Style="{StaticResource PtjEntityActionMenuStyle}">
                                <MenuItem Command="{Binding Tag.ActivateAccountCommand}"
                                          CommandParameter="{Binding Tag.SelectedAccountListItem}"
                                          Header="Activate">
                                    <MenuItem.Icon>
                                        <Viewbox><Path Data="{StaticResource PtjIconActivate}" Fill="{x:Null}"
                                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}"
                                                       StrokeLineJoin="Round" StrokeThickness="1.8" /></Viewbox>
                                    </MenuItem.Icon>
                                    <MenuItem.Style>
                                        <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource PtjLifecycleMenuItemStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag.SelectedAccount.IsActive}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                </MenuItem>
                                <MenuItem Command="{Binding Tag.DeactivateAccountCommand}"
                                          CommandParameter="{Binding Tag.SelectedAccountListItem}"
                                          Header="Deactivate">
                                    <MenuItem.Icon>
                                        <Viewbox><Path Data="{StaticResource PtjIconDeactivate}" Fill="{x:Null}"
                                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}"
                                                       StrokeLineJoin="Round" StrokeThickness="1.8" /></Viewbox>
                                    </MenuItem.Icon>
                                    <MenuItem.Style>
                                        <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource PtjLifecycleMenuItemStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag.SelectedAccount.IsActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                </MenuItem>
                                <Separator Style="{StaticResource PtjSeparatorStyle}" />
                                <MenuItem Command="{Binding Tag.DeleteAccountCommand}"
                                          CommandParameter="{Binding Tag.SelectedAccount.Id}"
                                          Header="Delete"
                                          Style="{StaticResource PtjDeleteMenuItemStyle}">
                                    <MenuItem.Icon>
                                        <Viewbox><Path Data="{StaticResource PtjIconDelete}" Fill="{x:Null}"
                                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}"
                                                       StrokeLineJoin="Round" StrokeThickness="1.8" /></Viewbox>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Viewbox Width="18" Height="18">
                            <Path Data="{StaticResource PtjIconMore}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  Stretch="Uniform" />
                        </Viewbox>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Margin="0,16,0,0">
            <Border.Style>
                <Style TargetType="{x:Type Border}"
                       BasedOn="{StaticResource PtjFormSectionStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditFormVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Style="{StaticResource PtjFormSectionTitleTextStyle}" Text="Edit Account" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource PtjSecondaryTextStyle}"
                           Text="Update account metadata without changing its identity or trade history." TextWrapping="Wrap" />
                <Grid Margin="0,16,0,0">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUpdating}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,8,12">
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource PtjFormLabelTextStyle}" Text="Name" />
                        <TextBox validation:FormValidation.IsInvalid="{Binding IsEditAccountNameInvalid}"
                                 Text="{Binding EditAccountName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PtjTextBoxStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,12">
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource PtjFormLabelTextStyle}" Text="Account Type" />
                        <ComboBox ItemsSource="{Binding AccountTypes}" SelectedItem="{Binding EditSelectedAccountType}" Style="{StaticResource PtjComboBoxStyle}">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource AccountTypeDisplayConverter}}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,8,12">
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource PtjFormLabelTextStyle}" Text="Provider (Optional)" />
                        <TextBox Text="{Binding EditProviderName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PtjTextBoxStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,12">
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource PtjFormLabelTextStyle}" Text="External Account ID (Optional)" />
                        <TextBox Text="{Binding EditExternalAccountId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PtjTextBoxStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,0,8,0">
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource PtjFormLabelTextStyle}" Text="Currency" />
                        <TextBox validation:FormValidation.IsInvalid="{Binding IsEditCurrencyInvalid}"
                                 Text="{Binding EditCurrency, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PtjTextBoxStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource PtjFormLabelTextStyle}" Text="Starting Balance (Optional)" />
                        <TextBox validation:FormValidation.IsInvalid="{Binding IsEditStartingBalanceInvalid}"
                                 Text="{Binding EditStartingBalanceText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PtjTextBoxStyle}" />
                        <TextBlock Style="{StaticResource PtjFormHelperTextStyle}" Text="Opening reference only; this is not a current balance." />
                    </StackPanel>
                </Grid>
                <TextBlock Margin="0,12,0,0" Text="{Binding EditErrorMessage}" Style="{StaticResource PtjFormErrorTextStyle}" />
                <TextBlock Margin="0,12,0,0" Text="Saving changes...">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PtjFormHelperTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsUpdating}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Command="{Binding CancelEditCommand}" Content="Cancel" Style="{StaticResource PtjSecondaryButtonStyle}" />
                    <Button Margin="8,0,0,0" Command="{Binding SaveChangesCommand}" Content="Save Changes" Style="{StaticResource PtjPrimaryButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Margin="0,12,0,12">
            <TextBlock Text="Loading accounts...">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}"
                           BasedOn="{StaticResource PtjCaptionTextStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="{Binding ErrorMessage}">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}"
                           BasedOn="{StaticResource PtjSecondaryTextStyle}">
                        <Setter Property="Foreground" Value="{DynamicResource PtjWarningBrush}" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="{Binding LifecycleErrorMessage}">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}"
                           BasedOn="{StaticResource PtjSecondaryTextStyle}">
                        <Setter Property="Foreground" Value="{DynamicResource PtjWarningBrush}" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasLifecycleError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding ActionErrorMessage}">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource PtjSecondaryTextStyle}">
                        <Setter Property="Foreground" Value="{DynamicResource PtjWarningBrush}" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding HasActionError}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <Grid>
            <Border Padding="24"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top">
                <Border.Style>
                    <Style TargetType="{x:Type Border}"
                           BasedOn="{StaticResource PtjCardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                    <Condition Binding="{Binding HasAccounts}" Value="False" />
                                    <Condition Binding="{Binding HasError}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock HorizontalAlignment="Center"
                           Style="{StaticResource PtjSecondaryTextStyle}"
                           Text="No trading accounts yet." />
            </Border>

            <Grid>
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAccounts}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="16,0,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="0.65*" />
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="0.75*" />
                        <ColumnDefinition Width="2.2*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Style="{StaticResource AccountColumnHeaderStyle}"
                               Text="Name" />
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource AccountColumnHeaderStyle}"
                               Text="Account Type" />
                    <TextBlock Grid.Column="2"
                               Style="{StaticResource AccountColumnHeaderStyle}"
                               Text="Provider" />
                    <TextBlock Grid.Column="3"
                               Style="{StaticResource AccountColumnHeaderStyle}"
                               Text="Currency" />
                    <TextBlock Grid.Column="4"
                               HorizontalAlignment="Right"
                               Style="{StaticResource AccountColumnHeaderStyle}"
                               Text="Starting Balance" />
                    <TextBlock Grid.Column="5"
                               HorizontalAlignment="Right"
                               Style="{StaticResource AccountColumnHeaderStyle}"
                               Text="Status" />
                    <TextBlock Grid.Column="6"
                               HorizontalAlignment="Right"
                               Style="{StaticResource AccountColumnHeaderStyle}"
                               Text="Actions" />
                </Grid>

                <ItemsControl Grid.Row="1"
                              HorizontalContentAlignment="Stretch"
                              ItemsSource="{Binding Accounts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border MinHeight="52"
                                        Margin="0,0,0,8"
                                        Padding="16,12"
                                        Style="{StaticResource PtjCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="0.65*" />
                                            <ColumnDefinition Width="1.3*" />
                                            <ColumnDefinition Width="0.75*" />
                                            <ColumnDefinition Width="2.2*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   FontWeight="SemiBold"
                                                   Style="{StaticResource AccountCellTextStyle}"
                                                   Text="{Binding Name}" />
                                        <TextBlock Grid.Column="1"
                                                   Style="{StaticResource AccountCellTextStyle}"
                                                   Text="{Binding AccountType, Converter={StaticResource AccountTypeDisplayConverter}}" />
                                        <TextBlock Grid.Column="2"
                                                   Style="{StaticResource AccountCellTextStyle}"
                                                   Text="{Binding ProviderName, TargetNullValue=—}" />
                                        <TextBlock Grid.Column="3"
                                                   Style="{StaticResource AccountCellTextStyle}"
                                                   Text="{Binding Currency}" />
                                        <TextBlock Grid.Column="4"
                                                   HorizontalAlignment="Right"
                                                   Style="{StaticResource AccountCellTextStyle}"
                                                   Text="{Binding StartingBalance, StringFormat={}{0:N2}, TargetNullValue=—}" />
                                        <TextBlock Grid.Column="5"
                                                   HorizontalAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}"
                                                       BasedOn="{StaticResource PtjCaptionTextStyle}">
                                                    <Setter Property="Text" Value="Inactive" />
                                                    <Setter Property="Foreground" Value="{DynamicResource PtjTextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Text" Value="Active" />
                                                            <Setter Property="Foreground" Value="{DynamicResource PtjSuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <StackPanel Grid.Column="6"
                                                    Margin="8,0,0,0"
                                                    HorizontalAlignment="Right"
                                                    Orientation="Horizontal">
                                            <Button Command="{Binding DataContext.ViewAccountCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding Id}"
                                                    Style="{StaticResource PtjEntityActionButtonStyle}"
                                                    ToolTip="View account details">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="14" Height="14">
                                                        <Path Data="{StaticResource PtjIconView}"
                                                              Fill="{x:Null}"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                              StrokeLineJoin="Round"
                                                              StrokeThickness="1.7" />
                                                    </Viewbox>
                                                    <TextBlock Margin="6,0,0,0" Text="View" />
                                                </StackPanel>
                                            </Button>
                                            <Button Margin="4,0,0,0"
                                                    Command="{Binding DataContext.EditAccountCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding Id}"
                                                    Style="{StaticResource PtjEntityActionButtonStyle}"
                                                    ToolTip="Edit account">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="14" Height="14">
                                                        <Path Data="{StaticResource PtjIconEdit}"
                                                              Fill="{x:Null}"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                              StrokeLineJoin="Round"
                                                              StrokeThickness="1.7" />
                                                    </Viewbox>
                                                    <TextBlock Margin="6,0,0,0" Text="Edit" />
                                                </StackPanel>
                                            </Button>
                                            <Button Margin="4,0,0,0"
                                                    AutomationProperties.Name="More account actions"
                                                    interactions:EntityActionMenu.OpensContextMenu="True"
                                                    Style="{StaticResource PtjIconButtonStyle}"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    ToolTip="More account actions">
                                                <Button.ContextMenu>
                                                    <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}"
                                                                 Style="{StaticResource PtjEntityActionMenuStyle}">
                                                        <MenuItem Command="{Binding Tag.ActivateAccountCommand}"
                                                                  CommandParameter="{Binding DataContext}"
                                                                  Header="Activate">
                                                            <MenuItem.Icon>
                                                                <Viewbox><Path Data="{StaticResource PtjIconActivate}" Fill="{x:Null}"
                                                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}"
                                                                               StrokeLineJoin="Round" StrokeThickness="1.8" /></Viewbox>
                                                            </MenuItem.Icon>
                                                            <MenuItem.Style>
                                                                <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource PtjLifecycleMenuItemStyle}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers><DataTrigger Binding="{Binding DataContext.IsActive}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </MenuItem.Style>
                                                        </MenuItem>
                                                        <MenuItem Command="{Binding Tag.DeactivateAccountCommand}"
                                                                  CommandParameter="{Binding DataContext}"
                                                                  Header="Deactivate">
                                                            <MenuItem.Icon>
                                                                <Viewbox><Path Data="{StaticResource PtjIconDeactivate}" Fill="{x:Null}"
                                                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}"
                                                                               StrokeLineJoin="Round" StrokeThickness="1.8" /></Viewbox>
                                                            </MenuItem.Icon>
                                                            <MenuItem.Style>
                                                                <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource PtjLifecycleMenuItemStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers><DataTrigger Binding="{Binding DataContext.IsActive}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </MenuItem.Style>
                                                        </MenuItem>
                                                        <Separator Style="{StaticResource PtjSeparatorStyle}" />
                                                        <MenuItem Command="{Binding Tag.DeleteAccountCommand}"
                                                                  CommandParameter="{Binding DataContext.Id}"
                                                                  Header="Delete"
                                                                  Style="{StaticResource PtjDeleteMenuItemStyle}">
                                                            <MenuItem.Icon>
                                                                <Viewbox><Path Data="{StaticResource PtjIconDelete}" Fill="{x:Null}"
                                                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}"
                                                                               StrokeLineJoin="Round" StrokeThickness="1.8" /></Viewbox>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <Viewbox Width="18" Height="18">
                                                    <Path Data="{StaticResource PtjIconMore}"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                          Stretch="Uniform" />
                                                </Viewbox>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
