<UserControl x:Class="PersonalTradingJournal.Desktop.Views.Accounts.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:PersonalTradingJournal.Desktop.Converters">
    <UserControl.Resources>
        <converters:TradingAccountTypeDisplayConverter x:Key="AccountTypeDisplayConverter" />

        <Style x:Key="AccountColumnHeaderStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource PtjCaptionTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="AccountCellTextStyle"
               TargetType="{x:Type TextBlock}"
               BasedOn="{StaticResource PtjBodyTextStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center"
                       Style="{StaticResource PtjSecondaryTextStyle}"
                       Text="Trading accounts used to organize journal activity."
                       TextWrapping="Wrap" />

            <Button Grid.Column="1"
                    Margin="16,0,0,0"
                    Command="{Binding RefreshCommand}"
                    Content="Refresh"
                    Style="{StaticResource PtjButtonStyle}" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,12,0,12">
            <TextBlock Text="Loading accounts...">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}"
                           BasedOn="{StaticResource PtjCaptionTextStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="{Binding ErrorMessage}">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}"
                           BasedOn="{StaticResource PtjSecondaryTextStyle}">
                        <Setter Property="Foreground" Value="{StaticResource PtjWarningBrush}" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <Grid Grid.Row="2">
            <Border Padding="24"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top">
                <Border.Style>
                    <Style TargetType="{x:Type Border}"
                           BasedOn="{StaticResource PtjCardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                    <Condition Binding="{Binding HasAccounts}" Value="False" />
                                    <Condition Binding="{Binding HasError}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock HorizontalAlignment="Center"
                           Style="{StaticResource PtjSecondaryTextStyle}"
                           Text="No trading accounts yet." />
            </Border>

            <Grid>
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAccounts}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="16,0,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="0.8*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Style="{StaticResource AccountColumnHeaderStyle}"
                               Text="Name" />
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource AccountColumnHeaderStyle}"
                               Text="Account Type" />
                    <TextBlock Grid.Column="2"
                               Style="{StaticResource AccountColumnHeaderStyle}"
                               Text="Provider" />
                    <TextBlock Grid.Column="3"
                               Style="{StaticResource AccountColumnHeaderStyle}"
                               Text="Currency" />
                    <TextBlock Grid.Column="4"
                               HorizontalAlignment="Right"
                               Style="{StaticResource AccountColumnHeaderStyle}"
                               Text="Starting Balance" />
                    <TextBlock Grid.Column="5"
                               HorizontalAlignment="Right"
                               Style="{StaticResource AccountColumnHeaderStyle}"
                               Text="Status" />
                </Grid>

                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              PanningMode="VerticalOnly">
                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}"
                               BasedOn="{StaticResource PtjScrollBarStyle}" />
                    </ScrollViewer.Resources>

                    <ItemsControl HorizontalContentAlignment="Stretch"
                                  ItemsSource="{Binding Accounts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border MinHeight="52"
                                        Margin="0,0,0,8"
                                        Padding="16,12"
                                        Style="{StaticResource PtjCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="1.6*" />
                                            <ColumnDefinition Width="0.8*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="0.8*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   FontWeight="SemiBold"
                                                   Style="{StaticResource AccountCellTextStyle}"
                                                   Text="{Binding Name}" />
                                        <TextBlock Grid.Column="1"
                                                   Style="{StaticResource AccountCellTextStyle}"
                                                   Text="{Binding AccountType, Converter={StaticResource AccountTypeDisplayConverter}}" />
                                        <TextBlock Grid.Column="2"
                                                   Style="{StaticResource AccountCellTextStyle}"
                                                   Text="{Binding ProviderName, TargetNullValue=—}" />
                                        <TextBlock Grid.Column="3"
                                                   Style="{StaticResource AccountCellTextStyle}"
                                                   Text="{Binding Currency}" />
                                        <TextBlock Grid.Column="4"
                                                   HorizontalAlignment="Right"
                                                   Style="{StaticResource AccountCellTextStyle}"
                                                   Text="{Binding StartingBalance, StringFormat={}{0:N2}, TargetNullValue=—}" />
                                        <TextBlock Grid.Column="5"
                                                   HorizontalAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}"
                                                       BasedOn="{StaticResource PtjCaptionTextStyle}">
                                                    <Setter Property="Text" Value="Inactive" />
                                                    <Setter Property="Foreground" Value="{StaticResource PtjTextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Text" Value="Active" />
                                                            <Setter Property="Foreground" Value="{StaticResource PtjSuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
