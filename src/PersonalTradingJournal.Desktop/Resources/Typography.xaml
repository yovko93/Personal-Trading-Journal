<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="PtjFontFamily">Segoe UI</FontFamily>

    <Style x:Key="PtjPageTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource PtjFontFamily}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PtjTextPrimaryBrush}" />
    </Style>

    <Style x:Key="PtjSectionTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource PtjFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PtjTextPrimaryBrush}" />
    </Style>

    <Style x:Key="PtjBodyTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource PtjFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource PtjTextPrimaryBrush}" />
    </Style>

    <Style x:Key="PtjSecondaryTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource PtjFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource PtjTextSecondaryBrush}" />
    </Style>

    <Style x:Key="PtjCaptionTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource PtjFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource PtjTextMutedBrush}" />
    </Style>

    <Style x:Key="PtjMetricValueTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource PtjPageTitleTextStyle}">
        <Setter Property="FontSize" Value="28" />
    </Style>
</ResourceDictionary>
