<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="PtjWindowStyle" TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{StaticResource PtjBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PtjTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource PtjFontFamily}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="PtjButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource PtjSurfaceElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PtjBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource PtjTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource PtjFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="{StaticResource PtjButtonPadding}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource PtjCornerRadiusSm}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <Border x:Name="FocusIndicator"
                                Margin="2"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{StaticResource PtjCornerRadiusSm}"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusIndicator"
                                    Property="BorderBrush"
                                    Value="{StaticResource PtjTextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PtjPrimaryButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource PtjButtonStyle}">
        <Setter Property="Background" Value="{StaticResource PtjAccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PtjAccentBrush}" />
    </Style>

    <Style x:Key="PtjCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource PtjSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PtjBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PtjCornerRadiusMd}" />
        <Setter Property="Padding" Value="{StaticResource PtjCardPadding}" />
    </Style>

    <Style x:Key="PtjSeparatorStyle" TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{StaticResource PtjBorderBrush}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Background="{TemplateBinding Background}"
                            Height="{TemplateBinding Height}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
