<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:PersonalTradingJournal.Desktop.Converters"
                    xmlns:validation="clr-namespace:PersonalTradingJournal.Desktop.Validation">
    <converters:NavigationIconConverter x:Key="PtjNavigationIconConverter" />

    <Style x:Key="PtjWindowStyle" TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{DynamicResource PtjBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PtjTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource PtjFontFamily}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="PtjButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource PtjSurfaceElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PtjBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource PtjTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource PtjFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="{StaticResource PtjButtonPadding}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource PtjCornerRadiusSm}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <Border x:Name="FocusIndicator"
                                Margin="2"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{StaticResource PtjCornerRadiusSm}"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusIndicator"
                                    Property="BorderBrush"
                                    Value="{DynamicResource PtjTextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PtjPrimaryButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource PtjButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource PtjAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PtjAccentBrush}" />
    </Style>

    <Style x:Key="PtjSecondaryButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource PtjButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PtjTextSecondaryBrush}" />
    </Style>

    <Style x:Key="PtjDangerButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource PtjButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource PtjDangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PtjDangerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PtjSurfaceBrush}" />
    </Style>

    <Style x:Key="PtjIconButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource PtjButtonStyle}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PtjTextSecondaryBrush}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PtjSurfaceElevatedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PtjTextPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PtjEntityActionButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource PtjSecondaryButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="PtjEntityActionMenuItemStyle" TargetType="{x:Type MenuItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PtjTextPrimaryBrush}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="StaysOpenOnClick" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Border x:Name="MenuItemChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="{StaticResource PtjCornerRadiusSm}">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Width="16"
                                              Height="16"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              ContentSource="Icon" />
                            <ContentPresenter Grid.Column="1"
                                              Margin="8,0,14,0"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True" />
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource PtjTextMutedBrush}"
                                       Text="{TemplateBinding InputGestureText}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="MenuItemChrome"
                                    Property="Background"
                                    Value="{DynamicResource PtjSurfaceElevatedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="MenuItemChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource PtjAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="MenuItemChrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PtjLifecycleMenuItemStyle"
           TargetType="{x:Type MenuItem}"
           BasedOn="{StaticResource PtjEntityActionMenuItemStyle}">
        <Setter Property="Foreground" Value="{DynamicResource PtjTextSecondaryBrush}" />
    </Style>

    <Style x:Key="PtjDeleteMenuItemStyle"
           TargetType="{x:Type MenuItem}"
           BasedOn="{StaticResource PtjEntityActionMenuItemStyle}">
        <Setter Property="Foreground" Value="{DynamicResource PtjDangerBrush}" />
    </Style>

    <Style x:Key="PtjEntityActionMenuSeparatorStyle"
           TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{DynamicResource PtjBorderBrush}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="2,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Height="{TemplateBinding Height}"
                            Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PtjEntityActionMenuStyle" TargetType="{x:Type ContextMenu}">
        <Style.Resources>
            <Style TargetType="{x:Type MenuItem}"
                   BasedOn="{StaticResource PtjEntityActionMenuItemStyle}" />
            <Style TargetType="{x:Type Separator}"
                   BasedOn="{StaticResource PtjEntityActionMenuSeparatorStyle}" />
        </Style.Resources>
        <Setter Property="Background" Value="{DynamicResource PtjSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PtjBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource PtjTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource PtjFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Placement" Value="Bottom" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border MinWidth="168"
                            Padding="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource PtjCornerRadiusMd}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10"
                                              Color="{DynamicResource PtjColorBorder}"
                                              Opacity="0.32"
                                              ShadowDepth="2" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="PtjValidationErrorTemplate">
        <AdornedElementPlaceholder />
    </ControlTemplate>

    <Style x:Key="PtjTextBoxStyle" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource PtjSurfaceElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PtjBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource PtjTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource PtjFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Validation.ErrorTemplate"
                Value="{StaticResource PtjValidationErrorTemplate}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="TextBoxChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource PtjCornerRadiusMd}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4"
                                              Color="{DynamicResource PtjColorBorder}"
                                              Opacity="0.14"
                                              ShadowDepth="0" />
                        </Border.Effect>
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TextBoxChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource PtjTextMutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="TextBoxChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource PtjAccentBrush}" />
                            <Setter TargetName="TextBoxChrome" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="6"
                                                      Color="{DynamicResource PtjColorAccent}"
                                                      Opacity="0.28"
                                                      ShadowDepth="0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="TextBoxChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource PtjDangerBrush}" />
                            <Setter TargetName="TextBoxChrome" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="6"
                                                      Color="{DynamicResource PtjColorDanger}"
                                                      Opacity="0.32"
                                                      ShadowDepth="0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="validation:FormValidation.IsInvalid" Value="True">
                            <Setter TargetName="TextBoxChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource PtjDangerBrush}" />
                            <Setter TargetName="TextBoxChrome" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="6"
                                                      Color="{DynamicResource PtjColorDanger}"
                                                      Opacity="0.32"
                                                      ShadowDepth="0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PtjComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Background" Value="{DynamicResource PtjSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PtjTextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="10,6" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource PtjSurfaceElevatedBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource PtjAccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource PtjTextSecondaryBrush}" />
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PtjComboBoxStyle" TargetType="{x:Type ComboBox}">
        <Setter Property="Background" Value="{DynamicResource PtjSurfaceElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PtjBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource PtjTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource PtjFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource PtjComboBoxItemStyle}" />
        <Setter Property="MaxDropDownHeight" Value="240" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Validation.ErrorTemplate"
                Value="{StaticResource PtjValidationErrorTemplate}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border x:Name="ComboBoxChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource PtjCornerRadiusMd}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4"
                                                  Color="{DynamicResource PtjColorBorder}"
                                                  Opacity="0.14"
                                                  ShadowDepth="0" />
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  IsHitTestVisible="False"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                  TextElement.Foreground="{DynamicResource PtjTextPrimaryBrush}" />
                                <Path Grid.Column="1"
                                      Width="8"
                                      Height="5"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                      Fill="{DynamicResource PtjTextSecondaryBrush}"
                                      IsHitTestVisible="False"
                                      Stretch="Fill" />
                            </Grid>
                        </Border>
                        <ToggleButton Background="Transparent"
                                      BorderThickness="0"
                                      ClickMode="Press"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, ElementName=ComboBoxChrome}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource PtjSurfaceBrush}"
                                    BorderBrush="{DynamicResource PtjBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource PtjCornerRadiusSm}">
                                <ScrollViewer CanContentScroll="True"
                                              SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ComboBoxChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource PtjTextMutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ComboBoxChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource PtjAccentBrush}" />
                            <Setter TargetName="ComboBoxChrome" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="6"
                                                      Color="{DynamicResource PtjColorAccent}"
                                                      Opacity="0.28"
                                                      ShadowDepth="0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="ComboBoxChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource PtjDangerBrush}" />
                            <Setter TargetName="ComboBoxChrome" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="6"
                                                      Color="{DynamicResource PtjColorDanger}"
                                                      Opacity="0.32"
                                                      ShadowDepth="0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="validation:FormValidation.IsInvalid" Value="True">
                            <Setter TargetName="ComboBoxChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource PtjDangerBrush}" />
                            <Setter TargetName="ComboBoxChrome" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="6"
                                                      Color="{DynamicResource PtjColorDanger}"
                                                      Opacity="0.32"
                                                      ShadowDepth="0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PtjNavigationButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource PtjTextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource PtjFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="{StaticResource PtjButtonPadding}" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="NavigationChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource PtjCornerRadiusSm}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <Border x:Name="FocusIndicator"
                                Margin="2"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{StaticResource PtjCornerRadiusSm}"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavigationChrome"
                                    Property="Background"
                                    Value="{DynamicResource PtjSurfaceElevatedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PtjTextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="NavigationChrome"
                                    Property="Background"
                                    Value="{DynamicResource PtjBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusIndicator"
                                    Property="BorderBrush"
                                    Value="{DynamicResource PtjAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="NavigationChrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource PtjSurfaceElevatedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PtjAccentBrush}" />
                <Setter Property="BorderThickness" Value="3,0,0,0" />
                <Setter Property="Foreground" Value="{DynamicResource PtjTextPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PtjNavigationSectionButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource PtjTextMutedBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource PtjFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="12,16,12,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="SectionChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource PtjCornerRadiusSm}">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                            <Path Grid.Column="1"
                                  Width="8"
                                  Height="8"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  Data="{StaticResource PtjIconChevron}"
                                  Fill="{x:Null}"
                                  RenderTransformOrigin="0.5,0.5"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeLineJoin="Round"
                                  StrokeThickness="1.8"
                                  Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="{x:Type Path}">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="0" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SectionChrome"
                                    Property="Background"
                                    Value="{DynamicResource PtjSurfaceElevatedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PtjTextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="SectionChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource PtjAccentBrush}" />
                            <Setter TargetName="SectionChrome" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PtjScrollBarThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Background" Value="{DynamicResource PtjBorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="ThumbChrome"
                            Margin="2"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource PtjCornerRadiusSm}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbChrome"
                                    Property="Background"
                                    Value="{DynamicResource PtjTextMutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbChrome"
                                    Property="Background"
                                    Value="{DynamicResource PtjTextSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PtjScrollBarPageButtonStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PtjScrollBarStyle" TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="12" />
        <Setter Property="Background" Value="{DynamicResource PtjSurfaceBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Border Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track"
                               IsDirectionReversed="True"
                               Orientation="{TemplateBinding Orientation}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="DecreasePageButton"
                                              Command="{x:Static ScrollBar.PageUpCommand}"
                                              Style="{StaticResource PtjScrollBarPageButtonStyle}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource PtjScrollBarThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="IncreasePageButton"
                                              Command="{x:Static ScrollBar.PageDownCommand}"
                                              Style="{StaticResource PtjScrollBarPageButtonStyle}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track"
                                    Property="IsDirectionReversed"
                                    Value="False" />
                            <Setter TargetName="DecreasePageButton"
                                    Property="Command"
                                    Value="{x:Static ScrollBar.PageLeftCommand}" />
                            <Setter TargetName="IncreasePageButton"
                                    Property="Command"
                                    Value="{x:Static ScrollBar.PageRightCommand}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="12" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PtjCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource PtjSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PtjBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PtjCornerRadiusMd}" />
        <Setter Property="Padding" Value="{StaticResource PtjCardPadding}" />
    </Style>

    <Style x:Key="PtjFormSectionStyle"
           TargetType="{x:Type Border}"
           BasedOn="{StaticResource PtjCardStyle}">
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="PtjFormSectionTitleTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource PtjSectionTitleTextStyle}">
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="PtjFormLabelTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource PtjBodyTextStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PtjFormOptionalTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource PtjCaptionTextStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PtjFormHelperTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource PtjCaptionTextStyle}">
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PtjFormErrorTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource PtjSecondaryTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource PtjDangerBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PtjFormSuccessTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource PtjSecondaryTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource PtjSuccessBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PtjDetailLabelTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource PtjCaptionTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PtjDetailValueTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource PtjBodyTextStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PtjStatusBadgeStyle" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Background" Value="{DynamicResource PtjSurfaceElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PtjBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PtjCornerRadiusSm}" />
    </Style>

    <Style x:Key="PtjActiveStatusTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource PtjCaptionTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource PtjSuccessBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PtjInactiveStatusTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource PtjCaptionTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource PtjTextSecondaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PtjSeparatorStyle" TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{DynamicResource PtjBorderBrush}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Background="{TemplateBinding Background}"
                            Height="{TemplateBinding Height}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PtjThemeToggleStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="60" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Background" Value="{DynamicResource PtjSurfaceElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PtjBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource PtjTextSecondaryBrush}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid Width="{TemplateBinding Width}"
                          Height="{TemplateBinding Height}">
                        <Border x:Name="Track"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15" />
                        <Border x:Name="Thumb"
                                Width="26"
                                Height="26"
                                Margin="2"
                                HorizontalAlignment="Right"
                                Background="{DynamicResource PtjSurfaceBrush}"
                                BorderBrush="{DynamicResource PtjAccentBrush}"
                                BorderThickness="1"
                                CornerRadius="13" />
                        <Grid IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SunIcon"
                                       Grid.Column="0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe UI Symbol"
                                       FontSize="14"
                                       Foreground="{DynamicResource PtjWarningBrush}"
                                       Opacity="0.55"
                                       Text="☀" />
                            <TextBlock x:Name="MoonIcon"
                                       Grid.Column="1"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe UI Symbol"
                                       FontSize="15"
                                       Foreground="{DynamicResource PtjTextPrimaryBrush}"
                                       Text="☾" />
                        </Grid>
                        <Border x:Name="FocusIndicator"
                                Margin="-2"
                                BorderBrush="{x:Null}"
                                BorderThickness="1"
                                CornerRadius="17"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Thumb"
                                    Property="HorizontalAlignment"
                                    Value="Left" />
                            <Setter TargetName="SunIcon" Property="Opacity" Value="1" />
                            <Setter TargetName="MoonIcon" Property="Opacity" Value="0.55" />
                            <Setter TargetName="MoonIcon"
                                    Property="Foreground"
                                    Value="{DynamicResource PtjTextMutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusIndicator"
                                    Property="BorderBrush"
                                    Value="{DynamicResource PtjAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
