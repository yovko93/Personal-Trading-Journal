<Window x:Class="PersonalTradingJournal.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PersonalTradingJournal.Desktop"
        mc:Ignorable="d"
        Title="{Binding ApplicationTitle}"
        Width="1280"
        Height="800"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource PtjWindowStyle}">
    <Window.Resources>
        <Style x:Key="PtjNavigationItemsControlStyle"
               TargetType="{x:Type ItemsControl}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <DataTemplate x:Key="PtjNavigationItemTemplate">
            <Button AutomationProperties.Name="{Binding Title}"
                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    CommandParameter="{Binding Destination}"
                    Style="{StaticResource PtjNavigationButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                        <Path Data="{Binding IconKey, Converter={StaticResource PtjNavigationIconConverter}}"
                              Fill="{x:Null}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="1.8" />
                    </Viewbox>
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding Title}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="PtjNavigationSectionTemplate">
            <StackPanel>
                <Button AutomationProperties.Name="{Binding Title}"
                        Command="{Binding ToggleCommand}"
                        Content="{Binding Title}"
                        Style="{StaticResource PtjNavigationSectionButtonStyle}" />
                <ItemsControl Margin="16,0,0,0"
                              ItemTemplate="{StaticResource PtjNavigationItemTemplate}"
                              ItemsSource="{Binding Items}">
                    <ItemsControl.Style>
                        <Style TargetType="{x:Type ItemsControl}"
                               BasedOn="{StaticResource PtjNavigationItemsControlStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource PtjSidebarBrush}"
                BorderBrush="{DynamicResource PtjBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="24,24,24,20"
                        BorderBrush="{DynamicResource PtjBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <TextBlock Style="{StaticResource PtjSectionTitleTextStyle}"
                               Foreground="{DynamicResource PtjSidebarTextBrush}"
                               Text="{Binding ApplicationTitle}"
                               TextWrapping="Wrap" />
                </Border>

                <ScrollViewer Grid.Row="1"
                              Padding="8"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              PanningMode="VerticalOnly">
                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}"
                               BasedOn="{StaticResource PtjScrollBarStyle}" />
                    </ScrollViewer.Resources>
                    <StackPanel>
                        <ItemsControl ItemTemplate="{StaticResource PtjNavigationItemTemplate}"
                                      ItemsSource="{Binding TopNavigationItems}"
                                      Style="{StaticResource PtjNavigationItemsControlStyle}" />
                        <ItemsControl ItemTemplate="{StaticResource PtjNavigationSectionTemplate}"
                                      ItemsSource="{Binding NavigationSections}"
                                      Style="{StaticResource PtjNavigationItemsControlStyle}" />
                        <Border Height="1"
                                Margin="12,16,12,8"
                                Background="{DynamicResource PtjBorderBrush}" />
                        <ItemsControl ItemTemplate="{StaticResource PtjNavigationItemTemplate}"
                                      ItemsSource="{Binding BottomNavigationItems}"
                                      Style="{StaticResource PtjNavigationItemsControlStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid x:Name="PageContentArea" Grid.Column="1"
              Background="{DynamicResource PtjBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="PageHeader" Padding="32,12"
                    Grid.IsSharedSizeScope="True"
                    BorderBrush="{DynamicResource PtjBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid x:Name="PageHeaderLayout">
                    <Grid.ColumnDefinitions>
                        <!-- Equal side slots keep the title centered on the content, not on
                             the space left over after the theme control. -->
                        <ColumnDefinition Width="Auto" SharedSizeGroup="HeaderAction" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="HeaderAction" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PageTitleTreatment" VerticalAlignment="Center" CornerRadius="10">
                        <Border.Style><Style TargetType="Border">
                            <Setter Property="Grid.Column" Value="1" /><Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="MaxWidth" Value="760" /><Setter Property="Padding" Value="18,7" />
                            <Setter Property="Background" Value="{DynamicResource PtjPageHeaderSurfaceBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource PtjPageHeaderBorderBrush}" /><Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers><DataTrigger Binding="{Binding CurrentDestination}" Value="Breakdown">
                                <Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="2" />
                                <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="MaxWidth" Value="Infinity" />
                                <Setter Property="Padding" Value="0,3" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
                            </DataTrigger></Style.Triggers>
                        </Style></Border.Style>
                        <StackPanel>
                            <TextBlock x:Name="PageTitleText"
                                       AutomationProperties.HeadingLevel="Level1">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource PtjShellPageTitleTextStyle}">
                                    <Setter Property="Text" Value="{Binding PageTitle}" />
                                    <Style.Triggers><DataTrigger Binding="{Binding CurrentDestination}" Value="Breakdown">
                                        <Setter Property="Text" Value="Breakdown Analytics" /><Setter Property="TextAlignment" Value="Left" />
                                        <Setter Property="FontSize" Value="28" />
                                        <Setter Property="Foreground" Value="{DynamicResource PtjTextPrimaryBrush}" />
                                    </DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                            <TextBlock x:Name="BreakdownSubtitle" Text="Understand where your results come from" Margin="0,2,0,0"
                                       TextWrapping="Wrap" Foreground="{DynamicResource PtjTextSecondaryBrush}">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource PtjBodyTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding CurrentDestination}" Value="Breakdown"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                            <Border Width="32" Height="2" Margin="0,5,0,0" CornerRadius="1"
                                    HorizontalAlignment="Center" IsHitTestVisible="False"
                                    Background="{DynamicResource PtjAccentBrush}">
                                <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding CurrentDestination}" Value="Breakdown"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                            </Border>
                        </StackPanel>
                    </Border>
                    <ToggleButton x:Name="PageThemeToggle" Grid.Column="2" Margin="12,0,0,0"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  AutomationProperties.Name="{Binding ThemeToggleToolTip}"
                                  Command="{Binding ToggleThemeCommand}"
                                  IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                                  Style="{StaticResource PtjThemeToggleStyle}"
                                  ToolTip="{Binding ThemeToggleToolTip}" />
                </Grid>
            </Border>

            <Border Grid.Row="1">
                <Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="32,24" />
                    <Style.Triggers><DataTrigger Binding="{Binding CurrentDestination}" Value="Breakdown"><Setter Property="Padding" Value="32,16" /></DataTrigger></Style.Triggers>
                </Style></Border.Style>
                <ContentControl HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Content="{Binding CurrentContentViewModel}" />
            </Border>
        </Grid>
    </Grid>
</Window>
