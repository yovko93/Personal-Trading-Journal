<Window x:Class="PersonalTradingJournal.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PersonalTradingJournal.Desktop"
        mc:Ignorable="d"
        Title="{Binding ApplicationTitle}"
        Width="1280"
        Height="800"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource PtjWindowStyle}">
    <Window.Resources>
        <Style x:Key="PtjNavigationItemsControlStyle"
               TargetType="{x:Type ItemsControl}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <DataTemplate x:Key="PtjNavigationItemTemplate">
            <Button AutomationProperties.Name="{Binding Title}"
                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    CommandParameter="{Binding Destination}"
                    Style="{StaticResource PtjNavigationButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                        <Path Data="{Binding IconKey, Converter={StaticResource PtjNavigationIconConverter}}"
                              Fill="{x:Null}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="1.8" />
                    </Viewbox>
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding Title}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="PtjNavigationSectionTemplate">
            <StackPanel>
                <Button AutomationProperties.Name="{Binding Title}"
                        Command="{Binding ToggleCommand}"
                        Content="{Binding Title}"
                        Style="{StaticResource PtjNavigationSectionButtonStyle}" />
                <ItemsControl Margin="16,0,0,0"
                              ItemTemplate="{StaticResource PtjNavigationItemTemplate}"
                              ItemsSource="{Binding Items}">
                    <ItemsControl.Style>
                        <Style TargetType="{x:Type ItemsControl}"
                               BasedOn="{StaticResource PtjNavigationItemsControlStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource PtjSurfaceBrush}"
                BorderBrush="{DynamicResource PtjBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="24,24,24,20"
                        BorderBrush="{DynamicResource PtjBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <TextBlock Style="{StaticResource PtjSectionTitleTextStyle}"
                               Text="{Binding ApplicationTitle}"
                               TextWrapping="Wrap" />
                </Border>

                <ScrollViewer Grid.Row="1"
                              Padding="8"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              PanningMode="VerticalOnly">
                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}"
                               BasedOn="{StaticResource PtjScrollBarStyle}" />
                    </ScrollViewer.Resources>
                    <StackPanel>
                        <ItemsControl ItemTemplate="{StaticResource PtjNavigationItemTemplate}"
                                      ItemsSource="{Binding TopNavigationItems}"
                                      Style="{StaticResource PtjNavigationItemsControlStyle}" />
                        <ItemsControl ItemTemplate="{StaticResource PtjNavigationSectionTemplate}"
                                      ItemsSource="{Binding NavigationSections}"
                                      Style="{StaticResource PtjNavigationItemsControlStyle}" />
                        <Border Height="1"
                                Margin="12,16,12,8"
                                Background="{DynamicResource PtjBorderBrush}" />
                        <ItemsControl ItemTemplate="{StaticResource PtjNavigationItemTemplate}"
                                      ItemsSource="{Binding BottomNavigationItems}"
                                      Style="{StaticResource PtjNavigationItemsControlStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              Background="{DynamicResource PtjBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Padding="32,24,32,20"
                    BorderBrush="{DynamicResource PtjBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource PtjPageTitleTextStyle}"
                               Text="{Binding PageTitle}" />
                    <ToggleButton Grid.Column="1"
                                  AutomationProperties.Name="{Binding ThemeToggleToolTip}"
                                  Command="{Binding ToggleThemeCommand}"
                                  IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                                  Style="{StaticResource PtjThemeToggleStyle}"
                                  ToolTip="{Binding ThemeToggleToolTip}" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="32,24">
                <ContentControl HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Content="{Binding CurrentContentViewModel}" />
            </Border>
        </Grid>
    </Grid>
</Window>
